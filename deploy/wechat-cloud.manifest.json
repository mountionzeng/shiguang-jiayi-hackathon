{
  "schemaVersion": 1,
  "accountBoundFiles": [
    "project.config.json",
    "miniprogram/config/wechat-accounts.json",
    "miniprogram/config/wechat-accounts.js"
  ],
  "deploymentClasses": {
    "base": "Deploy for the normal production application.",
    "configured": "Deploy only after the listed secrets, feature flags, routes, or triggers are configured.",
    "bootstrapOnce": "Operator-only bootstrap function; deploy temporarily, run once, verify, then remove.",
    "diagnosticOnly": "Operator diagnostic; do not leave deployed in the production environment.",
    "dangerousMaintenance": "Destructive maintenance function; never deploy by default."
  },
  "cloudFunctions": {
    "storyBooks": {
      "deploymentClass": "base",
      "defaultDeploy": true,
      "timeoutSeconds": 20,
      "environmentVariables": [
        "STORY_BOOKS_MIGRATION_READY", "STORY_BOOKS_MIGRATION_FAMILY_IDS",
        "STORY_ACCESS_ENABLED", "STORY_ACCESS_RULES_READY",
        "STORY_IDENTITY_BOOTSTRAP_APP_ID", "STORY_ACCESS_CANARY_FAMILY_IDS", "STORY_INVITATIONS_ENABLED", "STORY_SHARED_MEDIA_ENABLED", "STORY_EXCERPT_SHARING_ENABLED", "STORY_SHARED_EDIT_ENABLED", "STORY_COPY_RECEIVE_ENABLED", "STORY_SHARE_CARD_ENABLED"
      ],
      "databaseRulesFile": "deploy/story-sharing/database.rules.json",
      "storageRulesFile": "deploy/story-sharing/storage.rules.json"
    },
    "storyAudio": {
      "deploymentClass": "configured",
      "defaultDeploy": false,
      "activationRequirements": ["Configure provider credentials and capability flags", "Confirm product entitlement, IAM access, quota, and billing mode", "Run one controlled request with a stable request ID", "Install the configured timer trigger"],
      "timeoutSeconds": 20,
      "environmentVariables": [
        "STORY_AUDIO_PRICING_VERSION",
        "STORY_AUDIO_TTS_ENABLED",
        "STORY_AUDIO_VOICE_CLONE_ENABLED",
        "STORY_AUDIO_VOICE_ENROLLMENT_ENABLED",
        "STORY_AUDIO_VOICE_WORKER_ENABLED",
        "STORY_AUDIO_TIMESTAMPS_ENABLED",
        "STORY_AUDIO_MIXING_ENABLED",
        "STORY_AUDIO_VIDEO_ENABLED",
        "STORY_AUDIO_SUBMISSION_ENABLED",
        "STORY_AUDIO_OFFICIAL_VOICE_IDS",
        "STORY_AUDIO_OFFICIAL_VOICES",
        "STORY_AUDIO_TENCENT_SECRET_ID",
        "STORY_AUDIO_TENCENT_SECRET_KEY",
        "STORY_AUDIO_TENCENT_SESSION_TOKEN",
        "STORY_AUDIO_TENCENT_REGION",
        "TENCENTCLOUD_SECRET_ID",
        "TENCENTCLOUD_SECRETID",
        "TENCENTCLOUD_SECRET_KEY",
        "TENCENTCLOUD_SECRETKEY",
        "TENCENTCLOUD_SESSION_TOKEN",
        "TENCENTCLOUD_SESSIONTOKEN",
        "TENCENTCLOUD_REGION"
      ],
      "timerTriggers": ["sweepAudioOperations: every 2 minutes"]
    },
    "photoAccess": {
      "deploymentClass": "configured",
      "defaultDeploy": false,
      "activationRequirements": ["Set PHOTO_ACCESS_INTERNAL_TOKEN to the same secret used by storyImages", "Install the configured timer trigger"],
      "timeoutSeconds": 10,
      "environmentVariables": ["PHOTO_ACCESS_INTERNAL_TOKEN"],
      "timerTriggers": ["retryPhotoModeration: every 10 minutes"]
    },
    "storyImages": {
      "deploymentClass": "configured",
      "defaultDeploy": false,
      "activationRequirements": ["Configure image, text, and vision provider credentials", "Set AIGC_CONTENT_PRODUCER to the mini-program operator name or traceable platform code", "Verify a live provider result is PNG or JPEG; WebP remains fail-closed and retryable until a patched decoder is available", "Confirm product entitlement, IAM access, quota, and billing mode", "Run one controlled request with a stable request ID", "Set the shared PHOTO_ACCESS_INTERNAL_TOKEN", "Install the configured timer trigger and message route"],
      "timeoutSeconds": 60,
      "environmentVariables": [
        "AI_API_KEY",
        "AI_BASE_URL",
        "AI_MODEL",
        "AIGC_CONTENT_PRODUCER",
        "PHOTO_ACCESS_INTERNAL_TOKEN",
        "STORY_IMAGES_DIAGNOSE_TOKEN",
        "TOKENHUB_API_KEY",
        "TOKENHUB_BASE_URL",
        "VISION_API_KEY",
        "VISION_BASE_URL",
        "VISION_MODEL"
      ],
      "timerTriggers": ["sweepImageJobs: every minute"],
      "messageRoutes": ["wxa_media_check"]
    },
    "contentSecurityCheck": {
      "deploymentClass": "base",
      "defaultDeploy": true,
      "timeoutSeconds": 10,
      "environmentVariables": []
    },
    "familyInvite": {
      "deploymentClass": "base",
      "defaultDeploy": true,
      "timeoutSeconds": 10,
      "environmentVariables": []
    },
    "drinkingTimeBridge": {
      "deploymentClass": "configured",
      "defaultDeploy": false,
      "activationRequirements": ["Configure the bridge URL and secret", "Set WECHAT_APP_ID to the new Mini Program AppID before enabling desktop authority"],
      "timeoutSeconds": 20,
      "environmentVariables": [
        "DRINKING_TIME_BRIDGE_BASE_URL",
        "DRINKING_TIME_BRIDGE_SECRET",
        "STORY_DESKTOP_AUTHORITY_ENABLED",
        "WECHAT_APP_ID",
        "STORY_IDENTITY_BOOTSTRAP_APP_ID"
      ]
    },
    "storyDesktopAccess": {
      "deploymentClass": "configured",
      "defaultDeploy": false,
      "activationRequirements": ["Configure STORY_DESKTOP_AUTHORITY_SECRET", "Explicitly enable STORY_DESKTOP_ACCESS_ENABLED after authority setup"],
      "timeoutSeconds": 20,
      "environmentVariables": [
        "STORY_DESKTOP_ACCESS_ENABLED",
        "STORY_DESKTOP_AUTHORITY_SECRET",
        "STORY_SHARE_CARD_ENABLED"
      ]
    },
    "getOpenId": {
      "deploymentClass": "base",
      "defaultDeploy": true,
      "timeoutSeconds": 10,
      "environmentVariables": []
    },
    "resetCurrentUserRoom": {
      "deploymentClass": "base",
      "defaultDeploy": true,
      "timeoutSeconds": 20,
      "environmentVariables": [],
      "notes": "Production self-service account reset. It deletes only the caller's room and is not an operator maintenance function."
    },
    "chatInterview": {
      "deploymentClass": "configured",
      "defaultDeploy": false,
      "activationRequirements": ["Configure CHAT_AI_* or fallback AI_* provider settings", "Set WECHAT_APP_ID and keep AI_SERVER_RELEASE_READY false until validation", "Confirm provider entitlement, quota, and billing mode", "Verify input/output moderation and one controlled request before enabling both release gates"],
      "timeoutSeconds": 60,
      "environmentVariables": ["CHAT_AI_API_KEY", "CHAT_AI_BASE_URL", "CHAT_AI_MODEL", "AI_API_KEY", "AI_BASE_URL", "AI_MODEL", "WECHAT_APP_ID", "AI_SERVER_RELEASE_READY", "AI_DAILY_REQUEST_LIMIT", "AI_MIN_INTERVAL_MS", "AI_DIAGNOSE_TOKEN"]
    },
    "generateBiography": {
      "deploymentClass": "configured",
      "defaultDeploy": false,
      "activationRequirements": ["Configure AI_API_KEY, AI_BASE_URL, and AI_MODEL", "Set WECHAT_APP_ID and keep AI_SERVER_RELEASE_READY false until validation", "Confirm provider entitlement, quota, and billing mode", "Verify input/output moderation and one controlled request before enabling both release gates"],
      "timeoutSeconds": 60,
      "environmentVariables": ["AI_API_KEY", "AI_BASE_URL", "AI_MODEL", "WECHAT_APP_ID", "AI_SERVER_RELEASE_READY", "AI_DAILY_REQUEST_LIMIT", "AI_MIN_INTERVAL_MS"]
    },
    "organizeMemory": {
      "deploymentClass": "configured",
      "defaultDeploy": false,
      "activationRequirements": ["Configure ORGANIZE_AI_*, CHAT_AI_*, or fallback AI_* provider settings", "Set WECHAT_APP_ID and keep AI_SERVER_RELEASE_READY false until validation", "Confirm provider entitlement, quota, and billing mode", "Verify input/output moderation and one controlled request before enabling both release gates"],
      "timeoutSeconds": 60,
      "environmentVariables": ["ORGANIZE_AI_API_KEY", "ORGANIZE_AI_BASE_URL", "ORGANIZE_AI_MODEL", "CHAT_AI_API_KEY", "CHAT_AI_BASE_URL", "CHAT_AI_MODEL", "AI_API_KEY", "AI_BASE_URL", "AI_MODEL", "WECHAT_APP_ID", "AI_SERVER_RELEASE_READY", "AI_DAILY_REQUEST_LIMIT", "AI_MIN_INTERVAL_MS"]
    },
    "ensureCloudCollections": {
      "deploymentClass": "bootstrapOnce",
      "defaultDeploy": false,
      "activationRequirements": ["Set a temporary COLLECTION_BOOTSTRAP_TOKEN", "Remove the function and token after collections are verified"],
      "timeoutSeconds": 60,
      "environmentVariables": ["COLLECTION_BOOTSTRAP_TOKEN"]
    },
    "inspectFamilyData": {
      "deploymentClass": "diagnosticOnly",
      "defaultDeploy": false,
      "timeoutSeconds": 20,
      "environmentVariables": [],
      "notes": "Deploy temporarily only while investigating data, then remove."
    },
    "deleteDemoFamilyOnce": {
      "deploymentClass": "dangerousMaintenance",
      "defaultDeploy": false,
      "activationRequirements": ["Set a temporary DELETE_DEMO_FAMILY_TOKEN of at least 24 characters", "Use the separate manual workflow and remove the function and token immediately afterward"],
      "timeoutSeconds": 60,
      "environmentVariables": ["DELETE_DEMO_FAMILY_TOKEN"],
      "notes": "Destructively deletes the demo family. Excluded from normal deployment even though its source directory is retained."
    }
  },
  "collections": {
    "image_jobs": [
      "family_member_created_id: familyId, memberId, createdAtMs, _id",
      "family_story_created_id: familyId, storyId, createdAtMs, _id",
      "status_updated: status, updatedAtMs",
      "family_day_status: familyId, dayKey, status"
    ],
    "photo_caption_logs": [
      "requester_day_status: requesterOpenId, dayKey, status"
    ],
    "photos": [
      "family_openid_id: familyId, _openid, _id",
      "moderation_trace_id: moderation.traceId",
      "moderation_deleted: deletedAt, moderation.ok"
    ],
    "story_images": [
      "family_member_deleted_id: familyId, memberId, deletedAtMs, _id",
      "family_story_deleted_id: familyId, storyId, deletedAtMs, _id",
      "moderation_trace_id: moderationTraceId",
      "quality_deleted_created: quality, deletedAtMs, createdAtMs"
    ],
    "story_image_links": [
      "family_story_image: familyId, storyId, imageId"
    ],
    "story_image_job_links": [
      "family_story_job: familyId, storyId, jobId"
    ],
    "stories": [
      "family_updated_id: familyId, updatedAt, _id",
      "family_deleted_updated: familyId, deletedAt, updatedAt"
    ],
    "story_names": [
      "family_title: familyId, title"
    ],
    "story_operations": [
      "family_story: familyId, storyId"
    ],
    "story_principals": [
      "family_status: familyId, status"
    ],
    "story_identity_aliases": [
      "principal_status: principalId, status"
    ],
    "story_principal_spaces": [
      "principal_status: principalId, status"
    ],
    "story_grants": [
      "principal_status_story: principalId, status, storyId",
      "family_story_status: familyId, storyId, status"
    ],
    "story_invitations": ["family_story_status: familyId, storyId, status"],
    "story_invite_indexes": [],
    "story_invite_rates": [],
    "story_source_policies": [],
    "story_copies": [],
    "story_excerpt_operations": [],
    "story_collaboration_operations": [],
    "story_copy_requests": [],
    "story_copy_edits": [],
    "story_returns": [],
    "story_return_indexes": [],
    "story_desktop_grants": [],
    "story_desktop_nonces": [],
    "story_desktop_operations": [],
    "story_copy_media": [],
    "story_copy_assets": [],
    "audio_operations": [
      "family_created_id: familyId, createdAt, _id",
      "requester_created_id: requesterOpenid, createdAt, _id",
      "status_next_run_id: status, nextRunAt, _id",
      "family_story_revision: familyId, storyId, revisionId"
    ],
    "voice_profiles": [
      "family_owner_status: familyId, ownerOpenid, status",
      "family_updated_id: familyId, updatedAt, _id"
    ],
    "audio_works": [
      "family_created_id: familyId, createdAt, _id",
      "family_story_revision: familyId, storyId, revisionId"
    ],
    "story_migration_items": [
      "family_resolved_id: familyId, resolvedStoryId, _id"
    ],
    "biography_drafts": [
      "family_story_type_id: familyId, storyId, draftType, _id"
    ],
    "families": [],
    "family_snapshots": [
      "family_captured: snapshotOfFamilyId, capturedAt"
    ],
    "family_members": [
      "account_id: accountId",
      "family_id: familyId, _id"
    ],
    "source_records": [
      "family_id: familyId, _id"
    ],
    "memories": [
      "family_id: familyId, _id"
    ],
    "generated_artifacts": [],
    "user_accounts": [],
    "family_invitations": [],
    "family_access": [
      "account_id: accountId"
    ]
  },
  "secretPolicy": "This manifest records names only. Never commit secret values."
}
