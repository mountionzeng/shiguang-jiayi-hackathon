<view class="shell page-enter">

  <!-- 不是老人本人：只解释，不给操作 -->
  <block wx:if="{{!isElder}}">
    <view class="block-card wash">
      <view class="block-title serif">只有 {{protagonistName}} 本人能确认</view>
      <view class="block-note">
        家人记得的事不一定完全准确。谁讲的由谁负责，是不是这样，只由 {{protagonistName}} 说了算——发起人、其他家人和 AI 都不能代替。
      </view>
      <view class="block-me">你现在的身份是 {{viewerName}}。</view>
    </view>
    <button class="btn btn-ghost block-back" bindtap="goBack">回到记忆之家</button>
  </block>

  <block wx:else>
    <view class="review-head">
      <view class="review-title serif">{{protagonistName}}，这些是家人记得的事</view>
      <view class="review-sub" wx:if="{{pendingCount > 0}}">{{positionLabel}}</view>
    </view>

    <!-- 一次只聚焦一条 -->
    <block wx:if="{{focus}}">
      <view class="focus-card">
        <view class="focus-source">
          <view class="focus-avatar serif">{{focus.avatarText}}</view>
          <view class="focus-who">
            <text class="focus-author">{{focus.authorName}} · {{focus.relation}}</text>
            <text class="focus-date">{{focus.dateLabel}} 讲的</text>
          </view>
        </view>

        <view class="focus-text serif">{{focus.text}}</view>

        <view class="focus-scope">
          <text class="tag {{focus.isPrivate ? 'tag-muted' : 'tag-lake'}}">
            <text class="tag-mark">{{focus.isPrivate ? '私' : '家'}}</text>{{focus.visibilityLabel}}
          </text>
        </view>
        <view class="focus-scope-note" wx:if="{{focus.isPrivate}}">
          这一条只有讲述人和你看得到。就算你确认属实，它也不会进入记忆之家，更不会写进任何人的人生之书。
        </view>
      </view>

      <view class="focus-ask">是这样吗？</view>

      <button class="btn btn-jade action-confirm" data-status="confirmed" bindtap="reviewMemory">
        {{focus.confirmLabel}}
      </button>
      <button class="btn btn-ghost action-conflict" data-status="conflict" bindtap="reviewMemory">
        大致是，但有出入
      </button>
      <button class="btn btn-ghost action-reject" data-status="rejected" bindtap="reviewMemory">
        不是这样
      </button>

      <view class="focus-hint">
        选「大致是」和「不是这样」都不会删掉家人的话，只是不写进书里。
      </view>
    </block>

    <!-- 全部处理完成 -->
    <view class="done-card wash" wx:else>
      <view class="done-mark serif">✓</view>
      <view class="done-title serif">这一轮都核对完了</view>
      <view class="done-note">家人再讲新的，还会来请你确认。</view>
    </view>

    <view class="review-progress">
      <view class="progress-item">
        <text class="progress-num serif">{{pendingCount}}</text>
        <text class="progress-label">还没核对</text>
      </view>
      <view class="progress-line"></view>
      <view class="progress-item">
        <text class="progress-num serif">{{handledCount}}</text>
        <text class="progress-label">已经处理</text>
      </view>
      <view class="progress-line"></view>
      <view class="progress-item">
        <text class="progress-num serif">{{confirmedCount}}</text>
        <text class="progress-label">已在家中公开</text>
      </view>
    </view>

    <button class="btn btn-primary book-btn" bindtap="goToMemoryHome">回记忆之家看看</button>
    <button class="btn btn-quiet" bindtap="goBack">先回去</button>
  </block>
</view>
