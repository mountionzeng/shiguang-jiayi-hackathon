/* 老人确认：一次只核对一条 */

/* ---- 非老人身份的解释 ---- */

.block-card {
  margin-top: 40rpx;
  padding: 48rpx 36rpx;
  border-radius: 30rpx;
  border: 2rpx solid var(--line);
}

.block-title {
  position: relative;
  z-index: 1;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--ink);
}

.block-note {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--ink-soft);
}

.block-me {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--ink-faint);
}

.block-back {
  margin-top: 40rpx;
}

/* ---- 抬头 ---- */

.review-head {
  padding: 8rpx 0 28rpx;
}

.review-title {
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--ink);
}

.review-sub {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--ink-soft);
}

/* ---- 聚焦卡片 ---- */

.focus-card {
  padding: 32rpx;
  border-radius: 30rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--line);
}

.focus-source {
  display: flex;
  align-items: center;
}

.focus-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: var(--lake);
  color: #fbfdfc;
  font-size: 28rpx;
}

.focus-who {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.focus-author {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.focus-date {
  margin-top: 4rpx;
  font-size: 25rpx;
  color: var(--ink-faint);
}

/* 事实原文：本页最大、对比度最高的元素，背后不放任何肌理 */
.focus-text {
  margin-top: 28rpx;
  font-size: 44rpx;
  line-height: 1.85;
  color: var(--ink);
}

.focus-scope {
  margin-top: 28rpx;
}

.focus-scope-note {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink-soft);
}

.focus-ask {
  margin: 40rpx 0 24rpx;
  text-align: center;
  font-size: 34rpx;
  color: var(--ink-soft);
}

.action-confirm {
  min-height: 116rpx;
  font-size: 38rpx;
}

.action-conflict,
.action-reject {
  min-height: 104rpx;
  margin-top: 20rpx;
  font-size: 34rpx;
}

.focus-hint {
  margin-top: 28rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink-faint);
}

/* ---- 完成 ---- */

.done-card {
  margin-top: 20rpx;
  padding: 56rpx 36rpx;
  border-radius: 30rpx;
  border: 2rpx solid var(--line);
  text-align: center;
}

.done-mark {
  position: relative;
  z-index: 1;
  font-size: 72rpx;
  line-height: 1;
  color: var(--jade);
}

.done-title {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--ink);
}

.done-note {
  position: relative;
  z-index: 1;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--ink-soft);
}

/* ---- 进度 ---- */

.review-progress {
  display: flex;
  align-items: stretch;
  margin-top: 44rpx;
  padding: 24rpx 0;
  border-radius: 26rpx;
  background: var(--paper-sunk);
}

.progress-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.progress-num {
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--ink);
}

.progress-label {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
}

.progress-line {
  width: 2rpx;
  margin: 8rpx 0;
  background: var(--line);
}

.book-btn {
  margin-top: 36rpx;
}
