<view class="home page-enter">
  <view class="home-head">
    <view class="topline">
      <view class="wordmark">
        <view class="brand-mark wordmark-icon"></view>
        <text class="wordmark-text serif">拾光Ai</text>
      </view>
    </view>

    <view class="home-cover wash">
      <text class="home-cover-label">只写我亲自经历的故事</text>
      <view class="home-cover-title serif">{{bookTitle}}</view>
      <view class="home-cover-sub">{{coverSubtitle}}</view>
      <view class="home-cover-stats">
        <view class="home-cover-stat">
          <text class="home-cover-num serif">{{fragmentCount}}</text>
          <text class="home-cover-stat-label">未整理片段</text>
        </view>
        <view class="home-cover-line"></view>
        <view class="home-cover-stat">
          <text class="home-cover-num serif">{{storyCount}}</text>
          <text class="home-cover-stat-label">个故事</text>
        </view>
        <view class="home-cover-line"></view>
        <view class="home-cover-stat">
          <text class="home-cover-num serif">{{chapterCount}}</text>
          <text class="home-cover-stat-label">书稿章节</text>
        </view>
      </view>
    </view>

    <view class="branch-buttons">
      <button class="branch-button" bindtap="openBook">
        <view class="branch-motif motif-book">
          <view class="book-page book-page-left"></view>
          <view class="book-page book-page-right"></view>
          <view class="book-spine"></view>
          <view class="book-sun"></view>
        </view>
        <view class="branch-copy">
          <text class="branch-name serif">人生之书</text>
          <text class="branch-note">我的故事</text>
        </view>
      </button>

      <button class="branch-button" bindtap="openMemoryHome">
        <view class="branch-motif motif-home">
          <view class="home-roof"></view>
          <view class="home-body"></view>
          <view class="home-person home-person-one"></view>
          <view class="home-person home-person-two"></view>
        </view>
        <view class="branch-copy">
          <text class="branch-name serif">记忆之家</text>
          <text class="branch-note">我和亲友</text>
        </view>
      </button>
    </view>

    <button class="start-chat" bindtap="startInterview">
      <text class="start-chat-plus">＋</text>
      <text>开始聊聊</text>
    </button>
  </view>

  <view class="recent" wx:if="{{hasRecentStories}}">
    <view class="recent-head">
      <text class="recent-title">最近聊过</text>
      <text class="recent-note">点开就能接着说</text>
    </view>

    <view
      class="story-row"
      wx:for="{{recentStories}}"
      wx:key="id"
      data-id="{{item.id}}"
      data-title="{{item.storyTitle}}"
      bindtap="continueStory"
    >
      <view class="story-copy">
        <view class="story-title serif">{{item.title}}</view>
        <view class="story-excerpt serif">{{item.excerpt}}</view>
        <view class="story-meta">{{item.dateLabel}} · {{item.countLabel}}</view>
      </view>
      <view class="story-continue">继续聊</view>
    </view>
  </view>

  <view class="home-empty" wx:else>
    <view class="home-empty-title serif">还没有故事</view>
    <view class="home-empty-note">不用想好从哪里开始，先说一句就好。</view>
  </view>
</view>
