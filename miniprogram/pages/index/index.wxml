<scroll-view class="home-scroll" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="home page-enter">
    <image
      class="home-paper"
      src="/assets/illustrations/home-paper.jpg"
      mode="scaleToFill"
      aria-hidden="true"
    ></image>

    <view class="topline">
      <button
        class="my-entry"
        bindtap="openMyHome"
        hover-class="none"
        aria-label="打开我的"
      >
        <view class="member-avatar serif">
          <image class="member-avatar-backdrop" src="/assets/illustrations/avatar-watercolor.png" mode="aspectFill" aria-hidden="true"></image>
          <text class="member-avatar-letter">{{ownerAvatarText || '我'}}</text>
        </view>
      </button>
    </view>

    <view class="story-switch-wrap" wx:if="{{hasProfile}}">
      <button
        class="story-switch"
        bindtap="toggleStoryChooser"
        hover-class="story-switch-pressed"
        aria-label="换一个故事聊，现在是{{currentStoryLabel}}"
      >
        <view class="story-switch-copy">
          <text class="story-switch-note">换一个故事聊</text>
          <text class="story-switch-name serif">{{currentStoryLabel}}</text>
        </view>
        <text class="story-switch-arrow">{{storyChooserOpen ? '⌃' : '⌄'}}</text>
      </button>
    </view>

    <view class="book-stage {{bookSlides.length > 1 ? 'book-stage-scrollable' : ''}}">
      <swiper
        class="book-swiper"
        circular="{{bookSlides.length > 1}}"
        current="{{activeBookIndex}}"
        duration="360"
        easing-function="easeOutCubic"
        bindchange="onBookSlideChange"
        skip-hidden-item-layout="{{true}}"
      >
        <swiper-item class="book-slide" wx:for="{{bookSlides}}" wx:key="key">
          <view class="book-slide-inner">
            <view
              class="book {{bookOpening && activeBookIndex === index ? 'book-opening' : ''}}"
              bindtap="openMemoryArchive"
              role="button"
              aria-label="打开故事 {{item.title}}"
            >
              <view class="book-pages-under"></view>
              <view class="book-cover-leaf">
                <view class="book-cover-picture" wx:if="{{item.bookArtUrl}}" aria-hidden="true">
                  <image
                    class="book-cover-picture-art"
                    src="{{item.bookArtUrl}}"
                    mode="scaleToFill"
                  ></image>
                </view>
                <image
                  wx:else
                  class="ancient-book-art"
                  src="/assets/illustrations/story-book-cover.png"
                  mode="aspectFill"
                  aria-hidden="true"
                ></image>
                <view class="book-cover-copy {{item.bookArtUrl ? 'book-cover-copy-printed' : ''}}">
                  <text class="book-kicker typewriter">拾 光 录</text>
                  <view class="book-copy">
                    <view class="book-slip">
                      <view class="book-title typewriter">{{item.title}}</view>
                      <view class="book-subtitle">{{item.subtitle}}</view>
                    </view>
                    <view class="book-stats" role="group" aria-label="这本书的记忆、章节和人物">
                      <button
                        class="book-stat-action book-stat-note"
                        catchtap="openStoryMemories"
                        hover-class="none"
                        aria-label="这本书里的记忆"
                      >
                        <text class="book-stat-num">{{item.memoryCount}}</text>
                        <text class="book-stat-label">段记忆</text>
                      </button>
                      <button
                        class="book-stat-action book-stat-memoir"
                        catchtap="openStoryChapters"
                        hover-class="none"
                        aria-label="这本书整理好的章节"
                      >
                        <text class="book-stat-num">{{item.chapterCount}}</text>
                        <text class="book-stat-label">章节</text>
                      </button>
                      <button
                        class="book-stat-action book-stat-home"
                        catchtap="openPeople"
                        hover-class="none"
                        aria-label="这本书里的人物，在记忆之家查看"
                      >
                        <text class="book-stat-num">{{item.peopleCount}}</text>
                        <text class="book-stat-label">人物</text>
                      </button>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </swiper-item>
      </swiper>
      <view class="book-rail" wx:if="{{bookSlides.length > 1}}" aria-hidden="true">
        <text class="book-rail-word">左滑</text>
        <view class="book-rail-dots">
          <text class="book-rail-dot {{index === activeBookIndex ? 'book-rail-dot-on' : ''}}" wx:for="{{bookSlides}}" wx:key="key"></text>
        </view>
        <text class="book-rail-word">右滑</text>
      </view>
      <view class="book-open-label typewriter">{{bookSlides.length > 1 ? '左右滑动换一本书 · 轻触打开' : '轻触打开这个故事'}}</view>
    </view>

    <view class="home-setup" wx:if="{{!hasProfile}}">
      <view class="home-setup-title serif">先写下你的名字</view>
      <view class="home-setup-note">从你自己开始，把经历慢慢留下来。</view>
      <button
        class="home-setup-button"
        bindtap="createFirstProfile"
        hover-class="none"
      >
        写下我的名字
      </button>
    </view>

    <view class="recommended" wx:if="{{hasProfile}}">
      <view class="recommended-head">
        <text class="recommended-title serif">每日一问</text>
        <button
          class="recommended-refresh"
          bindtap="changeRecommendedQuestion"
          hover-class="none"
          aria-label="换一个推荐问题"
        >换一个问题</button>
      </view>
      <view
        wx:if="{{hasRecommendedQuestion}}"
        class="recommended-card"
        bindtap="continueRecommendedQuestion"
        role="button"
        aria-label="回答每日一问"
      >
        <view class="recommended-label">{{currentStoryTitle ? '《' + currentStoryTitle + '》' : currentStoryLabel}}</view>
        <view class="recommended-context">{{recommendedQuestionContext}}</view>
        <view class="recommended-question">{{recommendedQuestion}}</view>
        <view class="recommended-action">回答这一问</view>
      </view>
      <view
        wx:else
        class="recommended-card"
        bindtap="startCurrentStory"
        role="button"
        aria-label="回答每日一问：{{currentStoryLabel}}"
      >
        <view class="recommended-label">{{currentStoryTitle ? '《' + currentStoryTitle + '》' : currentStoryLabel}}</view>
        <view class="recommended-question">{{dailyQuestion}}</view>
        <view class="recommended-action">回答这一问</view>
      </view>
    </view>

    <view class="recent" wx:if="{{hasRecentStories}}">
      <view class="recent-head">
        <text class="recent-title serif">最近聊过</text>
        <text class="recent-note">点开就能接着说</text>
      </view>

      <view class="recent-timeline">
        <view
          class="timeline-row"
          wx:for="{{recentStories}}"
          wx:key="id"
          data-id="{{item.id}}"
          data-title="{{item.storyTitle}}"
          bindtap="continueStory"
        >
          <view class="date-bookmark" aria-hidden="true">
            <image class="date-bookmark-art" src="/assets/illustrations/memory-bookmark.png" mode="widthFix"></image>
            <view class="date-bookmark-date serif"><text class="date-bookmark-part" wx:for="{{item.dateParts}}" wx:for-item="part" wx:key="*this">{{part}}</text></view>
          </view>
          <view class="story-row">
            <view class="story-copy">
              <view class="story-title serif">{{item.title}}</view>
              <view class="story-excerpt">{{item.excerpt}}</view>
              <view class="story-meta">{{item.countLabel}}</view>
            </view>
            <view class="story-continue">继续聊</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</scroll-view>

<scroll-view
  class="story-menu story-menu-floating"
  wx:if="{{storyChooserOpen}}"
  scroll-y
  enhanced
  show-scrollbar="{{false}}"
>
  <button
    class="story-menu-item {{item.selected ? 'story-menu-item-on' : ''}}"
    wx:for="{{storyOptions}}"
    wx:key="key"
    data-title="{{item.title}}"
    data-key="{{item.key}}"
    bindtap="chooseStory"
    hover-class="none"
    aria-label="换到{{item.title}}"
  >
    <view class="story-menu-avatar serif">{{item.avatarText}}</view>
    <view class="story-menu-copy">
      <text class="story-menu-name">{{item.title}}</text>
      <text class="story-menu-relation">{{item.label}}</text>
    </view>
    <text class="story-menu-check">{{item.selected ? '✓' : ''}}</text>
  </button>
  <button
    class="story-menu-item {{currentStoryTitle ? '' : 'story-menu-item-on'}}"
    bindtap="chooseNoStory"
    hover-class="none"
    aria-label="先随便聊聊，不选故事"
  >
    <view class="story-menu-avatar serif">聊</view>
    <view class="story-menu-copy">
      <text class="story-menu-name">先随便聊聊</text>
      <text class="story-menu-relation">不选故事，聊完再放</text>
    </view>
    <text class="story-menu-check">{{currentStoryTitle ? '' : '✓'}}</text>
  </button>
  <button
    class="story-menu-item story-menu-add"
    bindtap="startNewStory"
    hover-class="none"
    aria-label="开一个新故事"
  >
    <view class="story-menu-avatar story-menu-add-icon">+</view>
    <view class="story-menu-copy">
      <text class="story-menu-name">开一个新故事</text>
      <text class="story-menu-relation">起个名字就能开始聊</text>
    </view>
  </button>
</scroll-view>

<story-switcher current="home"></story-switcher>
<canvas type="2d" id="book-frame-canvas" class="book-frame-canvas" aria-hidden="true"></canvas>
