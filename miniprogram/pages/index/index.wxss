/* 首页：当代书籍装帧；三入口固定在底部切换栏。 */

.home-scroll {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: #fbf8f1;
}

.home {
  position: relative;
  min-height: calc(100vh + 2rpx);
  padding: 22rpx 40rpx calc(276rpx + env(safe-area-inset-bottom));
  background: #fbf8f1;
}

.home-paper {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.72;
  pointer-events: none;
}

.home > view,
.home > button {
  position: relative;
  z-index: 1;
}

.home > .topline {
  position: absolute;
  top: 8rpx;
  left: 32rpx;
  z-index: 960;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 84rpx;
  min-height: 72rpx;
}

.my-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  overflow: visible;
}

.my-entry::after { border: 0; }

.my-entry:active {
  transform: translateY(2rpx) scale(0.96);
}

.profile-switch-wrap {
  position: absolute;
  top: 4rpx;
  left: 50%;
  z-index: 980;
  width: 360rpx;
  margin: 0;
  transform: translateX(-50%);
}

.profile-switch {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 360rpx;
  height: 84rpx;
  margin: 0;
  padding: 10rpx 24rpx 10rpx 28rpx;
  border: 2rpx solid rgba(79, 127, 107, 0.18);
  border-radius: 46rpx;
  background: rgba(255, 253, 247, 0.72);
  color: var(--ink);
  text-align: left;
  box-shadow: 0 14rpx 32rpx rgba(79, 127, 107, 0.08);
}

.profile-switch::after { border: 0; }

.profile-switch-pressed {
  background: rgba(229, 239, 233, 0.72);
  transform: translateY(2rpx) scale(0.985);
}

.member-avatar {
  position: relative;
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border: 2rpx solid rgba(79, 127, 107, 0.24);
  border-radius: 50%;
  background: rgba(229, 239, 233, 0.9);
  color: var(--jade);
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(79, 127, 107, 0.08);
  overflow: hidden;
}

.member-avatar-backdrop {
  position: absolute;
  top: -34rpx;
  left: -20rpx;
  width: 120rpx;
  height: 156rpx;
  opacity: 0.78;
  pointer-events: none;
}

.member-avatar-letter {
  position: relative;
  z-index: 1;
}

.profile-switch-copy {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.profile-switch-name {
  overflow: hidden;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-switch-note {
  order: -1;
  margin-bottom: 3rpx;
  color: var(--ink-faint);
  font-size: 22rpx;
  line-height: 1.25;
}

.profile-switch-arrow {
  flex-shrink: 0;
  margin-left: 18rpx;
  color: rgba(79, 127, 107, 0.72);
  font-size: 32rpx;
  line-height: 1;
}

.profile-menu {
  position: absolute;
  top: 96rpx;
  right: 0;
  left: 0;
  z-index: 999;
  max-height: 372rpx;
  padding: 10rpx;
  border: 2rpx solid rgba(129, 117, 93, 0.14);
  border-radius: 26rpx;
  background: rgba(255, 254, 251, 0.96);
  box-shadow: 0 18rpx 38rpx rgba(75, 73, 63, 0.12);
  overflow: hidden;
}

.profile-menu-floating {
  position: fixed;
  top: 100rpx;
  right: auto;
  left: 50%;
  z-index: 10000;
  width: 360rpx;
  transform: translateX(-50%);
}

.profile-menu-item {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 82rpx;
  margin: 0;
  padding: 10rpx 12rpx;
  border-radius: 20rpx;
  background: transparent;
  color: var(--ink);
  text-align: left;
}

.profile-menu-item::after { border: 0; }

.profile-menu-item + .profile-menu-item {
  margin-top: 4rpx;
}

.profile-menu-item-on {
  background: rgba(229, 239, 233, 0.76);
}

.profile-menu-add {
  margin-top: 8rpx;
  border-top: 2rpx solid rgba(129, 117, 93, 0.12);
}

.profile-menu-avatar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: rgba(79, 127, 107, 0.12);
  color: var(--jade);
  font-size: 22rpx;
  font-weight: 600;
}

.profile-menu-add-icon {
  background: rgba(181, 145, 82, 0.14);
  color: #9b7334;
  font-size: 34rpx;
  font-weight: 500;
}

.profile-menu-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  margin-left: 16rpx;
}

.profile-menu-name {
  overflow: hidden;
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-menu-relation {
  margin-top: 4rpx;
  color: var(--ink-faint);
  font-size: 21rpx;
  line-height: 1.25;
}

.profile-menu-check {
  flex-shrink: 0;
  width: 28rpx;
  color: var(--jade);
  font-size: 24rpx;
  text-align: center;
}

/* ---- 可触碰的书封 ---- */

.book-stage {
  position: relative;
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  z-index: 0;
  margin-top: 68rpx;
  perspective: 1200rpx;
}

.book {
  position: relative;
  z-index: 0;
  width: 540rpx;
  height: 810rpx;
  transform-style: preserve-3d;
  cursor: pointer;
}

.book:not(.book-opening):active {
  transform: translateY(3rpx) scale(0.985);
}

.book-pages-under {
  position: absolute;
  top: 36rpx;
  right: 22rpx;
  bottom: 34rpx;
  left: 58rpx;
  border: 2rpx solid rgba(129, 117, 93, 0.16);
  border-radius: 8rpx 22rpx 20rpx 8rpx;
  background: linear-gradient(100deg, #eee6d5 0%, #fffdf5 14%, #f8f2e5 100%);
  box-shadow: 14rpx 16rpx 28rpx rgba(62, 61, 52, 0.11);
  transform: rotate(1.4deg);
}

.book-cover-leaf {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  transform-origin: 17% 50%;
  transform-style: preserve-3d;
}

.book-opening .book-cover-leaf {
  animation: book-cover-open 640ms cubic-bezier(0.24, 0.74, 0.3, 1) both;
}

.book-opening .book-pages-under {
  animation: book-pages-wake 640ms ease-out both;
}

.ancient-book-art {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.book-cover-copy {
  position: absolute;
  top: 0;
  right: 52rpx;
  bottom: 128rpx;
  left: 108rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 66rpx 8rpx 0;
  /* 封面文字与 .book-cover-leaf 同层翻转，透视始终贴合书页。 */
  font-family: "ShiguangBookType", "Songti SC", STSong, serif;
  pointer-events: none;
}

.book-cover-copy .typewriter {
  font-family: "ShiguangBookType", "Songti SC", STSong, serif;
}

.book-kicker {
  align-self: flex-end;
  color: rgba(79, 127, 107, 0.68);
  font-size: 19rpx;
  letter-spacing: 8rpx;
}

.book-copy {
  position: relative;
  z-index: 1;
  padding: 0 2rpx 2rpx;
}

.book-title {
  color: var(--ink);
  font-size: 48rpx;
  font-weight: 400;
  line-height: 1.34;
  letter-spacing: 1rpx;
}

.book-subtitle {
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--ink-faint);
  font-size: 24rpx;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.book-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 18rpx;
  padding-top: 14rpx;
}

.book-stat-action {
  position: relative;
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  width: 108rpx;
  min-height: 82rpx;
  margin: 0;
  padding: 9rpx 5rpx 8rpx;
  border: 1rpx solid rgba(93, 97, 78, 0.23);
  border-radius: 10rpx 17rpx 12rpx 8rpx;
  background: rgba(255, 253, 246, 0.76);
  box-shadow: 2rpx 4rpx 8rpx rgba(80, 74, 55, 0.08);
  color: var(--ink);
  line-height: 1;
  overflow: visible;
}

.book-stat-action::after { border: 0; }

.book-stat-note { transform: rotate(-2.2deg); }
.book-stat-memoir { transform: translateY(-5rpx) rotate(1.4deg); }
.book-stat-home { transform: rotate(2.2deg); }

.book-stat-action:active {
  transform: translateY(3rpx) scale(0.95);
  box-shadow: none;
}

.book-stat-num {
  color: var(--jade);
  font-family: "ShiguangBookType", "Songti SC", STSong, serif;
  font-size: 32rpx;
  font-weight: 600;
}

.book-stat-label {
  margin-top: 7rpx;
  color: var(--ink-soft);
  font-size: 19rpx;
  letter-spacing: 0;
  line-height: 1.15;
  text-align: center;
  white-space: normal;
}

.book-stat-memoir .book-stat-num { color: #80633a; }
.book-stat-home .book-stat-num { color: #4a6e88; }

.book-open-label {
  margin-top: -12rpx;
  color: rgba(79, 127, 107, 0.72);
  font-size: 21rpx;
  letter-spacing: 3rpx;
}

/* ---- 新用户建档 ---- */

.home-setup {
  margin-top: 24rpx;
  padding: 30rpx 32rpx 32rpx;
  border: 2rpx solid rgba(129, 117, 93, 0.14);
  border-radius: 24rpx;
  background: rgba(255, 254, 251, 0.78);
  box-shadow: 0 18rpx 42rpx rgba(75, 73, 63, 0.08);
}

.home-setup-title {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 600;
}

.home-setup-note {
  margin-top: 10rpx;
  color: var(--ink-faint);
  font-size: 25rpx;
  line-height: 1.55;
}

.home-setup-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 80rpx;
  margin-top: 24rpx;
  border-radius: 40rpx;
  background: var(--jade);
  color: #fffefb;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 80rpx;
}

.home-setup-button::after { border: 0; }

.home-setup-button:active {
  transform: scale(0.985);
}

/* ---- 推荐追问 ---- */

.recommended {
  margin-top: 24rpx;
}

.recommended-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.recommended-title {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 600;
}

.recommended-refresh {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 154rpx;
  min-height: 56rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 2rpx solid rgba(181, 145, 82, 0.46);
  border-radius: 28rpx;
  background: rgba(255, 253, 247, 0.72);
  color: #9b7334;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1;
}

.recommended-refresh::after { border: 0; }

.recommended-card {
  position: relative;
  padding: 28rpx 30rpx 30rpx 34rpx;
  border: 2rpx solid rgba(129, 117, 93, 0.14);
  border-radius: 22rpx;
  background: rgba(255, 254, 251, 0.78);
  box-shadow: 0 18rpx 42rpx rgba(75, 73, 63, 0.09);
  overflow: hidden;
}

.recommended-card::before {
  position: absolute;
  top: 28rpx;
  bottom: 28rpx;
  left: 0;
  width: 7rpx;
  border-radius: 0 7rpx 7rpx 0;
  background: rgba(181, 145, 82, 0.78);
  content: "";
}

.recommended-card:active {
  transform: translateY(2rpx) scale(0.99);
}

.recommended-label {
  color: #9b7334;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.25;
}

.recommended-context {
  margin-top: 10rpx;
  overflow: hidden;
  color: var(--ink-soft);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommended-question {
  margin-top: 8rpx;
  color: var(--ink);
  font-size: 31rpx;
  line-height: 1.55;
}

.recommended-action {
  margin-top: 18rpx;
  color: var(--jade);
  font-size: 24rpx;
  font-weight: 600;
  text-align: right;
}

@keyframes book-cover-open {
  0% { transform: translateX(0) rotateY(0deg) scale(1); filter: brightness(1); }
  45% { transform: translateX(-18rpx) rotateY(-38deg) scale(1.025); filter: brightness(1.03); }
  100% { transform: translateX(-44rpx) rotateY(-76deg) scale(1.04); filter: brightness(0.96); }
}

@keyframes book-pages-wake {
  0% { opacity: 0.45; transform: rotate(1.4deg) scale(0.97); }
  55% { opacity: 1; transform: rotate(0.6deg) scale(1.01); }
  100% { opacity: 1; transform: rotate(0deg) scale(1); }
}

/* ---- 树枝与双入口 ---- */

.branch-scene {
  position: relative;
  height: 420rpx;
  margin: 4rpx -12rpx 0;
}

.memory-branch {
  position: absolute;
  top: 34rpx;
  left: -26rpx;
  z-index: 0;
  width: 724rpx;
  height: 242rpx;
  opacity: 0.82;
  transform-origin: center center;
  animation: branch-reveal 900ms ease-out both;
}

.branch-choice {
  position: absolute;
  top: 0;
  bottom: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: flex-start;
  width: 50%;
  padding-bottom: 8rpx;
  background: transparent;
  transition: opacity 180ms ease;
}

.branch-choice-personal {
  left: 0;
}

.branch-choice-family {
  right: 0;
}

.branch-choice:active {
  opacity: 0.82;
  transform: translateY(-3rpx) scale(0.985);
}

.branch-copy {
  position: absolute;
  top: 250rpx;
  right: 0;
  left: 0;
  transition: opacity 180ms ease, transform 240ms ease;
}

.branch-choice-personal .branch-copy {
  top: 232rpx;
}

.branch-choice:active .branch-copy {
  transform: translateY(-5rpx);
}

.branch-label {
  color: var(--ink);
  font-size: 35rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.branch-note {
  margin-top: 6rpx;
  color: var(--ink-faint);
  font-size: 25rpx;
  letter-spacing: 1rpx;
}

.bird-art {
  position: absolute;
  display: block;
  transform-origin: 50% 70%;
  will-change: opacity, transform;
}

.bird-art-personal {
  top: 70rpx;
  left: 72rpx;
  width: 178rpx;
  height: 119rpx;
  animation:
    bird-arrive 820ms cubic-bezier(0.2, 0.72, 0.3, 1) 360ms both,
    bird-idle 5.2s ease-in-out 1.6s infinite;
}

.family-flock {
  position: absolute;
  top: 60rpx;
  left: 8rpx;
  width: 316rpx;
  height: 184rpx;
}

.family-nest {
  position: absolute;
  top: 56rpx;
  left: 48rpx;
  z-index: 0;
  display: block;
  width: 224rpx;
  height: 149rpx;
  opacity: 0.78;
  transform-origin: 50% 65%;
  animation: nest-breathe 5.6s ease-in-out 2s infinite;
}

.family-bird {
  position: absolute;
  z-index: 1;
  transform-origin: 50% 72%;
  will-change: opacity, transform;
}

.family-bird-art {
  position: absolute;
  top: 0;
  left: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.bird-family-one {
  top: 38rpx;
  left: 0;
  width: 132rpx;
  height: 88rpx;
  animation:
    bird-arrive 700ms cubic-bezier(0.2, 0.72, 0.3, 1) 680ms both,
    family-watch 4.2s ease-in-out 1.7s infinite;
}

.bird-family-two {
  top: 92rpx;
  left: 116rpx;
  width: 76rpx;
  height: 51rpx;
  animation:
    bird-arrive 700ms cubic-bezier(0.2, 0.72, 0.3, 1) 820ms both,
    family-chirp 4.2s ease-in-out 1.9s infinite;
}

.bird-family-three {
  top: 58rpx;
  left: 184rpx;
  width: 116rpx;
  height: 77rpx;
  animation:
    bird-arrive 700ms cubic-bezier(0.2, 0.72, 0.3, 1) 960ms both,
    family-answer 4.2s ease-in-out 1.9s infinite;
}

.bird-family-three .family-bird-art {
  transform: scaleX(-1);
}

.entry-personal .bird-art-personal {
  animation: personal-flight 620ms cubic-bezier(0.42, 0, 0.18, 1) both;
}

.entry-personal .branch-choice-family,
.entry-family .branch-choice-personal {
  opacity: 0.34;
}

.entry-personal .ancient-book-art {
  animation: book-receive 620ms ease-out both;
}

.entry-family .memory-branch {
  animation: branch-answer 620ms ease-in-out both;
}

.entry-family .family-nest {
  animation: nest-answer 620ms ease-out both;
}

.entry-personal .branch-choice-personal .branch-copy,
.entry-family .branch-choice-family .branch-copy {
  animation: label-answer 620ms ease-out both;
}

.entry-family .bird-family-one {
  animation: family-flight-one 620ms cubic-bezier(0.42, 0, 0.18, 1) both;
}

.entry-family .bird-family-two {
  animation: family-flight-two 620ms cubic-bezier(0.42, 0, 0.18, 1) both;
}

.entry-family .bird-family-three {
  animation: family-flight-three 620ms cubic-bezier(0.42, 0, 0.18, 1) both;
}

@keyframes branch-reveal {
  from { opacity: 0; transform: translateY(12rpx) scaleX(0.94); }
  to { opacity: 0.82; transform: translateY(0) scaleX(1); }
}

@keyframes bird-arrive {
  0% { opacity: 0; transform: translate(18rpx, -34rpx) rotate(-7deg) scale(0.88); }
  68% { opacity: 1; transform: translate(0, 5rpx) rotate(2deg) scale(1.02); }
  100% { opacity: 1; transform: translate(0, 0) rotate(0) scale(1); }
}

@keyframes bird-idle {
  0%, 100% { transform: translateY(0) rotate(0); }
  50% { transform: translateY(-5rpx) rotate(-1deg); }
}

@keyframes family-watch {
  0%, 30%, 100% { transform: translate(0, 0) rotate(0); }
  43%, 57% { transform: translate(3rpx, 2rpx) rotate(2deg); }
}

@keyframes family-chirp {
  0%, 30%, 68%, 100% { transform: translate(0, 0) rotate(0); }
  40% { transform: translate(8rpx, -8rpx) rotate(-4deg); }
  48% { transform: translate(12rpx, -2rpx) rotate(2deg); }
  57% { transform: translate(8rpx, 0) rotate(0); }
}

@keyframes family-answer {
  0%, 32%, 68%, 100% { transform: translate(0, 0) rotate(0); }
  43%, 57% { transform: translate(-7rpx, 1rpx) rotate(-3deg); }
}

@keyframes nest-breathe {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(2rpx) scale(1.018); }
}

@keyframes nest-answer {
  0%, 100% { opacity: 0.78; transform: translateY(0) scale(1); }
  42% { opacity: 0.96; transform: translateY(5rpx) scale(1.055); }
}

@keyframes label-answer {
  0%, 100% { opacity: 1; transform: translateY(0); }
  42% { opacity: 0.68; transform: translateY(-7rpx); }
}

@keyframes personal-flight {
  0% { opacity: 1; transform: translate(0, 0) rotate(0) scale(1); }
  28% { opacity: 1; transform: translate(-8rpx, -12rpx) rotate(-8deg) scale(1.05); }
  100% { opacity: 0; transform: translate(152rpx, -312rpx) rotate(-18deg) scale(0.42); }
}

@keyframes book-receive {
  0%, 100% { opacity: 1; transform: scale(1); }
  56% { opacity: 0.72; transform: scale(1.08); }
}

@keyframes branch-answer {
  0%, 100% { opacity: 0.82; transform: rotate(0) scaleX(1); }
  46% { opacity: 1; transform: rotate(-1deg) scaleX(1.012); }
}

@keyframes family-flight-one {
  0% { opacity: 1; transform: translate(0, 0) rotate(0) scale(1); }
  36% { opacity: 1; transform: translate(74rpx, -28rpx) rotate(-8deg) scale(1.02); }
  100% { opacity: 0; transform: translate(206rpx, -170rpx) rotate(-16deg) scale(0.52); }
}

@keyframes family-flight-two {
  0% { opacity: 1; transform: translate(0, 0) rotate(0) scale(1); }
  36% { opacity: 1; transform: translate(-4rpx, -46rpx) rotate(-5deg) scale(1.03); }
  100% { opacity: 0; transform: translate(108rpx, -190rpx) rotate(-14deg) scale(0.5); }
}

@keyframes family-flight-three {
  0% { opacity: 1; transform: translate(0, 0) rotate(0) scale(1); }
  36% { opacity: 1; transform: translate(-72rpx, -24rpx) rotate(-7deg) scale(1.02); }
  100% { opacity: 0; transform: translate(18rpx, -172rpx) rotate(-17deg) scale(0.48); }
}

/* ---- 继续说与最近故事 ---- */

.start-chat {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 312rpx;
  min-height: 88rpx;
  margin: 24rpx auto 0;
  border: 2rpx solid rgba(79, 127, 107, 0.5);
  border-radius: 12rpx;
  background: rgba(255, 254, 251, 0.66);
  color: var(--jade);
  font-size: 29rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 10rpx 28rpx rgba(71, 92, 80, 0.08);
  overflow: hidden;
  transition:
    background-color 180ms ease,
    box-shadow 180ms ease,
    color 180ms ease,
    transform 180ms ease;
}

.start-chat::before {
  position: absolute;
  top: 10rpx;
  bottom: 10rpx;
  left: 12rpx;
  width: 4rpx;
  border-radius: 4rpx;
  background: rgba(79, 127, 107, 0.22);
  content: "";
}

.start-chat-pressed {
  background: var(--jade-soft);
  box-shadow: 0 5rpx 16rpx rgba(71, 92, 80, 0.1);
  transform: translateY(2rpx) scale(0.985);
}

.start-chat-plus {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: rgba(79, 127, 107, 0.1);
  font-size: 32rpx;
  font-weight: 300;
  line-height: 1;
  transition: background-color 180ms ease, color 180ms ease, transform 220ms ease;
}

.start-chat-pressed .start-chat-plus {
  background: var(--jade);
  color: #fffefb;
  transform: rotate(90deg);
}

.recent {
  margin-top: 72rpx;
}

.recent-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 18rpx;
  border-bottom: 2rpx solid var(--line);
}

.recent-title {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 500;
}

.recent-note {
  color: var(--ink-faint);
  font-size: 23rpx;
}

.story-row {
  display: flex;
  align-items: center;
  min-height: 196rpx;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.story-row:active {
  opacity: 0.64;
}

.story-copy {
  flex: 1;
  min-width: 0;
  padding-right: 24rpx;
}

.story-title {
  overflow: hidden;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.story-excerpt {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--ink-soft);
  font-size: 27rpx;
  line-height: 1.65;
  word-break: break-word;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.story-meta {
  margin-top: 8rpx;
  color: var(--ink-faint);
  font-size: 22rpx;
}

.story-continue {
  flex-shrink: 0;
  color: var(--jade);
  font-size: 27rpx;
  font-weight: 500;
}

.story-continue::after {
  content: " ›";
}

.home-empty {
  margin-top: 64rpx;
  padding: 36rpx 0;
  border-top: 2rpx solid var(--line);
}

.home-empty-title {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 500;
}

.home-empty-note {
  margin-top: 8rpx;
  color: var(--ink-faint);
  font-size: 26rpx;
}
