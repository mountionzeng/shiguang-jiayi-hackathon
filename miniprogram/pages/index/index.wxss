/* 首页只负责两件事：开始聊天，继续最近的故事。 */

.home {
  min-height: 100vh;
  padding: 38rpx 40rpx calc(60rpx + env(safe-area-inset-bottom));
}

.home-head {
  padding-top: 4rpx;
}

.topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.wordmark {
  display: flex;
  align-items: center;
}

.wordmark-icon {
  width: 42rpx;
  height: 42rpx;
  margin-right: 12rpx;
}

.wordmark-text {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 7rpx;
}

.book-links {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.book-link {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 8rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
}

.book-link:active {
  color: var(--jade);
}

.home-cover {
  margin-top: 34rpx;
  padding: 38rpx 34rpx 24rpx;
  border: 2rpx solid var(--line);
  border-radius: 34rpx;
}

.home-cover-label,
.home-cover-title,
.home-cover-sub,
.home-cover-stats,
.home-cover-open {
  position: relative;
  z-index: 1;
}

.home-cover-label {
  color: var(--lake);
  font-size: 23rpx;
  letter-spacing: 3rpx;
}

.home-cover-title {
  margin-top: 14rpx;
  color: var(--ink);
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.3;
}

.home-cover-sub {
  margin-top: 8rpx;
  color: var(--ink-soft);
  font-size: 27rpx;
}

.home-cover-stats {
  display: flex;
  align-items: stretch;
  margin-top: 30rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid rgba(31, 58, 52, 0.12);
}

.home-cover-stat {
  display: flex;
  flex: 1;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  min-height: 94rpx;
}

.home-cover-num {
  color: var(--ink);
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.2;
}

.home-cover-stat-label {
  margin-top: 3rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
}

.home-cover-line {
  width: 2rpx;
  margin: 22rpx 0;
  background: rgba(31, 58, 52, 0.12);
}

.home-cover-open {
  margin-top: 12rpx;
  color: var(--jade);
  font-size: 25rpx;
  font-weight: 600;
  text-align: right;
}

.home-cover:active {
  opacity: 0.82;
  transform: scale(0.992);
}

.start-chat {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 24rpx;
  padding: 0 28rpx;
  border: 2rpx solid rgba(23, 107, 84, 0.34);
  border-radius: 44rpx;
  background: transparent;
  color: var(--jade);
  font-size: 29rpx;
  font-weight: 600;
}

.start-chat:active {
  background: var(--jade-soft);
  transform: scale(0.985);
}

.start-chat-plus {
  margin-right: 8rpx;
  font-size: 34rpx;
  font-weight: 400;
}

.recent {
  margin-top: 64rpx;
}

.recent-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--line);
}

.recent-title {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 600;
}

.recent-note {
  color: var(--ink-faint);
  font-size: 24rpx;
}

.story-row {
  display: flex;
  align-items: center;
  min-height: 214rpx;
  padding: 30rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.story-row:active {
  opacity: 0.66;
}

.story-copy {
  flex: 1;
  min-width: 0;
  padding-right: 28rpx;
}

.story-title {
  overflow: hidden;
  color: var(--ink);
  font-size: 35rpx;
  font-weight: 600;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.story-excerpt {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 10rpx;
  color: var(--ink-soft);
  font-size: 29rpx;
  line-height: 1.65;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.story-meta {
  margin-top: 10rpx;
  color: var(--ink-faint);
  font-size: 23rpx;
}

.story-continue {
  flex-shrink: 0;
  padding: 14rpx 0 14rpx 18rpx;
  color: var(--jade);
  font-size: 27rpx;
  font-weight: 600;
}

.story-continue::after {
  content: " ›";
}

.home-empty {
  margin-top: 88rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid var(--line);
}

.home-empty-title {
  color: var(--ink);
  font-size: 36rpx;
  font-weight: 600;
}

.home-empty-note {
  margin-top: 10rpx;
  color: var(--ink-soft);
  font-size: 28rpx;
}
