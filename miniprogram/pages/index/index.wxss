.home-page {
  position: relative;
  overflow: hidden;
}
.home-page::before {
  position: absolute;
  top: -160rpx;
  right: -210rpx;
  width: 520rpx;
  height: 520rpx;
  border: 2rpx solid rgba(155, 86, 60, 0.12);
  border-radius: 50%;
  content: "";
}

.brand-lockup {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.brand-seal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  border-radius: 28rpx 28rpx 28rpx 8rpx;
  background: #9b563c;
  color: #fff7eb;
  font-size: 40rpx;
  box-shadow: 0 14rpx 30rpx rgba(101, 55, 36, 0.16);
}

.brand-copy {
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}

.brand-name {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.brand-note {
  margin-top: 4rpx;
  color: #807466;
  font-size: 21rpx;
}

.hero-copy {
  position: relative;
  z-index: 1;
  margin-top: 88rpx;
}

.hero-title {
  margin-top: 22rpx;
  white-space: pre-line;
  font-size: 66rpx;
  font-weight: 600;
  line-height: 1.28;
  letter-spacing: -2rpx;
}

.hero-description {
  width: 94%;
  margin-top: 30rpx;
  color: #6f6558;
  font-size: 27rpx;
  line-height: 1.85;
}

.memory-window {
  position: relative;
  margin-top: 58rpx;
  padding: 48rpx 42rpx 42rpx;
  overflow: hidden;
  border-radius: 6rpx 34rpx 6rpx 34rpx;
  background: #d9d0bf;
  box-shadow: 0 24rpx 64rpx rgba(72, 58, 42, 0.14);
}

.window-grain {
  position: absolute;
  inset: 0;
  border: 12rpx solid rgba(255, 250, 240, 0.18);
}

.quote-mark {
  position: absolute;
  top: 14rpx;
  left: 26rpx;
  color: rgba(85, 67, 49, 0.22);
  font-size: 112rpx;
  line-height: 1;
}

.memory-quote {
  position: relative;
  font-size: 35rpx;
  font-weight: 600;
  line-height: 1.72;
}

.memory-source {
  margin-top: 30rpx;
  color: #716352;
  font-size: 23rpx;
}

.verification-stamp {
  position: absolute;
  right: 26rpx;
  bottom: 24rpx;
  padding: 9rpx 13rpx;
  border: 2rpx solid rgba(155, 86, 60, 0.7);
  color: #925039;
  font-size: 20rpx;
  transform: rotate(-4deg);
}

.story-steps {
  display: flex;
  justify-content: space-between;
  margin: 46rpx 2rpx 36rpx;
  border-top: 2rpx solid #cfc3b2;
}

.story-step {
  display: flex;
  flex-direction: column;
  width: 30%;
  padding-top: 17rpx;
}

.step-number {
  color: #9b563c;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.step-label {
  margin-top: 7rpx;
  color: #4e463c;
  font-size: 24rpx;
}

.demo-note {
  margin-top: 20rpx;
  color: #9b9185;
  font-size: 20rpx;
  text-align: center;
}
