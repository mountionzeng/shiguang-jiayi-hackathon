/* 首页只负责两件事：开始聊天，继续最近的故事。 */

.home {
  min-height: 100vh;
  padding: 38rpx 40rpx calc(60rpx + env(safe-area-inset-bottom));
}

.home-head {
  padding-top: 4rpx;
}

.topline {
  display: flex;
  align-items: center;
}

.wordmark {
  display: flex;
  align-items: center;
}

.wordmark-icon {
  width: 42rpx;
  height: 42rpx;
  margin-right: 12rpx;
}

.wordmark-text {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 7rpx;
}

.home-cover {
  margin-top: 34rpx;
  padding: 38rpx 34rpx 24rpx;
  border: 2rpx solid var(--line);
  border-radius: 34rpx;
}

.home-cover-label,
.home-cover-title,
.home-cover-sub,
.home-cover-stats,
.home-cover-open {
  position: relative;
  z-index: 1;
}

.home-cover-label {
  color: var(--lake);
  font-size: 23rpx;
  letter-spacing: 3rpx;
}

.home-cover-title {
  margin-top: 14rpx;
  color: var(--ink);
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.3;
}

.home-cover-sub {
  margin-top: 8rpx;
  color: var(--ink-soft);
  font-size: 27rpx;
}

.home-cover-stats {
  display: flex;
  align-items: stretch;
  margin-top: 30rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid rgba(31, 58, 52, 0.12);
}

.home-cover-stat {
  display: flex;
  flex: 1;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  min-height: 94rpx;
}

.home-cover-num {
  color: var(--ink);
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.2;
}

.home-cover-stat-label {
  margin-top: 3rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
}

.home-cover-line {
  width: 2rpx;
  margin: 22rpx 0;
  background: rgba(31, 58, 52, 0.12);
}

.branch-buttons {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.branch-button {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
  min-height: 142rpx;
  padding: 20rpx 18rpx;
  border: 2rpx solid var(--line);
  border-radius: 26rpx;
  background: var(--paper-card);
  text-align: left;
}

.branch-button:active {
  background: var(--paper-sunk);
  transform: scale(0.985);
}

.branch-motif {
  position: relative;
  flex-shrink: 0;
  width: 72rpx;
  height: 66rpx;
  margin-right: 14rpx;
}

.book-page {
  position: absolute;
  bottom: 8rpx;
  width: 31rpx;
  height: 43rpx;
  border: 3rpx solid var(--jade);
  background: var(--jade-soft);
}

.book-page-left {
  left: 5rpx;
  border-right: 0;
  border-radius: 5rpx 0 3rpx 12rpx;
  transform: skewY(7deg);
}

.book-page-right {
  right: 5rpx;
  border-left: 0;
  border-radius: 0 5rpx 12rpx 3rpx;
  transform: skewY(-7deg);
}

.book-spine {
  position: absolute;
  bottom: 8rpx;
  left: 34rpx;
  width: 3rpx;
  height: 45rpx;
  border-radius: 2rpx;
  background: var(--jade);
}

.book-sun {
  position: absolute;
  top: 3rpx;
  right: 4rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--apricot);
}

.home-roof {
  position: absolute;
  top: 8rpx;
  left: 18rpx;
  width: 36rpx;
  height: 36rpx;
  border-top: 3rpx solid var(--lake);
  border-left: 3rpx solid var(--lake);
  border-radius: 4rpx 0 0;
  transform: rotate(45deg);
}

.home-body {
  position: absolute;
  bottom: 7rpx;
  left: 13rpx;
  width: 46rpx;
  height: 34rpx;
  border-right: 3rpx solid var(--lake);
  border-bottom: 3rpx solid var(--lake);
  border-left: 3rpx solid var(--lake);
  border-radius: 0 0 9rpx 9rpx;
  background: var(--lake-soft);
}

.home-person {
  position: absolute;
  bottom: 19rpx;
  z-index: 1;
  width: 11rpx;
  height: 11rpx;
  border-radius: 50%;
}

.home-person::after {
  position: absolute;
  top: 11rpx;
  left: -2rpx;
  width: 15rpx;
  height: 12rpx;
  border-radius: 8rpx 8rpx 3rpx 3rpx;
  content: "";
  background: inherit;
}

.home-person-one {
  left: 23rpx;
  background: var(--jade);
}

.home-person-two {
  right: 22rpx;
  background: var(--lake);
}

.branch-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.branch-name {
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 600;
  white-space: nowrap;
}

.branch-note {
  margin-top: 3rpx;
  color: var(--ink-faint);
  font-size: 21rpx;
}

.start-chat {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 24rpx;
  padding: 0 28rpx;
  border: 2rpx solid rgba(23, 107, 84, 0.34);
  border-radius: 44rpx;
  background: transparent;
  color: var(--jade);
  font-size: 29rpx;
  font-weight: 600;
}

.start-chat:active {
  background: var(--jade-soft);
  transform: scale(0.985);
}

.start-chat-plus {
  margin-right: 8rpx;
  font-size: 34rpx;
  font-weight: 400;
}

.recent {
  margin-top: 64rpx;
}

.recent-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--line);
}

.recent-title {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 600;
}

.recent-note {
  color: var(--ink-faint);
  font-size: 24rpx;
}

.story-row {
  display: flex;
  align-items: center;
  min-height: 214rpx;
  padding: 30rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.story-row:active {
  opacity: 0.66;
}

.story-copy {
  flex: 1;
  min-width: 0;
  padding-right: 28rpx;
}

.story-title {
  overflow: hidden;
  color: var(--ink);
  font-size: 35rpx;
  font-weight: 600;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.story-excerpt {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 10rpx;
  color: var(--ink-soft);
  font-size: 29rpx;
  line-height: 1.65;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.story-meta {
  margin-top: 10rpx;
  color: var(--ink-faint);
  font-size: 23rpx;
}

.story-continue {
  flex-shrink: 0;
  padding: 14rpx 0 14rpx 18rpx;
  color: var(--jade);
  font-size: 27rpx;
  font-weight: 600;
}

.story-continue::after {
  content: " ›";
}

.home-empty {
  margin-top: 88rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid var(--line);
}

.home-empty-title {
  color: var(--ink);
  font-size: 36rpx;
  font-weight: 600;
}

.home-empty-note {
  margin-top: 10rpx;
  color: var(--ink-soft);
  font-size: 28rpx;
}
