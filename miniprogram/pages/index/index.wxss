/* 字标：图形标与中文名称并排组合 */
.wordmark {
  display: flex;
  align-items: center;
  padding: 4rpx 0 20rpx;
}

.wordmark-icon {
  width: 46rpx;
  height: 46rpx;
  margin-right: 14rpx;
}

.wordmark-text {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  color: var(--ink);
}

/* 人生之书首页 */

/* ---- 演示身份 ---- */

.identity-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 12rpx 20rpx;
  border-radius: 24rpx;
  background: var(--paper-sunk);
}

.identity-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin-right: 20rpx;
  border-radius: 38rpx;
  background: var(--jade);
  color: #fbfdfc;
  font-size: 32rpx;
}

.identity-avatar-sm {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  background: var(--lake);
}

.identity-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.identity-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.identity-role {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--ink-faint);
}

.identity-arrow {
  flex-shrink: 0;
  padding-left: 16rpx;
  font-size: 26rpx;
  color: var(--lake);
}

.identity-picker {
  margin-top: 16rpx;
  padding: 8rpx;
  border-radius: 24rpx;
  border: 2rpx solid var(--line);
  background: var(--paper-card);
}

.identity-option {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 12rpx 16rpx;
  border-radius: 20rpx;
}

.identity-option:active {
  background: var(--paper-sunk);
}

.identity-check {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--jade);
}

/* ---- 书封面 ---- */

.cover {
  margin-top: 28rpx;
  padding: 40rpx 36rpx 24rpx;
  border-radius: 34rpx;
  border: 2rpx solid var(--line);
}

.cover-tap {
  position: relative;
  z-index: 1;
  padding-bottom: 32rpx;
}

.cover-label {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: var(--lake);
}

.cover-title {
  margin-top: 16rpx;
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--ink);
}

.cover-sub {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--ink-soft);
}

.cover-stats {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: stretch;
  padding-top: 8rpx;
  border-top: 2rpx solid rgba(31, 58, 52, 0.12);
}

.cover-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 104rpx;
  border-radius: 20rpx;
}

.cover-stat:active {
  background: rgba(255, 255, 255, 0.7);
}

.cover-stat-num {
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--ink);
}

.cover-stat-label {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
}

.cover-stat-line {
  width: 2rpx;
  margin: 24rpx 0;
  background: rgba(31, 58, 52, 0.12);
}

/* ---- 今日共享问题 ---- */

.question-card {
  margin-top: 28rpx;
  padding: 32rpx;
  border-radius: 30rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--line);
}

.question-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.question-date {
  font-size: 24rpx;
  color: var(--ink-faint);
}

.question-text {
  margin-top: 24rpx;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.6;
  color: var(--ink);
}

.question-hint {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--ink-soft);
}

.question-btn {
  margin-top: 32rpx;
}

/* ---- 已确认片段 ---- */

.fragments {
  margin-top: 44rpx;
}

.fragment-card {
  margin-bottom: 20rpx;
  padding: 28rpx 30rpx;
  border-radius: 26rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--line);
}

.fragment-card:active {
  background: var(--paper-sunk);
}

.fragment-text {
  font-size: 34rpx;
  line-height: 1.75;
  color: var(--ink);
}

.fragment-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.fragment-byline {
  font-size: 24rpx;
  color: var(--ink-faint);
}

/* ---- 空状态 ---- */

.empty-block {
  margin-top: 44rpx;
  padding: 44rpx 36rpx;
  border-radius: 30rpx;
  border: 2rpx solid var(--line);
}

.empty-mark {
  position: relative;
  z-index: 1;
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 20rpx;
  opacity: 0.9;
}

.empty-title {
  position: relative;
  z-index: 1;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--ink);
}

.empty-desc {
  position: relative;
  z-index: 1;
  margin-top: 16rpx;
  font-size: 30rpx;
  line-height: 1.75;
  color: var(--ink-soft);
}

.empty-steps {
  position: relative;
  z-index: 1;
  margin-top: 32rpx;
}

.empty-step {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  font-size: 28rpx;
  color: var(--ink-soft);
}

.empty-step-num {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin-right: 16rpx;
  border-radius: 22rpx;
  background: var(--lake-soft);
  color: var(--lake);
  font-size: 24rpx;
  font-weight: 600;
}

/* ---- 说明 ---- */

.demo-note {
  margin-top: 40rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: var(--paper-sunk);
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--ink-faint);
}
