.memory-page { padding: 64rpx 40rpx 100rpx; color: var(--text-ink, #343e35); }
.memory-eyebrow { font-size: 24rpx; color: var(--text-secondary, #68756a); letter-spacing: 3rpx; }
.memory-heading { font-size: 48rpx; margin-top: 14rpx; }
.memory-intro { font-size: 28rpx; line-height: 1.8; margin: 26rpx 0 44rpx; }
.memory-setting { display: flex; justify-content: space-between; align-items: center; padding: 30rpx 0; border-top: 1rpx solid #d6dbd3; border-bottom: 1rpx solid #d6dbd3; }
.memory-setting-title { font-size: 30rpx; margin-bottom: 12rpx; }
.memory-note { font-size: 24rpx; color: var(--text-secondary, #68756a); line-height: 1.6; }
.memory-item { padding: 34rpx 0; border-bottom: 1rpx solid #d6dbd3; }
.memory-text { font-size: 30rpx; line-height: 1.8; }
.memory-evidence { margin-top: 20rpx; padding: 18rpx 20rpx; border-radius: 12rpx; background: #f4f5f0; }
.memory-evidence-source { display: flex; gap: 16rpx; margin-top: 10rpx; color: var(--text-secondary, #68756a); font-size: 23rpx; line-height: 1.6; }
.memory-item-bottom { display: block; margin-top: 18rpx; }
.memory-actions { display: flex; gap: 8rpx; margin-top: 12rpx; }
.memory-action { flex: 1; margin: 0; padding: 8rpx 10rpx; font-size: 24rpx; line-height: 1.8; color: #315e4a; background: transparent; }
.memory-action::after { border: 1rpx solid #9aac9e; }
.memory-empty, .memory-status { padding: 48rpx 0; color: var(--text-secondary, #68756a); font-size: 28rpx; line-height: 1.8; }
