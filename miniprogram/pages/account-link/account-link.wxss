.link-page{position:relative;min-height:100vh;background:#fbf8f1}.paper{position:fixed;inset:0;width:100%;height:100%;opacity:.7}.content{position:relative;padding:72rpx 42rpx}.title{font-size:44rpx;font-weight:700;color:#38342f}.note,.hint,.empty{margin-top:18rpx;color:#756c62;font-size:25rpx;line-height:1.7}.story,.code-card{box-sizing:border-box;background:rgba(255,252,244,.9);box-shadow:0 16rpx 42rpx rgba(76,58,41,.1)}.primary{background:#6f4f3a!important;color:#fff!important}.section{margin:42rpx 0 18rpx;font-size:34rpx}.story{display:flex;align-items:center;justify-content:space-between;width:100%;margin:14rpx 0;padding:28rpx;border:0;border-radius:24rpx;color:#443d35;text-align:left}.story view{display:flex;min-width:0;flex-direction:column}.story-title{font-size:29rpx}.story-detail,.story-excerpt,.story-arrow{margin-top:8rpx;color:#81766b;font-size:23rpx}.story-excerpt{max-width:430rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.story-arrow{flex:none;margin-left:18rpx;color:#6f4f3a}.code-card{margin-top:34rpx;padding:34rpx;border-radius:34rpx 25rpx 38rpx 28rpx;text-align:center}.code-title{font-size:30rpx}.code{margin:24rpx 0 8rpx;color:#6f4f3a;font-size:54rpx;font-weight:700;letter-spacing:14rpx}.expires{color:#81766b;font-size:23rpx}.code-card button{margin-top:24rpx}.load-more{margin:24rpx auto;background:transparent;color:#6f4f3a;font-size:25rpx}.load-more::after,.story::after,.code-card button::after{border:0}

/* 微信按钮默认 width:184px 的选择器带属性，优先级高于单个类名；这里用双写类名把按钮宽度和左右外边距压回设计值。 */
.story.story { width: 100%; margin-left: 0; margin-right: 0; }
