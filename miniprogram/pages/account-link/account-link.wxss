.link-page{position:relative;min-height:100vh;background:#fbf8f1}.paper{position:fixed;inset:0;width:100%;height:100%;opacity:.7}.content{position:relative;padding:72rpx 42rpx}.title{font-size:44rpx;font-weight:700;color:#38342f}.note,.hint,.empty{margin-top:18rpx;color:#756c62;font-size:25rpx;line-height:1.7}.card,.story,.sheet{box-sizing:border-box;background:rgba(255,252,244,.9);box-shadow:0 16rpx 42rpx rgba(76,58,41,.1)}.card{margin-top:38rpx;padding:34rpx;border-radius:34rpx 25rpx 38rpx 28rpx}.card input{height:88rpx;border-bottom:2rpx solid rgba(111,79,58,.24);font-size:29rpx}.otp{display:flex;align-items:center;gap:14rpx}.otp input{flex:1}.otp button,.actions button{font-size:24rpx}.primary{background:#6f4f3a!important;color:#fff!important}.section{margin:42rpx 0 18rpx;font-size:34rpx}.story{display:flex;justify-content:space-between;width:100%;margin:14rpx 0;padding:28rpx;border:0;border-radius:24rpx;color:#443d35;font-size:27rpx}.story::after,.card button::after,.actions button::after{border:0}.mask{position:fixed;inset:0;z-index:20;display:flex;align-items:flex-end;background:rgba(42,37,31,.42)}.sheet{width:100%;padding:38rpx 34rpx calc(30rpx + env(safe-area-inset-bottom));border-radius:38rpx 38rpx 0 0}.sheet-title{font-size:36rpx;font-weight:700}.sheet textarea{box-sizing:border-box;width:100%;height:360rpx;margin-top:22rpx;padding:24rpx;background:#f8f1e4;font-size:27rpx;line-height:1.7}.actions{display:flex;gap:12rpx;margin-top:24rpx}.actions button{flex:1}
