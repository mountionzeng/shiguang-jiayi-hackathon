<view class="writing-page {{keyboardHeight ? 'keyboard-open' : ''}}" style="height: {{viewportHeight ? viewportHeight + 'px' : '100%'}};">
  <view class="writing-toolbar">
    <button class="tool-button" bindtap="onBack" disabled="{{saving || generating || pickingPhoto}}"><view class="action-icon icon-back" aria-hidden="true"></view>{{view === 'chapter' ? '目录' : '返回'}}</button>
    <button class="tool-button" bindtap="addPhoto" disabled="{{!draft || view !== 'chapter' || panel || saving || generating || pickingPhoto || !editorReady}}"><view class="action-icon icon-photo" aria-hidden="true"></view>{{pickingPhoto ? '添加中' : '照片'}}</button>
    <button class="tool-button save-button" bindtap="saveEdits" disabled="{{!draft || !editing || saving || generating || panel || pickingPhoto || (view === 'chapter' && !editorReady)}}"><view class="action-icon icon-save" aria-hidden="true"></view>{{saving ? '保存中' : '保存'}}</button>
    <button class="tool-button" bindtap="showMore" disabled="{{saving || generating || pickingPhoto}}"><view class="action-icon icon-more" aria-hidden="true"></view>更多</button>
  </view>
  <view class="top-tools" wx:if="{{moreOpen}}">
    <button wx:if="{{editing}}" class="tool-button" data-action="discard" bindtap="selectTool"><view class="action-icon icon-undo" aria-hidden="true"></view>放弃修改</button>
    <block wx:elif="{{view === 'chapter'}}">
      <button class="tool-button" data-action="memories" bindtap="selectTool"><view class="action-icon icon-memories" aria-hidden="true"></view>本章记忆</button>
      <button class="tool-button" data-action="up" bindtap="selectTool"><view class="action-icon icon-up" aria-hidden="true"></view>上移本章</button>
      <button class="tool-button" data-action="down" bindtap="selectTool"><view class="action-icon icon-down" aria-hidden="true"></view>下移本章</button>
      <button class="tool-button" data-action="delete-chapter" bindtap="selectTool"><view class="action-icon icon-delete" aria-hidden="true"></view>删除本章</button>
      <button class="tool-button" data-action="history" bindtap="selectTool"><view class="action-icon icon-history" aria-hidden="true"></view>历史版本</button>
      <button class="tool-button" data-action="generate" bindtap="selectTool"><view class="action-icon icon-ai" aria-hidden="true"></view>AI 整理</button>
      <button class="tool-button" data-action="images" bindtap="selectTool"><view class="action-icon icon-photo" aria-hidden="true"></view>给本章配图</button>
    </block>
    <block wx:else>
      <button class="tool-button" data-action="new-chapter" bindtap="selectTool"><view class="action-icon icon-new" aria-hidden="true"></view>新开一章</button>
      <button wx:if="{{draft}}" class="tool-button" data-action="history" bindtap="selectTool"><view class="action-icon icon-history" aria-hidden="true"></view>历史版本</button>
      <button wx:if="{{draft}}" class="tool-button" data-action="version" bindtap="selectTool"><view class="action-icon icon-version" aria-hidden="true"></view>命名存档</button>
      <button class="tool-button" data-action="generate" bindtap="selectTool"><view class="action-icon icon-ai" aria-hidden="true"></view>AI 整理</button>
      <button class="tool-button" data-action="sources" bindtap="selectTool"><view class="action-icon icon-memories" aria-hidden="true"></view>原始记忆</button>
      <button wx:if="{{draft}}" class="tool-button" data-action="images" bindtap="selectTool"><view class="action-icon icon-photo" aria-hidden="true"></view>这本书的图</button>
      <button wx:if="{{!draft}}" class="tool-button" data-action="record" bindtap="selectTool"><view class="action-icon icon-record" aria-hidden="true"></view>记录经历</button>
    </block>
  </view>
  <view class="notice" wx:if="{{saveNotice || loadError}}">{{saveNotice || loadError}}</view>
  <view class="panel-actions" wx:if="{{loadError}}"><button class="tool-button" bindtap="retryLoad">重新加载</button></view>
  <view class="panel-actions" wx:if="{{canUndo && !panel && !editing}}">
    <button class="tool-button" bindtap="undoOrganize" disabled="{{saving || generating}}"><view class="action-icon icon-undo" aria-hidden="true"></view>撤回这次整理</button>
  </view>
  <view class="panel-actions" wx:if="{{panel}}">
    <button class="tool-button" bindtap="closePanel" disabled="{{saving || generating}}"><view class="action-icon icon-back" aria-hidden="true"></view>{{view === 'chapter' ? '回到正文' : '回到目录'}}</button>
    <button wx:if="{{panel === 'organize'}}" class="tool-button save-button" bindtap="runOrganize" disabled="{{saving || generating}}"><view class="action-icon icon-ai" aria-hidden="true"></view>{{generating ? '整理中…' : '生成正文预览'}}</button>
    <button wx:if="{{panel === 'organize-preview'}}" class="tool-button save-button" bindtap="confirmOrganize" disabled="{{saving}}">确认写入正文</button>
    <button wx:if="{{panel === 'history' && previewVersion}}" class="tool-button save-button" bindtap="restoreVersion" disabled="{{saving}}"><view class="action-icon icon-restore" aria-hidden="true"></view>恢复此版</button>
    <button wx:if="{{panel === 'version'}}" class="tool-button save-button" bindtap="saveVersion" disabled="{{saving}}"><view class="action-icon icon-version" aria-hidden="true"></view>存为版本</button>
  </view>
  <!-- Contents: the book title and its chapters. Kept mounted so the native title input keeps its value. -->
  <scroll-view class="reading-panel contents-view" scroll-y hidden="{{!draft || panel || view !== 'contents'}}">
    <view class="panel-content">
      <view class="title-field">
        <view class="field-label">书稿标题</view>
        <input class="manuscript-title serif" value="{{editTitle}}" maxlength="80" bindinput="onEditTitle" bindkeyboardheightchange="onKeyboardHeight" adjust-position="{{false}}" disabled="{{saving || generating}}" placeholder="写一个标题" />
      </view>
      <view class="field-label contents-label">目录 · 点一章开始写</view>
      <button class="chapter-row" wx:for="{{chapterRows}}" wx:key="id" data-id="{{item.id}}" bindtap="openChapter">
        <text class="chapter-name serif">{{item.label}}{{item.title ? '　' + item.title : ''}}</text>
        <text class="version-date">{{item.memoryCount}} 条记忆 · {{item.photoCount}} 张照片</text>
      </button>
      <button class="tool-button add-chapter" data-action="new-chapter" bindtap="selectTool"><view class="action-icon icon-new" aria-hidden="true"></view>＋ 新开一章</button>
      <block wx:if="{{unassigned.length}}">
        <view class="field-label contents-label">还没放进书稿的记忆 · {{unassigned.length}}</view>
        <view class="memory-row" wx:for="{{unassigned}}" wx:key="id">
          <text class="memory-text">{{item.text}}</text>
          <button class="tool-button" data-id="{{item.id}}" bindtap="chooseChapterFor"><view class="action-icon icon-insert" aria-hidden="true"></view>放进…</button>
        </view>
      </block>
    </view>
  </scroll-view>
  <!-- One chapter: keep both native inputs mounted; initialize values only on load/switch/save/discard. -->
  <view wx:for="{{editorKeys}}" wx:key="*this" class="writing-fields" hidden="{{!draft || panel || view !== 'chapter'}}">
    <view class="title-field">
      <view class="field-label">{{editTitle}} · {{chapterLabelText}}</view>
      <input class="manuscript-title serif" value="{{editChapterTitle}}" maxlength="40" bindinput="onEditChapterTitle" bindkeyboardheightchange="onKeyboardHeight" adjust-position="{{false}}" disabled="{{saving || generating}}" placeholder="给这一章起个名字（可以不填）" />
    </view>
    <view class="body-field">
      <image wx:if="{{backdropUrl}}" class="chapter-backdrop" src="{{backdropUrl}}" mode="aspectFill" aria-hidden="true" />
      <!-- The fade and keyboard can hide the watermark inside the picture, so the page labels it too. -->
      <view wx:if="{{backdropUrl}}" class="backdrop-ai-label">图片 AI 生成</view>
      <view class="field-label">正文</view>
      <editor id="manuscript-editor" class="manuscript-body" bindready="onEditorReady" bindinput="onEditorInput" read-only="{{saving || generating || !editorReady}}" placeholder="从这里开始写…" show-img-size="{{false}}" show-img-toolbar="{{false}}" show-img-resize="{{false}}"></editor>
    </view>
  </view>
  <scroll-view class="reading-panel" scroll-y wx:if="{{panel}}">
    <view class="panel-content">
      <block wx:if="{{panel === 'version'}}">
        <view class="panel-title serif">给这一版起个名字</view>
        <input class="version-name" value="{{versionName}}" maxlength="30" bindinput="onVersionName" placeholder="例如：补充了大学经历" />
        <view class="panel-note">不填也可以。旧版会一直保留。</view>
      </block>
      <block wx:if="{{panel === 'history'}}">
        <view class="panel-title serif">历史版本</view>
        <view wx:if="{{!history.length}}" class="panel-note">保存修改后，这里会保留版本记录。</view>
        <button class="version-row" wx:for="{{history}}" wx:key="id" data-id="{{item.id}}" bindtap="previewHistory">
          <text>{{item.label}}</text><text class="version-date">{{item.savedAt}}</text>
        </button>
        <view wx:if="{{previewVersion}}">
          <view class="panel-title serif">{{previewVersion.draft.title}}</view>
          <view class="chapter-para serif" wx:for="{{previewBlocks}}" wx:key="index">
            <image wx:if="{{item.path}}" class="book-photo" src="{{item.path}}" mode="widthFix" />
            <text wx:else selectable>{{item.text}}</text>
          </view>
        </view>
      </block>
      <block wx:if="{{panel === 'organize'}}">
        <view class="panel-title serif">AI 整理记忆</view>
        <view class="field-label">写进哪个故事</view>
        <radio-group bindchange="onOrganizeBook"><label class="memory-row" wx:for="{{organizeBooks}}" wx:key="id"><radio value="{{item.id}}" checked="{{organizeBookKey === item.id}}" disabled="{{generating}}" /><text class="memory-text">{{item.title}}</text><text class="version-date">{{item.detail}}</text></label></radio-group>
        <view class="panel-note">人生之书里的所有故事都会显示。选择还没有章节的故事，会在当前人生之书里新开一章。</view>
        <view class="field-label">1. 勾选要整理的记忆</view>
        <checkbox-group bindchange="onOrganizeMemories">
          <label class="memory-row" wx:for="{{organizeRows}}" wx:key="id">
            <checkbox value="{{item.id}}" checked="{{item.checked}}" />
            <text class="memory-text">{{item.text}}</text>
            <text class="version-date">{{item.where}}</text>
          </label>
        </checkbox-group>
        <view class="field-label contents-label">2. 放进哪一章</view>
        <radio-group bindchange="onOrganizeTarget">
          <label class="memory-row" wx:for="{{chapterRows}}" wx:key="id">
            <radio value="{{item.id}}" checked="{{organizeTarget === item.id}}" />
            <text class="memory-text">{{item.label}}{{item.title ? '　' + item.title : ''}}</text>
          </label>
          <label class="memory-row">
            <radio value="new" checked="{{organizeTarget === 'new'}}" />
            <text class="memory-text">新开一章</text>
          </label>
        </radio-group>
        <view class="panel-note">先生成预览，确认后才写入正文。新章按记忆内容建议标题，可以修改；素材少时先写成一章，以后再按人生阶段、主题或事件分章。已有章节会结合原文整理，照片保留。</view>
      </block>
      <block wx:if="{{panel === 'organize-preview'}}">
        <view class="panel-title serif">确认这一章的正文</view>
        <view class="panel-note">可以修改标题和文字；确认写入前，已保存的书稿不会改变。</view>
        <input class="version-name" value="{{previewTitle}}" bindinput="onPreviewTitle" maxlength="40" disabled="{{saving}}" placeholder="章节标题" />
        <textarea class="preview-editor" value="{{previewText}}" bindinput="onPreviewText" maxlength="20000" auto-height disabled="{{saving}}" />
      </block>
      <block wx:if="{{panel === 'sources'}}">
        <view class="panel-title serif">原始记忆 · {{sourceCount}}</view>
        <view class="panel-note">{{storageLabel}}</view>
        <view class="panel-note" wx:if="{{stale}}">素材已有变化，当前正文仍然保留。</view>
        <view class="chapter-para source-item serif" wx:for="{{sources}}" wx:key="id"><text selectable>{{item.text}}</text></view>
      </block>
      <block wx:if="{{panel === 'new-chapter'}}">
        <view class="panel-title serif">新开一章</view>
        <button class="version-row" data-story="" bindtap="createChapter" disabled="{{saving}}">
          <text>空白的一章</text><text class="version-date">自己写，或之后把记忆放进来</text>
        </button>
        <button class="version-row" wx:for="{{storyOptions}}" wx:key="title" data-story="{{item.title}}" bindtap="createChapter" disabled="{{saving}}">
          <text>用故事「{{item.title}}」开一章</text><text class="version-date">这个故事的 {{item.count}} 条记忆原文会加入正文</text>
        </button>
      </block>
      <block wx:if="{{panel === 'assign'}}">
        <view class="panel-title serif">放进哪一章？</view>
        <button class="version-row" wx:for="{{chapterRows}}" wx:key="id" data-id="{{item.id}}" bindtap="assignTo" disabled="{{saving}}">
          <text>{{item.label}}{{item.title ? '　' + item.title : ''}}</text>
        </button>
        <button class="version-row" data-id="new" bindtap="assignTo" disabled="{{saving}}"><text>新开一章放它</text></button>
        <view class="panel-note">放进章节后，记忆原文会加入该章正文；原始记忆仍会保留。</view>
      </block>
      <block wx:if="{{panel === 'memories'}}">
        <view class="panel-title serif">{{chapterLabelText}}用到的记忆</view>
        <view wx:if="{{!chapterMemories.length}}" class="panel-note">这一章还没有放进记忆。</view>
        <view class="memory-row" wx:for="{{chapterMemories}}" wx:key="id">
          <text class="memory-text">{{item.text}}</text>
          <button class="tool-button" data-id="{{item.id}}" bindtap="removeFromChapter" disabled="{{saving}}"><view class="action-icon icon-remove" aria-hidden="true"></view>移出</button>
        </view>
        <block wx:if="{{unassigned.length}}">
          <view class="field-label contents-label">还没放进书稿的记忆</view>
          <view class="memory-row" wx:for="{{unassigned}}" wx:key="id">
            <text class="memory-text">{{item.text}}</text>
            <button class="tool-button" data-id="{{item.id}}" bindtap="addToChapter" disabled="{{saving}}"><view class="action-icon icon-insert" aria-hidden="true"></view>放进本章</button>
          </view>
        </block>
        <view class="panel-note">放进本章会把记忆原文加入正文；移出只解除归档，不会删除已经编辑的正文或原始记忆。</view>
      </block>
    </view>
  </scroll-view>
  <view class="empty-state" wx:if="{{!draft && !loadError && !panel}}">
    <view class="panel-title serif">{{sourceCount ? '把记忆写成一本书' : '从一段记忆开始'}}</view>
    <view class="panel-note">{{sourceCount ? '新开第一章，把记忆放进去；也可以点「更多」请 AI 整理。' : '点右上角「更多」，开始记录经历。'}}</view>
    <button wx:if="{{sourceCount}}" class="tool-button save-button add-chapter" data-action="new-chapter" bindtap="selectTool"><view class="action-icon icon-new" aria-hidden="true"></view>新开第一章</button>
  </view>
</view>
