<view class="writing-page {{keyboardHeight ? 'keyboard-open' : ''}}" style="height: {{viewportHeight ? viewportHeight + 'px' : '100%'}};">
  <view wx:if="{{openingChapter}}" class="writing-toolbar"><button class="tool-button" bindtap="onBack">‹ 返回目录</button></view>
  <scroll-view wx:if="{{openingChapter}}" class="reading-panel" scroll-y>
    <view class="panel-content">
      <view class="contents-section serif">{{openingChapter.title || '还没起名字'}}</view>
      <view class="notice">图片正在加载，可以先阅读正文…</view>
      <text class="chapter-loading-text serif" selectable>{{openingChapter.text}}</text>
    </view>
  </scroll-view>
  <view class="writing-toolbar" wx:if="{{!openingChapter && panel !== 'organize' && panel !== 'organize-preview'}}">
    <button class="tool-button" bindtap="onBack" disabled="{{saving || generating || pickingPhoto || appendingOwn}}"><view class="action-icon icon-back" aria-hidden="true"></view>{{view === 'chapter' ? '目录' : '返回'}}</button>
    <button wx:if="{{!protectedCopy}}" class="tool-button" bindtap="togglePhotoMenu" disabled="{{!draft || panel || saving || generating || pickingPhoto || preparingPhoto}}"><view class="action-icon icon-photo" aria-hidden="true"></view>{{pickingPhoto ? '添加中' : '图片'}}<text class="send-chevron">⌄</text></button>
    <button wx:if="{{!protectedCopy && storyImageSelected}}" class="tool-button" catchtouchstart="placeSelectedStoryImage" disabled="{{!editorReady || refreshingStoryImage || saving || generating || pickingPhoto}}"><view class="action-icon icon-photo" aria-hidden="true"></view>{{refreshingStoryImage ? '准备插图' : '插入插图'}}</button>
    <button wx:if="{{!protectedCopy && !storyImageSelected}}" class="tool-button send-toggle" bindtap="toggleSend" disabled="{{!draft || panel || preparingSend || generating || pickingPhoto}}">{{preparingSend ? '准备中' : '发送'}}<text class="send-chevron">⌄</text></button>
    <button wx:if="{{protectedCopy && view === 'chapter'}}" class="tool-button save-button" bindtap="openAppendOwn" disabled="{{panel || appendingOwn}}">补充经历</button>
    <button wx:if="{{protectedCopy && view === 'chapter'}}" class="tool-button" bindtap="returnOwnExperience" disabled="{{panel || returningOwn || appendingOwn}}">{{returningOwn ? '发送中' : '发回原作者'}}</button>
    <button wx:if="{{!protectedCopy}}" class="tool-button save-button" bindtap="saveEdits" disabled="{{!draft || !editing || saving || generating || panel || pickingPhoto || (view === 'chapter' && !editorReady)}}"><view class="action-icon icon-save" aria-hidden="true"></view>{{saving ? '保存中' : '保存'}}</button>
    <button class="tool-button" bindtap="showMore" disabled="{{loading || saving || generating || pickingPhoto || appendingOwn}}"><view class="action-icon icon-more" aria-hidden="true"></view>更多</button>
  </view>
  <view wx:if="{{photoMenu}}" class="send-dismiss" bindtap="closePhotoMenu" aria-label="收起图片菜单"></view>
  <view wx:if="{{photoMenu}}" class="photo-menu">
    <block wx:if="{{photoMenu === 'main'}}">
      <button class="photo-option" data-action="import" bindtap="choosePhotoAction">图片导入<text>›</text></button>
      <button class="photo-option" bindtap="showPhotoGeneration">图片生成<text>›</text></button>
      <button class="photo-option" data-action="images" bindtap="selectTool">已有图片<text>›</text></button>
    </block>
    <block wx:elif="{{photoMenu === 'generate'}}">
      <button class="photo-menu-back" bindtap="togglePhotoMenu">‹ 返回图片菜单</button>
      <button class="photo-option" data-action="illustration" bindtap="choosePhotoAction">生成插图<text>›</text></button>
      <button class="photo-option" data-action="backdrop" bindtap="choosePhotoAction">生成底图<text>›</text></button>
      <button class="photo-option" data-action="cover" bindtap="choosePhotoAction">生成封面<text>›</text></button>
    </block>
    <block wx:else>
      <view class="photo-menu-title">选择要配图的章节</view>
      <scroll-view class="photo-chapter-list" scroll-y>
        <button class="photo-option photo-chapter-option" wx:for="{{chapterRows}}" wx:key="id" data-id="{{item.id}}" bindtap="choosePhotoChapter"><text>{{item.label}} · {{item.title || '还没起名字'}}</text><text>›</text></button>
      </scroll-view>
      <view class="photo-menu-empty" wx:if="{{!chapterRows.length}}">先新开一章，再为它导入图片或生成配图。</view>
    </block>
  </view>
  <view wx:if="{{sendOpen}}" class="send-dismiss" bindtap="closeSend" aria-label="收起发送菜单"></view>
  <view wx:if="{{sendOpen}}" class="send-menu">
    <button class="send-option" data-destination="family" bindtap="chooseSend">发送给家人<text>›</text></button>
    <button class="send-option" data-destination="social" bindtap="chooseSend">发送到社交媒体<text>›</text></button>
    <button class="send-option" data-destination="card" bindtap="chooseSend">制作公开故事卡<text>›</text></button>
    <button wx:if="{{storyId && savedRevisionId && !editing}}" class="send-option" data-action="invite" bindtap="selectTool">亲友阅读与权限<text>›</text></button>
    <button wx:if="{{view === 'chapter'}}" class="send-option" catchtouchstart="openShareSelection">发送选中的文字<text>›</text></button>
  </view>
  <view wx:if="{{moreOpen}}" class="send-dismiss" bindtap="closeMore" aria-label="收起更多菜单"></view>
  <scroll-view class="more-menu" wx:if="{{moreOpen}}" scroll-y>

    <block wx:if="{{moreSection === 'chapter'}}">
      <button class="more-option more-back" bindtap="showMoreMain">‹ 返回更多</button>
      <button class="more-option" data-action="new-chapter" bindtap="selectTool">新建章节</button>
      <button class="more-option" data-action="up" bindtap="selectTool">上移本章</button>
      <button class="more-option" data-action="down" bindtap="selectTool">下移本章</button>
      <button class="more-option more-danger" data-action="delete-chapter" bindtap="selectTool">删除本章</button>
    </block>
    <block wx:else>
      <button wx:if="{{draft}}" class="more-option" data-action="history" bindtap="selectTool">历史版本<text>›</text></button>
      <block wx:if="{{protectedCopy && storyId && savedRevisionId && !editing}}">
        <button class="more-option" data-action="invite" bindtap="selectTool">亲友阅读与权限<text>›</text></button>
        <button class="more-option" data-action="share-card" bindtap="selectTool">制作公开故事卡<text>›</text></button>
      </block>
      <block wx:if="{{!protectedCopy}}">
        <button class="more-option" data-action="{{view === 'chapter' ? 'memories' : 'sources'}}" bindtap="selectTool">{{view === 'chapter' ? '本章记忆' : '原始记忆'}}<text>›</text></button>
        <button class="more-option" data-action="generate" bindtap="selectTool">AI 整理<text>›</text></button>
        <button wx:if="{{view === 'chapter'}}" class="more-option" bindtap="showChapterTools">章节管理<text>›</text></button>
        <button wx:else class="more-option" data-action="mode" bindtap="selectTool">切换写作模式<text>›</text></button>
        <button wx:if="{{view === 'chapter' && storyId && savedRevisionId}}" class="more-option" data-action="audio" bindtap="selectTool">制作有声书<text>›</text></button>
        <button wx:if="{{!draft}}" class="more-option" data-action="record" bindtap="selectTool">记录经历<text>›</text></button>
      </block>
      <block wx:if="{{editing}}">
        <button class="more-option" data-action="copy-draft" bindtap="selectTool">复制当前正文</button>
        <button class="more-option more-danger" data-action="discard" bindtap="selectTool">放弃修改</button>
      </block>
      <button wx:if="{{storyId && savedRevisionId && !editing && !protectedCopy}}" class="more-option more-danger" bindtap="deleteCurrentStory">删除整个故事（可恢复）</button>
    </block>
  </scroll-view>
  <view class="notice" wx:if="{{saveNotice || loadError}}">{{saveNotice || loadError}}</view>
  <view class="notice" wx:elif="{{modeLabel}}">{{modeLabel}} · {{modeNote}}</view>
  <view class="panel-actions" wx:if="{{loadError}}"><button class="tool-button" bindtap="retryLoad">重新加载</button></view>
  <view class="panel-actions" wx:if="{{canUndo && !panel && !editing}}">
    <button class="tool-button" bindtap="undoOrganize" disabled="{{saving || generating}}"><view class="action-icon icon-undo" aria-hidden="true"></view>撤回这次整理</button>
  </view>
  <view class="panel-actions" wx:if="{{panel && panel !== 'organize' && panel !== 'organize-preview'}}">
    <button class="tool-button" bindtap="closePanel" disabled="{{saving || generating || appendingOwn}}"><view class="action-icon icon-back" aria-hidden="true"></view>{{view === 'chapter' ? '回到正文' : '回到目录'}}</button>
    <button wx:if="{{panel === 'history' && previewVersion}}" class="tool-button save-button" bindtap="restoreVersion" disabled="{{saving}}"><view class="action-icon icon-restore" aria-hidden="true"></view>恢复此版</button>
    <button wx:if="{{panel === 'version'}}" class="tool-button save-button" bindtap="saveVersion" disabled="{{saving}}"><view class="action-icon icon-version" aria-hidden="true"></view>存为版本</button>
    <button wx:if="{{panel === 'share-excerpt'}}" class="tool-button save-button" bindtap="sendExcerpt" disabled="{{sharingExcerpt}}">{{sharingExcerpt ? '发送中…' : '确认发送'}}</button>
    <button wx:if="{{panel === 'append-own'}}" class="tool-button save-button" bindtap="appendOwnExperience" disabled="{{appendingOwn}}">{{appendingOwn ? '保存中…' : '保存我的补充'}}</button>
  </view>
  <view class="book-generation" wx:if="{{loading && !draft && !loadError && !openingChapter}}"><generation-status text="正在打开这本书…" /></view>
  <view class="book-generation" wx:if="{{generating}}"><generation-status text="正在整理正文，完成后可以先预览…" /></view>
  <!-- Contents: the book title and its chapters. Kept mounted so the native title input keeps its value. -->
  <scroll-view class="reading-panel contents-view" scroll-y hidden="{{openingChapter || !draft || panel || view !== 'contents'}}">
    <view class="panel-content contents-content">
      <view class="contents-head {{coverUrl ? 'contents-head-covered' : ''}}">
        <image wx:if="{{coverUrl}}" class="contents-cover-background" src="{{coverUrl}}" mode="aspectFill" binderror="onCoverError" aria-hidden="true"></image>
        <view class="contents-cover-shade"></view>
        <view class="contents-book-copy">
          <view class="field-label">书名</view>
          <input class="manuscript-title serif" value="{{editTitle}}" maxlength="80" bindinput="onEditTitle" bindkeyboardheightchange="onKeyboardHeight" adjust-position="{{false}}" disabled="{{protectedCopy || saving || generating}}" placeholder="写一个标题" />
          <view class="contents-summary">{{chapterRows.length}} 章 · {{unassigned.length}} 段记忆还没写进</view>
          <view class="contents-intro-label"><text>内容简介<text wx:if="{{!protectedCopy}}"> · 可编辑</text></text><button wx:if="{{!protectedCopy && !editing}}" class="intro-edit" bindtap="editIntroduction">编辑</button></view>
          <textarea wx:if="{{editing && view === 'contents'}}" class="contents-introduction contents-introduction-edit" value="{{editIntroduction}}" maxlength="500" auto-height bindinput="onEditIntroduction" placeholder="写几句话介绍这本故事" />
          <view wx:else class="contents-introduction">{{bookIntroduction || '还没有正文。从一段记忆开始，慢慢写成这本书。'}}</view>
        </view>
      </view>
      <view class="contents-section serif"><text>目录</text><button wx:if="{{!protectedCopy}}" class="contents-add-inline" data-action="new-chapter" bindtap="selectTool"><view class="action-icon icon-new" aria-hidden="true"></view>新建章节</button></view>
      <view wx:if="{{chapterRows.length > 1 && !protectedCopy}}" class="contents-count chapter-list-hint">按住右侧拖动排序 · 左滑删除</view>
      <view wx:for="{{chapterRows}}" wx:key="id" class="chapter-swipe-row {{swipeOpenChapterId === item.id ? 'chapter-swipe-open' : ''}} {{draggingChapterId === item.id ? 'chapter-row-dragging' : ''}}" data-id="{{item.id}}" bindtouchstart="startChapterSwipe" bindtouchmove="moveChapterSwipe" bindtouchend="endChapterSwipe" bindtouchcancel="endChapterSwipe">
        <button wx:if="{{chapterRows.length > 1 && !protectedCopy}}" class="chapter-delete-action" data-id="{{item.id}}" bindtap="deleteChapterFromContents">删除</button>
        <view class="chapter-row chapter-row-content" data-id="{{item.id}}" bindtap="openChapter">
          <text class="chapter-number">{{item.label}}</text>
          <view class="chapter-copy">
            <text class="chapter-name serif">{{item.title || '还没起名字'}}<text wx:if="{{item.hasReturn}}" class="chapter-return-mark" aria-label="有新的回信"> · 有回信</text></text>
            <text class="chapter-meta">{{item.memoryCount}} 段记忆 · {{item.photoCount}} 张图片</text>
          </view>
          <view wx:if="{{chapterRows.length > 1 && !protectedCopy}}" class="chapter-drag-handle" data-id="{{item.id}}" catchtouchstart="startChapterDrag" catchtouchmove="moveChapterDrag" catchtouchend="endChapterDrag" catchtouchcancel="endChapterDrag" aria-label="拖动调整章节顺序"><text>⠿</text></view>
          <text class="chapter-arrow" aria-hidden="true">›</text>
        </view>
      </view>
      <block wx:if="{{unassigned.length}}">
        <view class="contents-section serif">还没写进书的记忆<text class="contents-count">最近的在前</text></view>
        <view class="contents-memory" wx:for="{{unassigned}}" wx:key="id">
          <view class="bookmark-tab" aria-hidden="true"><image class="bookmark-tab-art" src="/assets/illustrations/memory-bookmark.png" mode="widthFix"></image></view>
          <view class="contents-memory-date">{{item.dateLabel}}</view>
          <view class="contents-memory-title serif">{{item.title}}</view>
          <view wx:if="{{item.aiLabel}}" class="chapter-ai-label">{{item.aiLabel}}</view>
          <view class="contents-memory-excerpt">{{item.excerpt}}</view>
          <view class="contents-memory-foot">
            <button class="contents-place" data-id="{{item.id}}" bindtap="chooseChapterFor" hover-class="contents-place-pressed">放进哪一章 ›</button>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>
  <!-- One chapter: keep both native inputs mounted; initialize values only on load/switch/save/discard. -->
  <view wx:for="{{editorKeys}}" wx:key="*this" class="writing-fields" hidden="{{openingChapter || !draft || panel || view !== 'chapter'}}">
    <view class="title-field">
      <view class="field-label">{{editTitle}} · {{chapterLabelText}}</view>
      <input class="manuscript-title serif" value="{{editChapterTitle}}" maxlength="40" bindinput="onEditChapterTitle" bindkeyboardheightchange="onKeyboardHeight" adjust-position="{{false}}" disabled="{{protectedCopy || saving || generating}}" placeholder="给这一章起个名字（可以不填）" />
    </view>
    <view class="body-field {{backdropUrl ? 'body-field-illustrated' : ''}}">
      <block wx:if="{{backdropUrl}}">
        <image class="chapter-backdrop" src="{{backdropUrl}}" mode="aspectFill" aria-label="AI 生成的本章底图" />
      </block>
      <view class="field-label">正文</view>
      <view wx:if="{{!protectedCopy}}" class="panel-note">文字可以直接修改；点图片可删除，换图请用顶部「图片」入口。修改后点保存。</view>
      <view wx:if="{{chapterAiLabelText}}" class="chapter-ai-label">{{chapterAiLabelText}}</view>
      <editor id="manuscript-editor" class="manuscript-body" bindready="onEditorReady" bindinput="onEditorInput" read-only="{{protectedCopy || saving || generating || !editorReady}}" placeholder="从这里开始写…" show-img-size="{{false}}" show-img-toolbar="{{!protectedCopy}}" show-img-resize="{{false}}"></editor>
      <button wx:if="{{!protectedCopy}}" class="xiaoyi-entry" catchtouchstart="openXiaoyi" disabled="{{saving || generating || pickingPhoto || !editorReady}}" aria-label="小忆">
        <image class="xiaoyi-entry-avatar" src="/assets/illustrations/xiaoyi-avatar.png" mode="aspectFill" aria-hidden="true" />
      </button>
    </view>
    <view class="return-letters" wx:if="{{chapterChanges.length}}">
      <view class="pending-title" bindtap="toggleChanges" role="button">家人改过这一章 <text>{{chapterChanges.length}} 次 · {{changesOpen ? '收起' : '看看改了哪里'}}</text></view>
      <block wx:if="{{changesOpen}}">
        <view class="pending-card" wx:for="{{chapterChanges}}" wx:key="revisionId" wx:for-item="change">
          <view class="pending-label">{{change.by}} · {{change.when}}</view>
          <view class="pending-text" wx:if="{{change.titleChange}}">{{change.titleChange}}</view>
          <view wx:for="{{change.blocks}}" wx:key="index" wx:for-item="block">
            <view class="pending-text change-before" wx:if="{{block.before}}">原来：{{block.before}}</view>
            <view class="pending-text serif" wx:if="{{block.after}}">现在：{{block.after}}</view>
            <view class="pending-text change-before" wx:else>这一段被删掉了</view>
          </view>
        </view>
      </block>
    </view>
    <view class="return-letters" wx:if="{{chapterReturns.length}}">
      <view class="pending-title">朋友的回信 <text>不采用也不会改动你的书</text></view>
      <view class="pending-card" wx:for="{{chapterReturns}}" wx:key="returnId">
        <view class="pending-label">{{item.senderName}} 回信</view>
        <view class="pending-text serif" selectable>{{item.text}}</view>
        <view class="pending-actions">
          <button class="pending-btn pending-accept" data-id="{{item.returnId}}" data-decision="accept" bindtap="decideChapterReturn" disabled="{{decidingReturn}}">采用</button>
          <button class="pending-btn" data-id="{{item.returnId}}" data-decision="reject" bindtap="decideChapterReturn" disabled="{{decidingReturn}}">不采用</button>
        </view>
      </view>
    </view>
    <view class="pending-edits" wx:if="{{chapterPendingEdits.length}}">
      <view class="pending-title">待确认修改 <text>{{chapterPendingCount ? '还有 ' + chapterPendingCount + ' 处' : '都已选择'}}</text></view>
      <view class="pending-card" wx:for="{{chapterPendingEdits}}" wx:key="id">
        <view class="pending-label">{{item.label}} · {{item.status === 'pending' ? '待选择' : item.status === 'accepted' ? '已收下' : '已不要'}}</view>
        <view class="pending-text" selectable>{{item.text}}</view>
        <view class="pending-actions" wx:if="{{item.status === 'pending'}}">
          <button class="pending-btn pending-accept" data-id="{{item.id}}" data-decision="accept" bindtap="decidePendingEdit">收下</button>
          <button class="pending-btn" data-id="{{item.id}}" data-decision="reject" bindtap="decidePendingEdit">不要</button>
        </view>
      </view>
      <button class="pending-finish" wx:if="{{!chapterPendingCount}}" bindtap="finishPendingEdits" disabled="{{saving}}">把已收下的写入正文</button>
    </view>
    <view wx:if="{{xiaoyiOpen}}" class="xiaoyi-panel">
      <view class="xiaoyi-head">
        <view>
          <view class="xiaoyi-title">小忆在这里</view>
          <view class="xiaoyi-context">正在看：{{xiaoyiContextPreview}}</view>
        </view>
        <button class="xiaoyi-close" bindtap="closeXiaoyi" disabled="{{xiaoyiLoading}}">关掉</button>
      </view>
      <view class="xiaoyi-options">
        <button class="xiaoyi-option" data-mode="ask" bindtap="askXiaoyiQuestion" disabled="{{xiaoyiLoading}}">问我一个问题</button>
        <button class="xiaoyi-option" data-mode="compose" bindtap="organizeXiaoyiAnswer" disabled="{{xiaoyiLoading}}">写成一段</button>
        <button class="xiaoyi-option" bindtap="openXiaoyiMemories" disabled="{{xiaoyiLoading}}">看看这一章的记忆</button>
      </view>
      <scroll-view class="xiaoyi-thread" scroll-y wx:if="{{xiaoyiMessages.length}}">
        <view class="xiaoyi-message xiaoyi-message-{{item.kind}}" wx:for="{{xiaoyiMessages}}" wx:key="id" selectable>
          <view class="xiaoyi-message-label" wx:if="{{item.label}}">{{item.label}}</view>
          <view>{{item.text}}</view>
        </view>
      </scroll-view>
      <textarea class="xiaoyi-answer" hold-keyboard="{{true}}" disabled="{{xiaoyiLoading}}" value="{{xiaoyiAnswer}}" maxlength="500" auto-height fixed="{{true}}" adjust-position="{{false}}" show-confirm-bar="{{false}}" placeholder="把刚想起来的事说给小忆听…" bindinput="onXiaoyiAnswerInput" bindkeyboardheightchange="onKeyboardHeight"></textarea>
      <view class="xiaoyi-message-label">这次怎么写（可不填）</view>
      <textarea class="xiaoyi-answer" hold-keyboard="{{true}}" disabled="{{xiaoyiLoading}}" value="{{xiaoyiWritingInstruction}}" maxlength="300" auto-height fixed="{{true}}" adjust-position="{{false}}" show-confirm-bar="{{false}}" placeholder="例如：像我平时说话，结尾停在那件小事上" bindinput="onXiaoyiWritingInstruction" bindkeyboardheightchange="onKeyboardHeight"></textarea>
      <generation-status wx:if="{{xiaoyiLoading}}" text="{{xiaoyiStatus || '小忆正在整理文字…'}}" />
      <view class="xiaoyi-status" wx:elif="{{xiaoyiStatus}}">{{xiaoyiStatus}}</view>
      <view class="xiaoyi-actions">
        <button class="xiaoyi-action" bindtap="useXiaoyiOriginal" disabled="{{xiaoyiLoading}}">就用我的原话</button>
        <button class="xiaoyi-action" bindtap="organizeXiaoyiAnswer" disabled="{{xiaoyiLoading}}">{{xiaoyiLoading ? '小忆正在处理…' : '整理原话'}}</button>
      </view>
      <view wx:if="{{xiaoyiDraftText}}" class="xiaoyi-draft-box">
        <view class="xiaoyi-message-label">小忆草稿，可以改</view>
        <textarea class="xiaoyi-draft" hold-keyboard="{{true}}" disabled="{{xiaoyiLoading}}" value="{{xiaoyiDraftText}}" maxlength="800" auto-height fixed="{{true}}" adjust-position="{{false}}" show-confirm-bar="{{false}}" bindinput="onXiaoyiDraftInput" bindkeyboardheightchange="onKeyboardHeight"></textarea>
        <button class="xiaoyi-action xiaoyi-action-primary" bindtap="useXiaoyiDraft" disabled="{{xiaoyiLoading}}">把这段放进正文待确认</button>
      </view>
    </view>
  </view>
  <scroll-view class="reading-panel" scroll-y wx:if="{{panel}}">
    <view class="panel-content">
      <block wx:if="{{panel === 'version'}}">
        <view class="panel-title serif">给这一版起个名字</view>
        <input class="version-name" value="{{versionName}}" maxlength="30" bindinput="onVersionName" placeholder="例如：补充了大学经历" />
        <view class="panel-note">不填也可以。旧版会一直保留。</view>
      </block>
      <block wx:if="{{panel === 'share-excerpt'}}">
        <view class="panel-title serif">把这段话发给家人</view>
        <view class="share-excerpt serif">{{shareText}}</view>
        <view class="field-label contents-label">选择家人</view>
        <checkbox-group bindchange="onShareRecipients">
          <label class="memory-row" wx:for="{{shareRecipients}}" wx:key="id">
            <checkbox value="{{item.id}}" checked="{{item.checked}}" disabled="{{sharingExcerpt}}" />
            <text class="memory-text">{{item.name}}</text>
            <text class="version-date">{{item.relation}}</text>
          </label>
        </checkbox-group>
        <view class="panel-note">只发送你选中的文字，不会开放整章。对方需要先接受你的微信邀请，之后可在记忆之家看到这段摘录。</view>
      </block>
      <block wx:if="{{panel === 'append-own'}}">
        <view class="panel-title serif">补充我的经历</view>
        <textarea class="version-name" value="{{appendOwnText}}" maxlength="20000" auto-height bindinput="onAppendOwnText" disabled="{{appendingOwn}}" placeholder="写下你对这段记忆的补充、不同视角或后来发生的事…" />
        <view class="panel-note">你的文字会追加在本章末尾。亲友分享的原文和图片不会被改写。</view>
      </block>
      <block wx:if="{{panel === 'history'}}">
        <view class="panel-title serif">历史版本</view>
        <button wx:if="{{!protectedCopy && draft && view === 'contents'}}" class="tool-button" data-action="version" bindtap="selectTool">为当前版本命名存档</button>
        <view wx:if="{{historyLoading}}" class="panel-note">正在加载历史版本…</view>
        <view wx:elif="{{!history.length}}" class="panel-note">保存修改后，这里会保留版本记录。</view>
        <button class="version-row" wx:for="{{history}}" wx:key="id" data-id="{{item.id}}" bindtap="previewHistory">
          <text>{{item.label}}</text><text class="version-date">{{item.savedAt}}</text>
        </button>
        <view wx:if="{{previewVersion}}">
          <view class="panel-title serif">{{previewVersion.draft.title}}</view>
          <view class="chapter-para serif" wx:for="{{previewBlocks}}" wx:key="index">
            <image wx:if="{{item.path}}" class="book-photo" src="{{item.path}}" mode="widthFix" />
            <text wx:else selectable>{{item.text}}</text>
          </view>
        </view>
      </block>
      <block wx:if="{{panel === 'organize'}}">
        <view class="panel-title serif">把记忆写进故事</view>
        <view class="panel-note">记忆各自保留。挑选、看看联系，再预览它们组成的故事。</view>
        <view class="field-label">写进哪个故事</view>
        <radio-group bindchange="onOrganizeBook"><label class="memory-row" wx:for="{{organizeBooks}}" wx:key="id"><radio value="{{item.id}}" checked="{{organizeBookKey === item.id}}" disabled="{{connectionSaving || generating || switchingBook}}" /><text class="memory-text">{{item.title}}</text><text class="version-date">{{item.detail}}</text></label></radio-group>
        <view class="panel-note">切换故事会保留你勾选的记忆。没有章节也可以新开一章。</view>
        <view class="field-label">1. 勾选要整理的记忆</view>
        <checkbox-group bindchange="onOrganizeMemories">
          <label class="memory-row" wx:for="{{organizeRows}}" wx:key="id">
            <checkbox value="{{item.id}}" checked="{{item.checked}}" disabled="{{connectionSaving || generating || switchingBook}}" />
            <text class="memory-text">{{item.text}}</text>
            <text class="version-date">{{item.where}}</text>
          </label>
        </checkbox-group>
        <view wx:if="{{!organizeRows.length}}" class="panel-note">还没有可整理的记忆，请先记录一段经历。</view>
        <view class="connection-panel" wx:if="{{organizeCount >= 2 || connectionReflection || connectionNotice}}">
          <view class="field-label">放在一起，你想到了什么？</view>
          <view class="panel-note">可以看一条线索，自己说说，也可以跳过。</view>
          <button wx:if="{{writingMode === 'creative'}}" class="btn btn-ghost" bindtap="exploreConnections" loading="{{connectionBusy}}" disabled="{{connectionBusy || connectionSaving || generating || switchingBook || organizeCount < 2 || organizeCount > 8}}">让小忆一起看看</button>
          <view wx:if="{{organizeCount > 8 && writingMode === 'creative'}}" class="panel-note">一次选 2—8 段来看联系；更多记忆仍可直接组合。</view>
          <block wx:if="{{connection}}">
            <view class="chapter-ai-label">小忆提供的线索 · 文字 AI 生成</view>
            <view class="panel-note" wx:if="{{connection.observation}}">{{connection.observation}}</view>
            <view class="connection-evidence" wx:for="{{connection.evidence}}" wx:key="memoryId">
              <view class="field-label">{{item.title}}</view><text selectable>“{{item.quote}}”</text>
            </view>
            <view class="field-label">{{connection.question}}</view>
            <button class="btn btn-ghost" bindtap="dismissConnection">我不觉得有关，先跳过</button>
          </block>
          <view class="panel-note">{{connectionNotice}}</view>
          <textarea class="xiaoyi-answer" value="{{connectionReflection}}" maxlength="500" auto-height placeholder="只写你自己想到的，不必接受小忆的说法" bindinput="onConnectionReflection" disabled="{{connectionSaving}}" />
          <button class="btn btn-ghost" bindtap="saveConnectionReflection" loading="{{connectionSaving}}" disabled="{{!connectionReflection || connectionSaving || generating || switchingBook}}">把我的想法存成一段记忆</button>
        </view>
        <view class="field-label contents-label">2. 放进哪一章</view>
        <radio-group bindchange="onOrganizeTarget">
          <label class="memory-row" wx:for="{{chapterRows}}" wx:key="id">
            <radio value="{{item.id}}" checked="{{organizeTarget === item.id}}" disabled="{{connectionSaving || generating || switchingBook}}" />
            <text class="memory-text">{{item.label}}{{item.title ? '　' + item.title : ''}}</text>
          </label>
          <label class="memory-row">
            <radio value="new" checked="{{organizeTarget === 'new'}}" disabled="{{connectionSaving || generating || switchingBook}}" />
            <text class="memory-text">新开一章</text>
          </label>
        </radio-group>
        <block wx:if="{{organizeTarget !== 'new'}}">
          <view class="field-label contents-label">章节原文</view>
          <scroll-view class="chapter-original" scroll-y><text selectable>{{organizeOriginal || '这一章还没有正文'}}</text></scroll-view>
          <view class="field-label contents-label">3. 怎样放进去</view>
          <radio-group bindchange="onOrganizeMethod">
            <label class="memory-row"><radio value="insert" checked="{{organizeMethod === 'insert'}}" disabled="{{connectionSaving || generating || switchingBook}}" /><text>保留原文，插入这段记忆</text></label>
            <label wx:if="{{writingMode === 'creative'}}" class="memory-row"><radio value="blend" checked="{{organizeMethod === 'blend'}}" disabled="{{connectionSaving || generating || switchingBook}}" /><text>让 AI 结合本章重新衔接</text></label>
          </radio-group>
          <picker wx:if="{{organizeMethod === 'insert'}}" range="{{insertionPoints}}" range-key="label" value="{{insertionIndex}}" bindchange="onInsertionPoint" disabled="{{connectionSaving || generating || switchingBook}}">
            <view class="insertion-picker">插入位置：{{insertionPoints[insertionIndex].label}}　⌄</view>
          </picker>
          <view wx:else class="panel-note">AI 会读取整章原文与所选记忆，生成新的章节正文。请在下一步检查事实、语气和照片位置。</view>
        </block>
        <block wx:if="{{writingMode === 'creative' && (organizeTarget === 'new' || organizeMethod === 'blend')}}">
          <view class="field-label contents-label">这一章怎么写（可不填）</view>
          <textarea class="xiaoyi-answer" value="{{organizeWritingInstruction}}" maxlength="300" auto-height placeholder="例如：保留原来的开头，写得更口语，不用总结道理" bindinput="onOrganizeWritingInstruction" disabled="{{generating || saving || switchingBook}}" />
        </block>
        <view class="panel-note">下一步会将所选记忆收进故事并生成预览；确认后才写入正文，旧版本和原始记忆保留。</view>
      </block>
      <block wx:if="{{panel === 'organize-preview'}}">
        <view class="panel-title serif">确认这一章的正文</view>
        <view class="panel-note">{{previewInsertion ? '可以修改新增文字，下面会显示插入后的全文。' : '可以修改标题和文字。'}}确认写入前，已保存的书稿不会改变。</view>
        <view wx:if="{{previewAiLabel}}" class="chapter-ai-label">{{previewAiLabel}}</view>
        <input class="version-name" value="{{previewTitle}}" bindinput="onPreviewTitle" maxlength="40" disabled="{{saving || confirmingOrganize}}" placeholder="章节标题" />
        <block wx:if="{{previewInsertion}}">
          <view class="field-label">本次插入的文字 · 可修改</view>
          <textarea class="preview-editor" value="{{insertionText}}" bindinput="onInsertionText" maxlength="20000" auto-height disabled="{{saving || confirmingOrganize}}" />
          <view class="field-label contents-label">插入后的完整章节</view>
          <view class="insertion-preview"><text selectable>{{previewText}}</text></view>
        </block>
        <textarea wx:else class="preview-editor" value="{{previewText}}" bindinput="onPreviewText" maxlength="20000" auto-height disabled="{{saving || confirmingOrganize}}" />
      </block>
      <view wx:if="{{panel === 'organize-preview' && memoryPreviewPhotos.length}}" class="memory-preview-photos">
        <view class="field-label">随记忆一起带入的配图 · {{memoryPreviewPhotos.length}} 张</view>
        <view class="panel-note">写入后可以修改文字、移除图片；需要换图时，使用顶部「图片」入口。原始记忆保留。</view>
        <view wx:for="{{memoryPreviewPhotos}}" wx:key="id" class="memory-preview-photo">
          <image wx:if="{{item.path}}" class="book-photo" src="{{item.path}}" mode="widthFix" />
          <view wx:else class="panel-note">图片暂未加载，写入时会保留原图引用。</view>
          <view wx:if="{{item.ai}}" class="chapter-ai-label">AI 生成图片</view>
        </view>
      </view>
      <block wx:if="{{panel === 'sources'}}">
        <view class="panel-title serif">原始记忆 · {{sourceCount}}</view>
        <view class="panel-note">{{storageLabel}}</view>
        <view class="panel-note" wx:if="{{stale}}">素材已有变化，当前正文仍然保留。</view>
        <view class="chapter-para source-item serif" wx:for="{{sources}}" wx:key="id"><text selectable>{{item.text}}</text></view>
      </block>
      <block wx:if="{{panel === 'new-chapter'}}">
        <view class="panel-title serif">新开一章</view>
        <button class="version-row" data-story="" bindtap="createChapter" disabled="{{saving}}">
          <text>空白的一章</text><text class="version-date">自己写，或之后把记忆放进来</text>
        </button>
        <button class="version-row" wx:for="{{storyOptions}}" wx:key="title" data-story="{{item.title}}" bindtap="createChapter" disabled="{{saving}}">
          <text>用故事「{{item.title}}」开一章</text><text class="version-date">这个故事的 {{item.count}} 条记忆原文会加入正文</text>
        </button>
      </block>
      <block wx:if="{{panel === 'assign'}}">
        <view class="panel-title serif">放进哪一章？</view>
        <button class="version-row" wx:for="{{chapterRows}}" wx:key="id" data-id="{{item.id}}" bindtap="assignTo" disabled="{{saving}}">
          <text>{{item.label}}{{item.title ? '　' + item.title : ''}}</text>
        </button>
        <button class="version-row" data-id="new" bindtap="assignTo" disabled="{{saving}}"><text>新开一章放它</text></button>
        <view class="panel-note">放进章节后，记忆原文会加入该章正文；原始记忆仍会保留。</view>
      </block>
      <block wx:if="{{panel === 'memories'}}">
        <view class="panel-title serif">{{chapterLabelText}}用到的记忆</view>
        <view wx:if="{{!chapterMemories.length}}" class="panel-note">这一章还没有放进记忆。</view>
        <view class="memory-row" wx:for="{{chapterMemories}}" wx:key="id">
          <view class="memory-row-body">
            <text class="memory-text">{{item.text}}</text>
            <view wx:if="{{item.aiLabel}}" class="chapter-ai-label">{{item.aiLabel}}</view>
          </view>
          <button class="tool-button" data-id="{{item.id}}" bindtap="removeFromChapter" disabled="{{saving}}"><view class="action-icon icon-remove" aria-hidden="true"></view>移出</button>
        </view>
        <block wx:if="{{unassigned.length}}">
          <view class="field-label contents-label">还没放进书稿的记忆</view>
          <view class="memory-row" wx:for="{{unassigned}}" wx:key="id">
            <view class="memory-row-body">
              <text class="memory-text">{{item.text}}</text>
              <view wx:if="{{item.aiLabel}}" class="chapter-ai-label">{{item.aiLabel}}</view>
            </view>
            <button class="tool-button" data-id="{{item.id}}" bindtap="addToChapter" disabled="{{saving}}"><view class="action-icon icon-insert" aria-hidden="true"></view>放进本章</button>
          </view>
        </block>
        <view class="panel-note">放进本章会把记忆原文加入正文；移出只解除归档，不会删除已经编辑的正文或原始记忆。</view>
      </block>
    </view>
  </scroll-view>
  <view class="empty-state" wx:if="{{!draft && !loading && !loadError && !panel}}">
    <view class="panel-title serif">{{sourceCount ? '把记忆写成一本书' : '从一段记忆开始'}}</view>
    <view class="panel-note">{{sourceCount ? '新开第一章，把记忆放进去；也可以点「更多」请 AI 整理。' : '点右上角「更多」，开始记录经历。'}}</view>
    <button wx:if="{{sourceCount}}" class="tool-button save-button add-chapter" data-action="new-chapter" bindtap="selectTool"><view class="action-icon icon-new" aria-hidden="true"></view>新开第一章</button>
  </view>
  <view class="organize-footer" wx:if="{{panel === 'organize' || panel === 'organize-preview'}}">
    <view class="organize-summary">{{panel === 'organize' ? ('已选 ' + organizeCount + ' 段记忆 · ' + organizeBookTitle) : '先看看文字，满意后再写入'}}</view>
    <view class="organize-footer-actions">
      <button class="tool-button" bindtap="closePanel" disabled="{{saving || confirmingOrganize || generating || switchingBook}}">暂不整理</button>
      <button wx:if="{{panel === 'organize'}}" class="tool-button workflow-next" bindtap="runOrganize" disabled="{{saving || confirmingOrganize || generating || switchingBook || !organizeCount}}">{{switchingBook ? '正在切换…' : generating ? '正在整理…' : '下一步：预览正文'}}</button>
      <button wx:else class="tool-button workflow-next" bindtap="confirmOrganize" disabled="{{saving || confirmingOrganize || generating}}">{{(saving || confirmingOrganize) ? '正在写入…' : '确认写入正文'}}</button>
    </view>
  </view>
</view>
