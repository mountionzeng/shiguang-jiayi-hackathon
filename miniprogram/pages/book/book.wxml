<view class="writing-page {{keyboardHeight ? 'keyboard-open' : ''}}" style="height: {{viewportHeight ? viewportHeight + 'px' : '100%'}};">
  <view class="writing-toolbar">
    <button class="tool-button" bindtap="goHome" disabled="{{saving || generating || pickingPhoto}}">返回</button>
    <button class="tool-button" bindtap="addPhoto" disabled="{{!draft || panel || saving || generating || pickingPhoto || !editorReady}}">{{pickingPhoto ? '添加中' : '照片'}}</button>
    <button class="tool-button save-button" bindtap="saveEdits" disabled="{{!draft || !editing || saving || generating || panel || pickingPhoto || !editorReady}}">{{saving ? '保存中' : '保存'}}</button>
    <button class="tool-button" bindtap="showMore" disabled="{{saving || generating || pickingPhoto}}">更多</button>
  </view>
  <view class="top-tools" wx:if="{{moreOpen}}">
    <button wx:if="{{editing}}" class="tool-button" data-action="discard" bindtap="selectTool">放弃修改</button>
    <block wx:else>
      <button wx:if="{{draft}}" class="tool-button" data-action="history" bindtap="selectTool">历史版本</button>
      <button wx:if="{{draft}}" class="tool-button" data-action="version" bindtap="selectTool">命名存档</button>
      <button class="tool-button" data-action="generate" bindtap="selectTool">AI 整理</button>
      <button class="tool-button" data-action="sources" bindtap="selectTool">原始记忆</button>
      <button wx:if="{{!draft}}" class="tool-button" data-action="record" bindtap="selectTool">记录经历</button>
    </block>
  </view>
  <view class="notice" wx:if="{{saveNotice || loadError}}">{{saveNotice || loadError}}</view>
  <view class="panel-actions" wx:if="{{loadError}}"><button class="tool-button" bindtap="retryLoad">重新加载</button></view>
  <view class="panel-actions" wx:if="{{panel}}">
    <button class="tool-button" bindtap="closePanel" disabled="{{saving}}">回到正文</button>
    <block wx:if="{{panel === 'candidate'}}">
      <button class="tool-button" bindtap="discardCandidate" disabled="{{saving}}">不采用</button>
      <button class="tool-button save-button" bindtap="adoptCandidate" disabled="{{saving}}">采用</button>
    </block>
    <button wx:if="{{panel === 'history' && previewVersion}}" class="tool-button save-button" bindtap="restoreVersion" disabled="{{saving}}">恢复此版</button>
    <button wx:if="{{panel === 'version'}}" class="tool-button save-button" bindtap="saveVersion" disabled="{{saving}}">存为版本</button>
  </view>
  <!-- Keep both native inputs mounted; initialize values only on load/save/discard. -->
  <view wx:for="{{editorKeys}}" wx:key="*this" class="writing-fields" hidden="{{!draft || panel}}">
    <view class="title-field">
      <view class="field-label">书稿标题</view>
      <input class="manuscript-title serif" value="{{editTitle}}" maxlength="80" bindinput="onEditTitle" bindkeyboardheightchange="onKeyboardHeight" adjust-position="{{false}}" disabled="{{saving || generating}}" placeholder="写一个标题" />
    </view>
    <view class="body-field">
      <view class="field-label">正文</view>
      <editor id="manuscript-editor" class="manuscript-body" bindready="onEditorReady" bindinput="onEditorInput" read-only="{{saving || generating || !editorReady}}" placeholder="从这里开始写…" show-img-size="{{false}}" show-img-toolbar="{{false}}" show-img-resize="{{false}}"></editor>
    </view>
  </view>
  <scroll-view class="reading-panel" scroll-y wx:if="{{panel}}">
    <view class="panel-content">
      <block wx:if="{{panel === 'version'}}">
        <view class="panel-title serif">给这一版起个名字</view>
        <input class="version-name" value="{{versionName}}" maxlength="30" bindinput="onVersionName" placeholder="例如：补充了大学经历" />
        <view class="panel-note">不填也可以。旧版会一直保留。</view>
      </block>
      <block wx:if="{{panel === 'history'}}">
        <view class="panel-title serif">历史版本</view>
        <view wx:if="{{!history.length}}" class="panel-note">保存修改后，这里会保留版本记录。</view>
        <button class="version-row" wx:for="{{history}}" wx:key="id" data-id="{{item.id}}" bindtap="previewHistory">
          <text>{{item.label}}</text><text class="version-date">{{item.savedAt}}</text>
        </button>
        <view wx:if="{{previewVersion}}">
          <view class="panel-title serif">{{previewVersion.draft.title}}</view>
          <view class="chapter-para serif" wx:for="{{previewBlocks}}" wx:key="index">
            <image wx:if="{{item.path}}" class="book-photo" src="{{item.path}}" mode="widthFix" />
            <text wx:else selectable>{{item.text}}</text>
          </view>
        </view>
      </block>
      <block wx:if="{{panel === 'candidate' && candidate}}">
        <view class="panel-note">候选稿 · 采用后才会替换正文，旧版仍保留</view>
        <view class="panel-title serif">{{candidate.title}}</view>
        <view class="chapter-para serif" wx:for="{{candidate.paragraphs}}" wx:key="index"><text selectable>{{item}}</text></view>
      </block>
      <block wx:if="{{panel === 'sources'}}">
        <view class="panel-title serif">原始记忆 · {{sourceCount}}</view>
        <view class="panel-note">{{storageLabel}}</view>
        <view class="panel-note" wx:if="{{stale}}">素材已有变化，当前正文仍然保留。</view>
        <view class="chapter-para source-item serif" wx:for="{{sources}}" wx:key="id"><text selectable>{{item.text}}</text></view>
      </block>
    </view>
  </scroll-view>
  <view class="empty-state" wx:if="{{!draft && !loadError && !panel}}">
    <view class="panel-title serif">{{sourceCount ? '把记忆写成一篇故事' : '从一段记忆开始'}}</view>
    <view class="panel-note">{{sourceCount ? '点右上角「更多」，请 AI 整理。' : '点右上角「更多」，开始记录经历。'}}</view>
  </view>
</view>
