<view class="shell page-enter">

  <!-- 没有合格来源：解释缺什么，不生成虚构内容 -->
  <block wx:if="{{sourceCount === 0}}">
    <view class="no-source wash">
      <view class="no-source-title serif">还写不了</view>
      <view class="no-source-note">
        人生之书只能用 {{protagonistName}} 亲自讲述的经历写成。家人的共同记忆不会混进来；现在还没有个人片段，所以这里不会编一段占位。
      </view>
      <button class="btn btn-ghost no-source-btn" bindtap="goBack">回去先讲一段</button>
    </view>
  </block>

  <block wx:else>
    <!-- 章节 -->
    <view class="chapter" wx:if="{{draft}}">
      <view class="chapter-top">
        <text class="tag tag-apricot"><text class="tag-mark">我</text>我的书稿</text>
        <text class="chapter-sources" bindtap="toggleSources">{{draft.sourceCount}} 段亲历</text>
      </view>

      <view class="chapter-title serif">{{draft.title}}</view>
      <view class="chapter-rule"></view>

      <view class="chapter-para serif" wx:for="{{draft.paragraphs}}" wx:key="*this">{{item}}</view>

      <view class="chapter-mode">
        <text class="tag {{isCloudDraft ? 'tag-lake' : 'tag-muted'}}">
          <text class="tag-mark">{{isCloudDraft ? '云' : '本'}}</text>{{modeLabel}}
        </text>
        <view class="chapter-mode-note">{{modeNote}}</view>
      </view>
    </view>

    <!-- 来源变化，正文已经不作数 -->
    <view class="stale-note" wx:if="{{stale}}">
      这一章写成时用了 {{draft.sourceCount}} 条来源，现在的合格来源是 {{sourceCount}} 条。请重新整理，别照着旧版往下读。
    </view>

    <!-- 还没整理过 -->
    <view class="not-yet" wx:if="{{!draft}}">
      <view class="not-yet-title serif">已经写下 {{sourceCount}} 段自己的经历</view>
      <view class="not-yet-note">把它们整理成一章，读起来才像一本书。记忆之家的家庭故事不会被带进来。</view>
    </view>

    <button
      class="btn btn-primary gen-btn"
      loading="{{generating}}"
      disabled="{{generating}}"
      bindtap="generateChapter"
    >{{generating ? '正在整理…' : (draft ? '重新整理这一章' : '整理成一章')}}</button>

    <!-- 来源展开 -->
    <view class="sources">
      <view class="sources-head" bindtap="toggleSources">
        <text class="sources-title">这一章依据的 {{sourceCount}} 段个人讲述</text>
        <text class="sources-toggle">{{showSources ? '收起' : '展开'}}</text>
      </view>

      <block wx:if="{{showSources}}">
        <view class="source-item" wx:for="{{sources}}" wx:key="id">
          <view class="source-text serif">{{item.text}}</view>
          <view class="source-foot">
            <text class="tag tag-jade"><text class="tag-mark">我</text>亲自讲述</text>
            <text class="source-by">{{item.byline}}</text>
          </view>
        </view>
      </block>
    </view>

    <button class="btn btn-quiet" bindtap="goBack">回去</button>
  </block>
</view>
