/* 章节阅读：正文优先，来源可追溯 */

/* ---- 无合格来源 ---- */

.no-source {
  margin-top: 40rpx;
  padding: 52rpx 36rpx;
  border-radius: 30rpx;
  border: 2rpx solid var(--line);
}

.no-source-title {
  position: relative;
  z-index: 1;
  font-size: 44rpx;
  font-weight: 600;
  color: var(--ink);
}

.no-source-note {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--ink-soft);
}

.no-source-btn {
  position: relative;
  z-index: 1;
  margin-top: 40rpx;
}

/* ---- 章节 ---- */

.chapter {
  padding: 36rpx 32rpx 32rpx;
  border-radius: 30rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--line);
}

.chapter-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.chapter-sources {
  font-size: 26rpx;
  color: var(--lake);
}

.chapter-title {
  margin-top: 26rpx;
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--ink);
}

.chapter-rule {
  width: 88rpx;
  height: 4rpx;
  margin: 24rpx 0 8rpx;
  background: var(--apricot);
}

/* 长文阅读：宣纸底、深墨绿字，背后不铺任何彩色肌理 */
.chapter-para {
  margin-top: 26rpx;
  font-size: 34rpx;
  line-height: 2;
  color: var(--ink);
}

.chapter-mode {
  margin-top: 40rpx;
  padding-top: 26rpx;
  border-top: 2rpx solid var(--line);
}

.chapter-mode-note {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink-soft);
}

.stale-note {
  margin-top: 24rpx;
  padding: 24rpx 26rpx;
  border-radius: 22rpx;
  background: var(--coral-soft);
  border: 2rpx solid rgba(199, 69, 46, 0.28);
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--coral);
}

/* ---- 还没整理 ---- */

.not-yet {
  padding: 40rpx 32rpx;
  border-radius: 30rpx;
  background: var(--paper-sunk);
}

.not-yet-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--ink);
}

.not-yet-note {
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.75;
  color: var(--ink-soft);
}

.gen-btn {
  margin-top: 32rpx;
}

/* ---- 来源 ---- */

.sources {
  margin-top: 44rpx;
}

.sources-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 0 4rpx;
  border-bottom: 2rpx solid var(--line);
}

.sources-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.sources-toggle {
  font-size: 27rpx;
  color: var(--lake);
}

.source-item {
  margin-top: 20rpx;
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--line);
}

.source-text {
  font-size: 31rpx;
  line-height: 1.75;
  color: var(--ink);
}

.source-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.source-by {
  font-size: 24rpx;
  color: var(--ink-faint);
}
