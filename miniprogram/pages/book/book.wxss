@import "./action-icons.wxss";
/* Fixed tools, two native fields, scrolling within the body. */
page { height: 100%; overflow: hidden; }
.writing-page { display: flex; flex-direction: column; overflow: hidden; background: var(--paper); }
.writing-toolbar { flex: none; display: flex; align-items: center; width: 100%; height: 96rpx; padding: 0 16rpx; border-bottom: 1rpx solid var(--line); overflow: hidden; }
/* Override WeChat v2 button default width and margins explicitly, not just min-width. */
.writing-page .tool-button { flex: none; width: auto; max-width: 100%; min-width: 88rpx; height: 88rpx; min-height: 88rpx; margin: 0; padding: 0 12rpx; display: flex; align-items: center; justify-content: center; white-space: nowrap; font-size: 29rpx; color: var(--jade); border-radius: 12rpx; }
.writing-toolbar > .tool-button { width: 25%; flex: 0 0 25%; min-width: 0; }
.writing-page .tool-button[disabled] { color: var(--ink-soft); opacity: .55; background: transparent; }
.save-button { font-weight: 600; }
.top-tools { flex: none; display: flex; flex-wrap: wrap; padding: 0 20rpx; background: var(--paper-sunk); border-bottom: 1rpx solid var(--line); }
.writing-fields { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 20rpx; padding: 24rpx 28rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.writing-fields[hidden] { display: none; }
.keyboard-open .writing-fields { padding-top: 12rpx; padding-bottom: 12rpx; gap: 12rpx; }
.title-field, .body-field { padding: 20rpx 24rpx; background: var(--paper-card); border: 1rpx solid var(--line); border-radius: 16rpx; }
.title-field { flex: none; }
.body-field { flex: 1; min-height: 0; display: flex; flex-direction: column; }
.field-label { flex: none; font-size: 24rpx; line-height: 1.4; color: var(--ink-soft); margin-bottom: 12rpx; }
.manuscript-title { width: 100%; height: 62rpx; font-size: 36rpx; font-weight: 600; color: var(--ink); }
.body-field .manuscript-body { width: 100%; height: 0; flex: 1; min-height: 0; font-size: 34rpx; line-height: 1.85; color: var(--ink); overflow-y: auto; }
.book-photo { width: 100%; }
.notice { flex: none; max-height: 100rpx; overflow-y: auto; padding: 12rpx 32rpx; font-size: 26rpx; color: var(--ink); background: var(--apricot-soft); }
.panel-actions { flex: none; display: flex; justify-content: space-between; padding: 0 20rpx; border-bottom: 1rpx solid var(--line); }
.reading-panel { flex: 1; height: 0; min-height: 0; }
.panel-content { padding: 28rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); }
.panel-title { margin: 12rpx 0 24rpx; font-size: 38rpx; line-height: 1.5; }
.panel-note { font-size: 27rpx; color: var(--ink-soft); line-height: 1.8; }
.chapter-para { margin-top: 28rpx; font-size: 34rpx; line-height: 1.85; }
.version-name { width: 100%; height: 100rpx; padding: 18rpx; margin-bottom: 20rpx; border: 1rpx solid var(--line); border-radius: 12rpx; background: var(--paper-card); font-size: 30rpx; }
.version-row { width: 100%; text-align: left; padding: 24rpx 12rpx; border-bottom: 1rpx solid var(--line); font-size: 30rpx; color: var(--jade); }
.version-date { display: block; color: var(--ink-soft); font-size: 23rpx; }
.source-item { padding-bottom: 24rpx; border-bottom: 1rpx solid var(--line); }
.empty-state { padding: 52rpx 32rpx; }
/* Contents: book title, chapter list and memories not yet placed in any chapter. */
.contents-view[hidden] { display: none; }
.contents-label { margin-top: 32rpx; }
.chapter-row { width: 100%; text-align: left; padding: 24rpx 12rpx; border-bottom: 1rpx solid var(--line); background: transparent; }
.chapter-name { display: block; font-size: 33rpx; line-height: 1.5; color: var(--ink); }
.writing-page .add-chapter { margin-top: 20rpx; }
.memory-row { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 0; border-bottom: 1rpx solid var(--line); }
.memory-text { flex: 1; min-width: 0; font-size: 28rpx; line-height: 1.6; color: var(--ink); }

.writing-page .panel-actions { flex-wrap: wrap; }
@media (max-width: 340px) { .writing-toolbar .tool-button { font-size: 27rpx; padding: 0 4rpx; } .writing-toolbar .action-icon { width: 34rpx; height: 34rpx; margin-right: 6rpx; } }

/* 本章底图：压在正文区下方、上缘渐隐到纸色；键盘打开时隐藏，保证正文可读。 */
.body-field { position: relative; overflow: hidden; }
.chapter-backdrop { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 42%; opacity: .9; pointer-events: none; -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 45%); mask-image: linear-gradient(to bottom, transparent 0%, #000 45%); }
.body-field .field-label, .body-field .manuscript-body { position: relative; z-index: 1; }
.keyboard-open .chapter-backdrop { display: none; }
