@import "./action-icons.wxss";
/* Fixed tools, two native fields, scrolling within the body. */
page { height: 100%; overflow: hidden; }
.writing-page { display: flex; flex-direction: column; overflow: hidden; background: var(--paper); }
.writing-toolbar { flex: none; display: flex; align-items: center; width: 100%; height: 96rpx; padding: 0 16rpx; border-bottom: 1rpx solid var(--line); overflow: hidden; }
/* Override WeChat v2 button default width and margins explicitly, not just min-width. */
.writing-page .tool-button { flex: none; width: auto; max-width: 100%; min-width: 88rpx; height: 88rpx; min-height: 88rpx; margin: 0; padding: 0 12rpx; display: flex; align-items: center; justify-content: center; white-space: nowrap; font-size: 29rpx; color: var(--jade); border-radius: 12rpx; }
.writing-toolbar > .tool-button { width: 20%; flex: 0 0 20%; min-width: 0; }
.writing-page .tool-button[disabled] { color: var(--ink-soft); opacity: .55; background: transparent; }
.save-button { font-weight: 600; }
.top-tools { flex: none; display: flex; flex-wrap: wrap; padding: 0 20rpx; background: var(--paper-sunk); border-bottom: 1rpx solid var(--line); }
.writing-fields { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 20rpx; padding: 24rpx 28rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.writing-fields[hidden] { display: none; }
.keyboard-open .writing-fields { padding-top: 12rpx; padding-bottom: 12rpx; gap: 12rpx; }
.title-field, .body-field { padding: 20rpx 24rpx; background: var(--paper-card); border: 1rpx solid var(--line); border-radius: 16rpx; }
.title-field { flex: none; }
.body-field { flex: 1; min-height: 0; display: flex; flex-direction: column; }
.field-label { flex: none; font-size: 24rpx; line-height: 1.4; color: var(--ink-soft); margin-bottom: 12rpx; }
.manuscript-title { width: 100%; height: 62rpx; font-size: 36rpx; font-weight: 600; color: var(--ink); }
.body-field .manuscript-body { width: 100%; height: 0; flex: 1; min-height: 0; font-size: 34rpx; line-height: 1.85; color: var(--ink); overflow-y: auto; }
.book-photo { width: 100%; }
.notice { flex: none; max-height: 100rpx; overflow-y: auto; padding: 12rpx 32rpx; font-size: 26rpx; color: var(--ink); background: var(--apricot-soft); }
.panel-actions { flex: none; display: flex; justify-content: space-between; padding: 0 20rpx; border-bottom: 1rpx solid var(--line); }
.reading-panel { flex: 1; height: 0; min-height: 0; }
.panel-content { padding: 28rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); }
.panel-title { margin: 12rpx 0 24rpx; font-size: 38rpx; line-height: 1.5; }
.panel-note { font-size: 27rpx; color: var(--ink-soft); line-height: 1.8; }
.chapter-para { margin-top: 28rpx; font-size: 34rpx; line-height: 1.85; }
.version-name { width: 100%; height: 100rpx; padding: 18rpx; margin-bottom: 20rpx; border: 1rpx solid var(--line); border-radius: 12rpx; background: var(--paper-card); font-size: 30rpx; }
.version-row { width: 100%; text-align: left; padding: 24rpx 12rpx; border-bottom: 1rpx solid var(--line); font-size: 30rpx; color: var(--jade); }
.version-date { display: block; color: var(--ink-soft); font-size: 23rpx; }
.source-item { padding-bottom: 24rpx; border-bottom: 1rpx solid var(--line); }
.empty-state { padding: 52rpx 32rpx; }
/* Contents: book title, chapter list and memories not yet placed in any chapter. */
.contents-view[hidden] { display: none; }
.contents-label { margin-top: 32rpx; }
.writing-page .add-chapter { margin-top: 20rpx; }
.memory-row { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 0; border-bottom: 1rpx solid var(--line); }
.memory-row-body { flex: 1; min-width: 0; }
.memory-text { flex: 1; min-width: 0; font-size: 28rpx; line-height: 1.6; color: var(--ink); }

.writing-page .panel-actions { flex-wrap: wrap; }
@media (max-width: 340px) { .writing-toolbar .tool-button { font-size: 27rpx; padding: 0 4rpx; } .writing-toolbar .action-icon { width: 34rpx; height: 34rpx; margin-right: 6rpx; } }

.preview-editor { width: 100%; min-height: 360rpx; margin-top: 28rpx; line-height: 1.9; padding-bottom: 80rpx; }
.share-excerpt { margin: 8rpx 0 28rpx; padding: 24rpx; border-left: 6rpx solid var(--jade); border-radius: 8rpx; background: var(--paper-card); font-size: 31rpx; line-height: 1.8; color: var(--ink); }

/* 本章底图：压在正文区下方、上缘渐隐到纸色；键盘打开时隐藏，保证正文可读。 */
.body-field { position: relative; overflow: hidden; }
.chapter-backdrop { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 42%; opacity: .9; pointer-events: none; -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 45%); mask-image: linear-gradient(to bottom, transparent 0%, #000 45%); }
.body-field .field-label, .body-field .manuscript-body { position: relative; z-index: 1; }
.chapter-ai-label { align-self: flex-start; position: relative; z-index: 1; margin: 0 0 12rpx; padding: 4rpx 12rpx; border-radius: 999rpx; background: rgba(128, 83, 38, .1); color: #805326; font-size: 22rpx; line-height: 1.5; }
.keyboard-open .chapter-backdrop { display: none; }

/* ---- 目录页：书名、目录、还没写进书的记忆 ---- */
/* 微信按钮默认宽 184px 且优先级高于单个类名，所以按钮一律用两层类名写宽度。 */
.contents-content { padding-top: 32rpx; }
.contents-head { display: flex; align-items: center; gap: 24rpx; }
.contents-cover { flex: none; width: 132rpx; height: 205rpx; filter: drop-shadow(4rpx 8rpx 10rpx rgba(42, 46, 43, .14)); }
.contents-title-field { flex: 1; min-width: 0; }
.contents-summary { margin-top: 6rpx; font-size: 24rpx; line-height: 1.5; color: var(--ink-soft); }
.contents-section { display: flex; align-items: baseline; justify-content: space-between; margin: 44rpx 0 8rpx; padding-bottom: 12rpx; border-bottom: 2rpx solid rgba(79, 127, 107, .32); font-size: 34rpx; font-weight: 600; color: var(--ink); }
.contents-count { font-family: "PingFang SC", "Heiti SC", sans-serif; font-size: 24rpx; font-weight: 400; color: var(--ink-soft); }
.contents-view .chapter-row { display: flex; align-items: center; width: 100%; min-height: 124rpx; margin: 0; padding: 20rpx 8rpx; border-bottom: 1rpx solid var(--line); border-radius: 0; background: transparent; text-align: left; line-height: 1.4; }
.contents-view .chapter-row::after { border: 0; }
.chapter-number { flex: none; width: 124rpx; font-size: 26rpx; letter-spacing: 2rpx; color: var(--jade); }
.chapter-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; }
.chapter-name { font-size: 34rpx; line-height: 1.45; color: var(--ink); }
.chapter-meta { margin-top: 4rpx; font-size: 24rpx; color: var(--ink-soft); }
.chapter-arrow { flex: none; margin-left: 12rpx; font-family: serif; font-size: 44rpx; line-height: 1; color: var(--ink-soft); }
.writing-page .contents-add { width: 100%; margin-top: 24rpx; border: 2rpx dashed rgba(79, 127, 107, .4); border-radius: 16rpx; background: rgba(234, 241, 237, .5); }
.contents-memory { position: relative; min-height: 190rpx; margin-top: 20rpx; padding: 24rpx 28rpx 20rpx 96rpx; border: 2rpx solid rgba(129, 117, 93, .1); border-radius: 8rpx 22rpx 16rpx 10rpx; background: var(--paper-card); box-shadow: 6rpx 10rpx 24rpx rgba(63, 66, 60, .05); }
.contents-memory-date { font-size: 22rpx; color: var(--ink-soft); }
.contents-memory-title { margin-top: 4rpx; font-size: 32rpx; font-weight: 600; line-height: 1.45; color: var(--ink); }
.contents-memory-excerpt { display: -webkit-box; margin-top: 6rpx; overflow: hidden; font-size: 27rpx; line-height: 1.65; color: var(--ink-soft); -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.contents-memory-foot { display: flex; justify-content: flex-end; margin-top: 12rpx; }
.contents-memory-foot .contents-place { width: auto; min-height: 72rpx; margin: 0; padding: 0 28rpx; border-radius: 999rpx; background: var(--jade-soft); color: var(--jade); font-size: 27rpx; font-weight: 600; line-height: 72rpx; }
.contents-memory-foot .contents-place::after { border: 0; }
.contents-place-pressed { opacity: .7; }

/* 微信按钮默认 width:184px 的选择器带属性，优先级高于单个类名；这里用双写类名把按钮宽度和左右外边距压回设计值。 */
.version-row.version-row { width: 100%; }

.organize-footer { flex: none; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); background: var(--paper-card); border-top: 1rpx solid var(--line); }
.organize-summary { margin: 0 8rpx 10rpx; color: var(--ink-soft); font-size: 24rpx; line-height: 1.5; }
.organize-footer-actions { display: flex; gap: 16rpx; align-items: center; }
.organize-footer-actions .tool-button { width: auto; margin: 0; }
.organize-footer-actions .workflow-next { flex: 1; min-height: 88rpx; justify-content: center; border-radius: 14rpx; color: var(--paper-card); background: var(--jade); font-weight: 600; }

.chapter-original { height: 360rpx; background: #f5f1e9; border-radius: 16rpx; padding: 24rpx; box-sizing: border-box; white-space: pre-wrap; line-height: 1.9; font-size: 28rpx; }
.insertion-picker { padding: 24rpx; border: 1rpx solid #c8bfae; border-radius: 14rpx; font-size: 28rpx; line-height: 1.6; }
.insertion-preview { padding: 24rpx 0; white-space: pre-wrap; line-height: 1.9; font-size: 30rpx; }

.contents-cover-button { flex: none; margin: 0; padding: 0; width: 132rpx; background: transparent; line-height: 1; overflow: visible; }
.contents-cover-button::after { border: none; }
.contents-cover-button .contents-cover { display: block; }
.contents-cover-caption { display: block; margin-top: 14rpx; font-size: 22rpx; line-height: 1.4; color: #64816d; }
.contents-cover.has-custom-cover { border-radius: 4rpx; }
