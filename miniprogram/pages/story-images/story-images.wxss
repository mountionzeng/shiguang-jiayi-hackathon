@import "../book/action-icons.wxss";
/* 配图管理：纸面底色、按章节分组的卡片，操作区保持高对比与大触控。 */
.images-page { min-height: 100vh; padding: 28rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); background: var(--paper); }
.images-eyebrow { font-size: 24rpx; color: var(--ink-soft); }
.images-title { margin: 8rpx 0 12rpx; font-size: 40rpx; line-height: 1.5; color: var(--ink); }
.images-usage { font-size: 30rpx; font-weight: 600; color: var(--jade); }
.images-note { font-size: 26rpx; line-height: 1.8; color: var(--ink-soft); }
.images-loading { margin-top: 32rpx; }
.notice { margin: 20rpx 0; padding: 12rpx 20rpx; font-size: 26rpx; line-height: 1.6; color: var(--ink); background: var(--apricot-soft); border-radius: 12rpx; }
/* Override WeChat v2 button default width and margins explicitly. */
.images-page .tool-button { flex: none; width: auto; min-width: 88rpx; height: 80rpx; min-height: 80rpx; margin: 0; padding: 0 16rpx; display: flex; align-items: center; justify-content: center; white-space: nowrap; font-size: 28rpx; color: var(--jade); border-radius: 12rpx; background: transparent; }
.images-page .tool-button[disabled] { color: var(--ink-soft); opacity: .55; background: transparent; }
.chapter-group { margin-top: 32rpx; padding: 20rpx 24rpx; background: var(--paper-card); border: 1rpx solid var(--line); border-radius: 16rpx; }
.chapter-group.is-focus { border-color: var(--jade); }
.group-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.group-name { flex: 1; min-width: 0; font-size: 32rpx; line-height: 1.5; color: var(--ink); }
.art-direction-input { box-sizing: border-box; width: 100%; height: 76rpx; margin-top: 16rpx; padding: 0 18rpx; color: var(--ink); background: var(--paper); border: 1rpx solid var(--line); border-radius: 10rpx; font-size: 27rpx; }
.art-direction-hint { margin-top: 6rpx; color: var(--ink-soft); font-size: 22rpx; line-height: 1.5; }
.job-row { margin-top: 12rpx; padding: 12rpx 16rpx; font-size: 26rpx; line-height: 1.6; color: var(--ink); background: var(--paper-sunk); border-radius: 10rpx; }
.job-row.is-active { color: var(--jade); background: var(--jade-soft); }
.image-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.image-card { width: calc(50% - 8rpx); }
.image-thumb { display: block; width: 100%; height: 240rpx; border-radius: 10rpx; background: var(--paper-sunk); }
.image-meta { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 8rpx; font-size: 22rpx; line-height: 1.6; color: var(--ink-soft); }
.ai-badge { padding: 0 8rpx; color: var(--lake); background: var(--lake-soft); border-radius: 6rpx; }

.group-actions { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 8rpx; }
.backdrop-state { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 12rpx; padding: 8rpx 16rpx; font-size: 26rpx; line-height: 1.6; color: var(--ink); background: var(--coral-soft); border-radius: 10rpx; }
.card-actions { display: flex; flex-wrap: wrap; }
.purpose-badge { padding: 0 8rpx; color: var(--apricot); background: var(--apricot-soft); border-radius: 6rpx; }
.purpose-badge.is-in-use { color: var(--jade); background: var(--jade-soft); }
.quality-flawed { color: var(--coral); }
