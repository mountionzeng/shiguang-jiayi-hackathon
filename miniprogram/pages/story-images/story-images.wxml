<view class="images-page">
  <view class="images-header">
    <view class="images-eyebrow">{{bookTitle || '人生之书'}} · 配图</view>
    <view class="images-title serif">这本书的图</view>
    <view class="images-usage" wx:if="{{usageLabel}}">{{usageLabel}}</view>
    <view class="images-note" wx:if="{{limitsLabel}}">{{limitsLabel}}</view>
    <view class="images-note">画面以本章已保存的文字为准。可直接从手机选参考照片，无需先放进正文；也可以不选图，只根据文字生成。参考照片会帮助画面贴近原图中的主体、颜色和关键物件。底图铺在正文纸面，插图可放进正文，每张图保留 AI 生成标识。</view>
  </view>
  <view class="notice" wx:if="{{loadError || (notice && !noticeChapterId)}}">{{loadError || notice}}</view>
  <button wx:if="{{loadError}}" class="tool-button" bindtap="retryLoad">重新加载</button>
  <view wx:if="{{loading && !loadError}}" class="images-note images-loading">正在读取…</view>
  <view wx:elif="{{!loadError && !groups.length}}" class="images-note images-loading">这本书还没有章节。先在书稿里新开一章、写几句并保存，再来配图。</view>

  <view class="chapter-group {{group.id === focusChapterId ? 'is-focus' : ''}}" wx:for="{{groups}}" wx:key="id" wx:for-item="group">
    <view class="group-head">
      <text class="group-name serif">{{group.label}}{{group.title ? '　' + group.title : ''}}</text>
    </view>
    <input class="art-direction-input" data-id="{{group.id}}" value="{{artDirections[group.id] || ''}}" maxlength="80" placeholder="想画成什么样子（可不填）" aria-label="{{group.label}}的美术想法" bindinput="onArtDirectionInput" />
    <view class="art-direction-hint">例如：暖黄彩铅、粗纸纹理。画面内容仍以本章正文为准。{{group.referencePhotoLabel}}</view>
    <view class="reference-choice" wx:if="{{group.referencePhotoIds.length}}">
      <text>{{useChapterPhotos[group.id] ? '参考本章照片' : '只根据文字生成'}}</text>
      <switch checked="{{useChapterPhotos[group.id] || false}}" data-id="{{group.id}}" bindchange="onReferenceModeChange" color="#637d70" aria-label="参考本章照片（可不选）" disabled="{{submitting || savingBackdrop || savingPlacement || removingId ? true : false}}" />
    </view>
    <button class="phone-reference-button" data-id="{{group.id}}" bindtap="addPhoneReference" disabled="{{submitting || pickingReference || savingBackdrop || savingPlacement || removingId}}">{{pickingReference === group.id ? '正在选择…' : '＋ 从手机选参考图'}}</button>
    <view class="phone-reference-hint">最多 3 张；手机照片优先于本章照片，也可以不选。插图和底图都使用本章所选参考图。</view>
    <view class="phone-reference-list" wx:if="{{phoneReferences[group.id].length}}">
      <view class="phone-reference-item" wx:for="{{phoneReferences[group.id]}}" wx:for-item="photo" wx:key="id">
        <image src="{{photo.path}}" mode="aspectFill" aria-label="手机参考照片" />
        <button data-chapter="{{group.id}}" data-id="{{photo.id}}" bindtap="removePhoneReference" disabled="{{submitting || pickingReference}}" aria-label="移除这张参考照片">移除</button>
      </view>
    </view>
    <view class="group-actions">
      <button class="tool-button {{group.id === focusChapterId && focusPurpose === 'illustration' ? 'is-route-focus' : ''}}" data-id="{{group.id}}" data-purpose="illustration" bindtap="generate" loading="{{submitting === group.id + ':illustration'}}" disabled="{{submitting || savingBackdrop ? true : false}}">
        <view class="action-icon icon-ai" aria-hidden="true"></view>{{submitting === group.id + ':illustration' ? '提交中' : '配一张插图'}}
      </button>
      <button class="tool-button {{group.id === focusChapterId && focusPurpose === 'backdrop' ? 'is-route-focus' : ''}}" data-id="{{group.id}}" data-purpose="backdrop" bindtap="generate" loading="{{submitting === group.id + ':backdrop'}}" disabled="{{submitting || savingBackdrop ? true : false}}">
        <view class="action-icon icon-photo" aria-hidden="true"></view>{{submitting === group.id + ':backdrop' ? '提交中' : '配一张底图'}}
      </button>
    </view>
    <generation-status wx:if="{{submitting && noticeChapterId === group.id}}" kind="image" text="{{notice}}" />
    <view class="notice" wx:elif="{{notice && noticeChapterId === group.id}}">{{notice}}</view>
    <view class="backdrop-state" wx:if="{{group.backdropMissing}}">
      <text>这一章选的底图已经不在了。</text>
      <button class="tool-button" data-chapter="{{group.id}}" data-image="" bindtap="setBackdrop" disabled="{{savingBackdrop || savingPlacement || removingId || submitting}}">
        <view class="action-icon icon-remove" aria-hidden="true"></view>不用了
      </button>
    </view>
    <view class="job-row {{job.active ? 'is-active' : ''}}" wx:for="{{group.pending}}" wx:key="jobId" wx:for-item="job">
      <generation-status wx:if="{{job.active}}" kind="image" text="{{job.purposeLabel + ' · ' + job.message}}" />
      <text wx:else>{{job.purposeLabel}} · {{job.message}}</text>
    </view>
    <view class="image-grid" wx:if="{{group.images.length}}">
      <view class="image-card" wx:for="{{group.images}}" wx:key="imageId" wx:for-item="image">
        <image class="image-thumb" src="{{image.url}}" mode="aspectFill" data-url="{{image.url}}" bindtap="previewImage" aria-label="查看大图" />
        <view class="image-meta">
          <text class="purpose-badge {{image.inUse ? 'is-in-use' : ''}}">{{image.inUse ? '本章底图' : image.purposeLabel}}</text>
          <text>{{image.sizeLabel}}</text>
          <text wx:if="{{image.moderationLabel}}">{{image.moderationLabel}}</text>
          <text wx:if="{{image.qualityLabel}}" class="{{image.qualityFlawed ? 'quality-flawed' : ''}}">{{image.qualityLabel}}</text>
          <text wx:if="{{image.inText}}">正文中使用</text>
        </view>
      </view>
    </view>
    <view wx:if="{{!group.images.length && !group.pending.length}}" class="images-note">这一章还没有配图。</view>
  </view>

  <view wx:if="{{otherImages.length}}" class="chapter-group">
    <view class="group-head"><text class="group-name serif">已删掉的章节里的图</text></view>
    <view class="image-grid">
      <view class="image-card" wx:for="{{otherImages}}" wx:key="imageId" wx:for-item="image">
        <image class="image-thumb" src="{{image.url}}" mode="aspectFill" data-url="{{image.url}}" bindtap="previewImage" aria-label="查看大图" />
        <view class="image-meta">
          <text class="purpose-badge">{{image.purposeLabel}}</text>
          <text>{{image.sizeLabel}}</text>
          <text wx:if="{{image.qualityLabel}}" class="{{image.qualityFlawed ? 'quality-flawed' : ''}}">{{image.qualityLabel}}</text>
        </view>
        <view class="card-actions">
          <button class="tool-button" data-id="{{image.imageId}}" bindtap="remove" disabled="{{removingId === image.imageId}}">
            <view class="action-icon icon-delete" aria-hidden="true"></view>删除
          </button>
        </view>
      </view>
    </view>
  </view>
</view>

<view class="image-preview-mask" wx:if="{{preview}}" bindtap="closePreview">
  <view class="image-preview-sheet" catchtap="keepPreviewOpen" role="dialog" aria-label="配图预览与位置">
    <view class="image-preview-head"><text class="serif">{{preview.purposeLabel}}</text><button bindtap="closePreview" disabled="{{savingPlacement || savingBackdrop || removingId || submitting}}" aria-label="关闭大图">关闭</button></view>
    <image class="image-preview-art" src="{{preview.url}}" mode="aspectFit" />
    <scroll-view class="image-preview-controls" scroll-y>
      <text class="image-preview-note" wx:if="{{preview.qualityLabel}}">{{preview.qualityLabel}}</text>
      <block wx:if="{{!preview.isBackdrop}}">
        <picker range="{{placementOptions}}" range-key="label" value="{{placementIndex}}" bindchange="onPlacementChange" disabled="{{savingPlacement || savingBackdrop || removingId || submitting}}">
          <view class="image-preview-position">{{placementIndex >= 0 ? placementOptions[placementIndex].label : '请选择插图位置'}}<text>⌄</text></view>
        </picker>
        <button class="image-preview-primary" bindtap="savePlacement" loading="{{savingPlacement}}" disabled="{{savingPlacement || savingBackdrop || removingId || submitting || placementIndex < 0 || !preview.referenceReady}}">{{preview.inText ? '保存位置' : '放进正文'}}</button>
        <button class="image-preview-secondary" wx:if="{{preview.inText}}" data-remove="true" bindtap="savePlacement" disabled="{{savingPlacement || savingBackdrop || removingId || submitting}}">从正文移除</button>
      </block>
      <button class="image-preview-primary" wx:else bindtap="usePreviewBackdrop" loading="{{savingBackdrop}}" disabled="{{savingBackdrop || savingPlacement || removingId || submitting}}">{{preview.inUse ? '不用这张底图' : '设为本章底图'}}</button>
      <view class="image-preview-note" wx:if="{{previewNotice}}">{{previewNotice}}</view>
      <view class="image-preview-actions">
        <button wx:if="{{preview.referenceReady}}" bindtap="redrawPreview" loading="{{submitting ? true : false}}" disabled="{{submitting || savingPlacement || savingBackdrop || removingId}}">{{submitting ? '提交中' : '参考这张再画'}}</button>
        <button bindtap="deletePreview" disabled="{{removingId || savingPlacement || savingBackdrop || submitting}}">删除原图</button>
      </view>
    </scroll-view>
  </view>
</view>
