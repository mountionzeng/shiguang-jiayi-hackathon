/* 记忆之家：确认后公开的家庭时间线 */

/*
 * 页面标题与底部切换条的「记忆之家」是同样四个字，字形必须同款，
 * 所以走 .typewriter 那套仿宋；房间名是内容，保持宋体的阅读感。
 */
.room-branch-title {
  font-family: "Courier New", FangSong, STFangsong, "Songti SC", serif;
}

.room-head {
  padding: 8rpx 0 24rpx;
}

.room-head .eyebrow {
  margin-bottom: 8rpx;
}

.elder-task {
  display: flex;
  align-items: center;
  margin: 26rpx 0 10rpx;
  padding: 26rpx 30rpx;
  border-radius: 28rpx;
  background: var(--coral-soft);
  border: 2rpx solid rgba(199, 69, 46, 0.28);
}

.elder-task-copy {
  flex: 1;
  min-width: 0;
}

.elder-task-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--coral);
}

.elder-task-note {
  display: block;
  margin-top: 6rpx;
  font-size: 25rpx;
  color: var(--ink-soft);
}

.elder-task-go {
  flex-shrink: 0;
  padding-left: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--coral);
}

.room-title {
  font-size: 46rpx;
  font-weight: 600;
  color: var(--ink);
}

.room-sub {
  margin-top: 10rpx;
  font-size: 27rpx;
  line-height: 1.65;
  color: var(--ink-soft);
}

/* ---- 成员筛选 ---- */

.filter-strip {
  width: 100%;
  white-space: nowrap;
}

.filter-row {
  display: flex;
  align-items: flex-start;
  padding: 4rpx 0 8rpx;
}

.filter {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  width: 128rpx;
  min-height: 168rpx;
  padding: 14rpx 6rpx;
  margin-right: 12rpx;
  border-radius: 24rpx;
  border: 2rpx solid transparent;
}

.filter-on {
  border-color: var(--jade);
  background: var(--jade-soft);
}

.filter-avatar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border: 2rpx solid rgba(74, 110, 136, 0.26);
  border-radius: 38rpx;
  background: rgba(203, 219, 232, 0.95);
  color: var(--lake);
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
}

/* 与首页、切换档案一致：同一张水彩底，蓝晕给亲友、绿晕给长辈。 */
.filter-avatar-backdrop {
  position: absolute;
  top: -52rpx;
  left: -48rpx;
  width: 120rpx;
  height: 160rpx;
  opacity: 0.5;
  pointer-events: none;
}

.filter-avatar-letter {
  position: relative;
  z-index: 1;
}

.filter-avatar-elder {
  border-color: rgba(79, 127, 107, 0.26);
  background: rgba(216, 231, 222, 0.95);
  color: var(--jade);
}

.filter-avatar-elder .filter-avatar-backdrop {
  top: -43rpx;
  left: -22rpx;
  opacity: 0.62;
}

.filter-name {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: var(--ink);
}

.filter-count {
  margin-top: 2rpx;
  font-size: 23rpx;
  color: var(--ink-faint);
}

/* ---- 时间线 ---- */

.timeline {
  margin-top: 28rpx;
}

.tl-item {
  display: flex;
  align-items: stretch;
}

.tl-rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  width: 34rpx;
  padding-top: 12rpx;
}

.tl-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background: var(--jade);
}

.tl-line {
  flex: 1;
  width: 2rpx;
  margin-top: 8rpx;
  background: var(--line);
}

.tl-body {
  flex: 1;
  min-width: 0;
  margin-bottom: 28rpx;
  padding: 26rpx 28rpx;
  border-radius: 26rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--line);
}

.tl-body:active {
  background: var(--paper-sunk);
}

.tl-meta {
  display: flex;
  align-items: center;
}

.tl-avatar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  margin-right: 14rpx;
  border: 2rpx solid rgba(74, 110, 136, 0.24);
  border-radius: 26rpx;
  background: rgba(203, 219, 232, 0.95);
  color: var(--lake);
  font-size: 24rpx;
  font-weight: 600;
  overflow: hidden;
}

.tl-avatar-backdrop {
  position: absolute;
  top: -64rpx;
  left: -60rpx;
  width: 120rpx;
  height: 160rpx;
  opacity: 0.5;
  pointer-events: none;
}

.tl-avatar-letter {
  position: relative;
  z-index: 1;
}

.tl-author {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  color: var(--ink-soft);
}

.tl-mine {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: var(--apricot-soft);
  color: var(--apricot);
  font-size: 22rpx;
}

.tl-title {
  margin-top: 18rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.tl-text {
  margin-top: 12rpx;
  font-size: 34rpx;
  line-height: 1.75;
  color: var(--ink);
}

.tl-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.tl-type {
  margin-left: auto;
  margin-right: 14rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: var(--paper-sunk);
  color: var(--ink-soft);
  font-size: 22rpx;
}

.tl-date {
  font-size: 23rpx;
  color: var(--ink-faint);
}

/* ---- 空状态 ---- */

.empty-filter {
  margin-top: 40rpx;
  padding: 40rpx 32rpx;
  border-radius: 26rpx;
  background: var(--paper-sunk);
}

.empty-filter-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.empty-filter-note {
  margin-top: 10rpx;
  font-size: 27rpx;
  line-height: 1.65;
  color: var(--ink-soft);
}

.empty-room {
  margin-top: 40rpx;
  padding: 48rpx 36rpx;
  border-radius: 30rpx;
  border: 2rpx solid var(--line);
}

.empty-room-title {
  position: relative;
  z-index: 1;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--ink);
}

.empty-room-note {
  position: relative;
  z-index: 1;
  margin-top: 16rpx;
  font-size: 29rpx;
  line-height: 1.75;
  color: var(--ink-soft);
}

.empty-room-btn {
  position: relative;
  z-index: 1;
  margin-top: 36rpx;
}

/* ---- 说明 ---- */

.mine-note {
  margin-top: 32rpx;
  padding: 22rpx 26rpx;
  border-radius: 22rpx;
  background: var(--apricot-soft);
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--apricot);
}

.invite-note {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: var(--paper-sunk);
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--ink-faint);
}

/* ---- 详情面板 ---- */

.sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  background: rgba(31, 58, 52, 0.38);
}

.sheet {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 31;
  max-height: 86vh;
  padding: 20rpx 36rpx calc(32rpx + env(safe-area-inset-bottom));
  border-top-left-radius: 36rpx;
  border-top-right-radius: 36rpx;
  background: var(--paper);
  animation: sheet-up 260ms ease-out both;
}

@keyframes sheet-up {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.sheet-grip {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 28rpx;
  border-radius: 4rpx;
  background: var(--line);
}

.sheet-meta {
  display: flex;
  align-items: center;
}

.sheet-who {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.sheet-author {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.sheet-time {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--ink-faint);
}

.sheet-title {
  margin-top: 26rpx;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--ink);
}

.sheet-text {
  margin-top: 18rpx;
  padding: 28rpx;
  border-radius: 26rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--line);
  font-size: 36rpx;
  line-height: 1.8;
  color: var(--ink);
}

.sheet-status {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}

.sheet-status .tag {
  margin-right: 14rpx;
}

.sheet-actions {
  margin-top: 32rpx;
}

.sheet-actions .btn {
  margin-bottom: 16rpx;
}

.sheet-revoke {
  border-color: var(--coral);
  color: var(--coral);
}

.sheet-hint {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--ink-faint);
}
