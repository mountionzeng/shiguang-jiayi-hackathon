<view class="quick-page page-enter" style="bottom: {{keyboardHeight}}px">
  <view class="quick-head">
    <view>
      <text class="eyebrow">{{memberName}} · {{memberRelation}}</text>
      <view class="quick-title serif">{{stage === 'write' ? '记下此刻' : '这段放在哪里？'}}</view>
    </view>
    <text class="tag tag-apricot"><text class="tag-mark">我</text>保持原话</text>
  </view>

  <block wx:if="{{stage === 'write'}}">
    <scroll-view class="quick-scroll" scroll-y>
      <view class="quick-content">
        <view class="write-intro">不用把它讲完整。一个念头、一种心情、一件刚刚发生的小事，都值得先留下来。</view>
        <textarea
          class="feeling-input serif"
          value="{{text}}"
          placeholder="此刻，我想……"
          placeholder-class="input-placeholder"
          maxlength="{{-1}}"
          auto-focus
          fixed="{{true}}"
          adjust-position="{{false}}"
          show-confirm-bar="{{false}}"
          cursor-spacing="24"
          bindinput="onInput"
          bindkeyboardheightchange="onKeyboardHeightChange"
        ></textarea>
        <view class="write-foot">
          <text>先忠实记下，下一步再决定归属与分享</text>
          <text class="count {{tooLong ? 'count-over' : ''}}">{{textLength}} / 500</text>
        </view>
      </view>
    </scroll-view>

    <view class="quick-actions">
      <button
        class="btn btn-primary {{(!textLength || tooLong) ? 'btn-disabled' : ''}}"
        bindtap="continueToOrganize"
      >下一步：选择放在哪里</button>
    </view>
  </block>

  <block wx:else>
    <scroll-view class="quick-scroll" scroll-y>
      <view class="quick-content organize-content">
        <view class="preview-card">
          <text class="preview-label">刚刚写下的原话</text>
          <view class="preview-text serif">{{text}}</view>
        </view>

        <view class="organize-section">
          <view class="organize-title">收进哪个故事？</view>
          <view
            class="choice-card {{destination === 'personal' ? 'choice-card-on' : ''}}"
            data-scope="personal"
            bindtap="chooseDestination"
          >
            <view class="choice-mark choice-mark-me">我</view>
            <view class="choice-copy">
              <text class="choice-title">我的人生之书</text>
              <text class="choice-note">这是我自己的感受和经历</text>
            </view>
            <text class="choice-check">{{destination === 'personal' ? '✓' : ''}}</text>
          </view>
          <view
            class="choice-card {{destination === 'family' ? 'choice-card-on choice-card-family' : ''}}"
            data-scope="family"
            bindtap="chooseDestination"
          >
            <view class="choice-mark choice-mark-family">家</view>
            <view class="choice-copy">
              <text class="choice-title">记忆之家</text>
              <text class="choice-note">这是我和家人共同经历的事</text>
            </view>
            <text class="choice-check">{{destination === 'family' ? '✓' : ''}}</text>
          </view>
        </view>

        <view class="organize-section" wx:if="{{destination === 'personal'}}">
          <view class="organize-title">谁可以看这段个人故事？</view>
          <view class="share-note">定向分享只增加阅读权；故事仍然只属于你。</view>

          <view
            class="person-option {{shareTargetId === '' ? 'person-option-on' : ''}}"
            data-id=""
            bindtap="chooseShareTarget"
          >
            <view class="person-avatar person-avatar-private serif">私</view>
            <view class="choice-copy">
              <text class="choice-title">仅自己</text>
              <text class="choice-note">以后仍可以从首页改为定向分享</text>
            </view>
            <text class="choice-check">{{shareTargetId === '' ? '✓' : ''}}</text>
          </view>

          <view
            class="person-option {{shareTargetId === item.id ? 'person-option-on' : ''}}"
            wx:for="{{shareOptions}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="chooseShareTarget"
          >
            <view class="person-avatar serif">{{item.avatarText}}</view>
            <view class="choice-copy">
              <text class="choice-title">{{item.name}}</text>
              <text class="choice-note">{{item.relation}} · 只有对方能额外看到</text>
            </view>
            <text class="choice-check">{{shareTargetId === item.id ? '✓' : ''}}</text>
          </view>
        </view>

        <view class="family-rule" wx:else>
          这段会作为家庭共同记忆等待确认；确认后全家可见，但不会进入任何人的人生之书。
        </view>
        <view class="scroll-tail"></view>
      </view>
    </scroll-view>

    <view class="quick-actions action-row">
      <button class="btn btn-ghost action-back" bindtap="backToWrite">返回修改</button>
      <button class="btn btn-primary action-save" bindtap="save">
        {{saving ? '正在保存…' : '确认保存'}}
      </button>
    </view>
  </block>
</view>
