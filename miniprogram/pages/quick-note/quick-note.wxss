.quick-page {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  background: var(--paper);
}

.quick-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 24rpx 32rpx 20rpx;
  border-bottom: 2rpx solid var(--line);
}

.quick-title {
  margin-top: 4rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: var(--ink);
}

.quick-scroll {
  flex: 1;
  min-height: 0;
}

.quick-content {
  padding: 32rpx;
}

.write-intro {
  padding: 24rpx 26rpx;
  border-radius: 22rpx;
  background: var(--apricot-soft);
  color: var(--ink-soft);
  font-size: 28rpx;
  line-height: 1.7;
}

.feeling-input {
  width: 100%;
  height: 460rpx;
  min-height: 460rpx;
  margin-top: 28rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  border: 2rpx solid var(--line);
  background: var(--paper-card);
  color: var(--ink);
  font-size: 38rpx;
  line-height: 1.85;
}

.input-placeholder {
  color: var(--ink-faint);
}

.write-foot {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-top: 16rpx;
  color: var(--ink-faint);
  font-size: 24rpx;
}

.count {
  flex-shrink: 0;
  margin-left: 20rpx;
}

.count-over {
  color: var(--coral);
  font-weight: 600;
}

.quick-actions {
  flex-shrink: 0;
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--line);
  background: var(--paper);
}

.quick-actions > .btn {
  width: 100%;
}

.organize-content {
  padding-bottom: 0;
}

.preview-card {
  padding: 28rpx;
  border-left: 6rpx solid var(--apricot);
  border-radius: 0 24rpx 24rpx 0;
  background: var(--apricot-soft);
}

.preview-label {
  color: var(--apricot);
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.preview-text {
  margin-top: 12rpx;
  color: var(--ink);
  font-size: 34rpx;
  line-height: 1.8;
}

.organize-section {
  margin-top: 38rpx;
}

.organize-title {
  margin-bottom: 16rpx;
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 600;
}

.choice-card,
.person-option {
  display: flex;
  align-items: center;
  min-height: 126rpx;
  margin-bottom: 16rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid var(--line);
  border-radius: 26rpx;
  background: var(--paper-card);
}

.choice-card-on,
.person-option-on {
  border-color: var(--jade);
  background: var(--jade-soft);
}

.choice-card-family {
  border-color: var(--lake);
  background: var(--lake-soft);
}

.choice-mark,
.person-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 36rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.choice-mark-me,
.person-avatar {
  background: var(--jade);
}

.choice-mark-family {
  background: var(--lake);
}

.person-avatar-private {
  background: var(--ink-faint);
}

.choice-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.choice-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
}

.choice-note {
  margin-top: 5rpx;
  color: var(--ink-soft);
  font-size: 25rpx;
  line-height: 1.55;
}

.choice-check {
  flex-shrink: 0;
  width: 42rpx;
  margin-left: 12rpx;
  color: var(--jade);
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}

.share-note {
  margin: -4rpx 0 18rpx;
  color: var(--ink-faint);
  font-size: 25rpx;
}

.family-rule {
  margin-top: 28rpx;
  padding: 24rpx 26rpx;
  border-radius: 22rpx;
  background: var(--lake-soft);
  color: var(--lake);
  font-size: 27rpx;
  line-height: 1.7;
}

.scroll-tail {
  height: 36rpx;
}

.action-row {
  display: flex;
}

.action-row > .btn {
  width: auto;
}

.action-back {
  flex: 1;
  margin-right: 16rpx;
}

.action-save {
  flex: 1.45;
}
