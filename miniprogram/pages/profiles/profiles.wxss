.profiles-page {
  position: relative;
  min-height: 100vh;
  padding: 54rpx 44rpx calc(64rpx + env(safe-area-inset-bottom));
  background: #fbf8f1;
}

.profiles-paper {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.7;
  pointer-events: none;
}

.profiles-heading,
.profile-create,
.people-add,
.profile-list,
.profile-empty,
.profile-danger-zone,
.profiles-footnote {
  position: relative;
  z-index: 1;
}

.profiles-title {
  color: var(--ink);
  font-size: 52rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.profiles-note {
  margin-top: 10rpx;
  color: var(--ink-faint);
  font-size: 26rpx;
  line-height: 1.6;
}

.profile-list {
  margin-top: 28rpx;
}

.profile-create {
  margin-top: 34rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 254, 251, 0.78);
  box-shadow: 0 12rpx 30rpx rgba(75, 73, 63, 0.06);
}

.profile-input {
  box-sizing: border-box;
  width: 100%;
  height: 82rpx;
  margin-top: 18rpx;
  padding: 0 24rpx;
  border: 2rpx solid rgba(129, 117, 93, 0.14);
  border-radius: 22rpx;
  background: rgba(255, 253, 247, 0.92);
  color: var(--ink);
  font-size: 27rpx;
}

.profile-input-placeholder {
  color: rgba(53, 57, 53, 0.36);
}

.profile-create-button {
  width: 100%;
  height: 84rpx;
  margin-top: 20rpx;
  border-radius: 42rpx;
  background: var(--jade);
  color: #fffefb;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 84rpx;
}

.profile-create-button::after { border: 0; }

.profile-create-button:active {
  transform: scale(0.985);
}

.profile-avatar {
  position: relative;
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border: 2rpx solid rgba(79, 127, 107, 0.22);
  border-radius: 50%;
  background: rgba(229, 239, 233, 0.92);
  color: var(--jade);
  font-size: 32rpx;
  font-weight: 600;
  overflow: hidden;
}

.profile-avatar-backdrop {
  position: absolute;
  top: -38rpx;
  left: -22rpx;
  width: 132rpx;
  height: 172rpx;
  opacity: 0.78;
  pointer-events: none;
}

.profile-avatar-letter {
  position: relative;
  z-index: 1;
}

.profile-copy {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.profile-name {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 600;
}

.profile-relation {
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--ink-faint);
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-empty {
  margin-top: 26rpx;
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  background: rgba(245, 239, 225, 0.68);
  color: var(--ink-faint);
  font-size: 24rpx;
  line-height: 1.7;
}

.profile-danger-zone {
  margin-top: 34rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 254, 251, 0.72);
}

.profile-clear-button {
  width: 100%;
  height: 76rpx;
  border: 2rpx solid rgba(199, 82, 69, 0.24);
  border-radius: 38rpx;
  background: rgba(255, 247, 244, 0.86);
  color: #b64a40;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 72rpx;
}

.profile-clear-button::after { border: 0; }

.profile-clear-button:active {
  transform: scale(0.985);
}

.profiles-footnote {
  margin-top: 30rpx;
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  background: rgba(245, 239, 225, 0.68);
  color: var(--ink-faint);
  font-size: 23rpx;
  line-height: 1.7;
}

/* 加人：名字、关系、按钮排成一行。 */
.people-add {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
  padding: 18rpx;
  border-radius: 28rpx;
  background: rgba(255, 254, 251, 0.78);
  box-shadow: 0 12rpx 30rpx rgba(75, 73, 63, 0.06);
}

.people-add .profile-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  margin: 0 12rpx 0 0;
}

/* Built-in buttons default to a fixed width; each button here sizes to its label. */
.people-add .people-add-button,
.person-row .profile-delete,
.sort-row .sort-button { width: auto; }

.people-add-button {
  flex-shrink: 0;
  height: 76rpx;
  margin: 0;
  padding: 0 26rpx;
  border-radius: 38rpx;
  background: var(--jade);
  color: #fffefb;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 76rpx;
}

.people-add-button::after,
.profile-delete::after,
.sort-button::after,
.trash-toggle::after { border: 0; }

.person-row {
  display: flex;
  align-items: center;
  padding: 18rpx 14rpx;
  border: 2rpx solid transparent;
  border-radius: 28rpx;
}

.person-row + .person-row {
  margin-top: 10rpx;
}

.person-row-author {
  border-color: rgba(79, 127, 107, 0.16);
  background: rgba(255, 253, 247, 0.74);
}

.person-relation {
  color: var(--ink-faint);
  font-size: 23rpx;
  font-weight: 400;
}

.person-permission {
  margin-top: 6rpx;
  color: var(--ink-faint);
  font-size: 23rpx;
  line-height: 1.5;
}

.person-permission-author {
  color: var(--jade);
  font-weight: 600;
}

.profile-delete {
  flex-shrink: 0;
  height: 56rpx;
  margin: 0 0 0 14rpx;
  padding: 0 22rpx;
  border: 2rpx solid rgba(199, 82, 69, 0.22);
  border-radius: 28rpx;
  background: rgba(255, 247, 244, 0.86);
  color: #b64a40;
  font-size: 23rpx;
  line-height: 52rpx;
}

.sort-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e4ddca;
}

.sort-copy {
  flex: 1;
  min-width: 0;
}

.sort-button {
  flex-shrink: 0;
  height: 60rpx;
  margin: 0 0 0 12rpx;
  padding: 0 22rpx;
  border: 2rpx solid rgba(79, 127, 107, 0.24);
  border-radius: 30rpx;
  background: rgba(229, 239, 233, 0.7);
  color: var(--jade);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 56rpx;
}

.sort-button[disabled] {
  opacity: 0.4;
}

.trash-toggle {
  display: flex;
  justify-content: space-between;
  width: 100%;
  margin: 0;
  padding: 0;
  background: transparent;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.6;
  text-align: left;
}
