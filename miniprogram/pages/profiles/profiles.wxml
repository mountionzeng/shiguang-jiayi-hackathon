<view class="profiles-page page-enter">
  <image
    class="profiles-paper"
    src="/assets/illustrations/home-paper.jpg"
    mode="scaleToFill"
    aria-hidden="true"
  ></image>

  <block wx:if="{{view === 'new-book'}}">
    <view class="profiles-heading">
      <view class="profiles-title serif">新建一本人生之书</view>
      <view class="profiles-note">写的是谁？可以是你自己，也可以是家里的某个人。你是这本书的主笔。</view>
      <view wx:if="{{loadError}}" class="profiles-note">{{loadError}}<button bindtap="retryLoad">重新加载</button></view>
    </view>
    <view class="profile-create">
      <input class="profile-input" value="{{nameInput}}" bindinput="onNameInput" maxlength="12" placeholder="这本书写的是谁" placeholder-class="profile-input-placeholder" />
      <input class="profile-input" value="{{relationInput}}" bindinput="onRelationInput" maxlength="12" placeholder="ta 是你的谁？写你自己就留空" placeholder-class="profile-input-placeholder" />
      <button class="profile-create-button" bindtap="createBook" disabled="{{adding}}" hover-class="none">创建并切换到这本书</button>
    </view>
  </block>

  <block wx:else>
    <view class="profiles-heading">
      <view class="profiles-title serif">家人和朋友</view>
      <view class="profiles-note">你是主笔。拉人进来后，每个人能看什么、能改什么、要回答什么，都写在名字旁边。</view>
      <view wx:if="{{loadError}}" class="profiles-note">{{loadError}}<button bindtap="retryLoad">重新加载</button></view>
    </view>

    <view class="people-add">
      <input class="profile-input" value="{{nameInput}}" bindinput="onNameInput" maxlength="12" placeholder="名字" placeholder-class="profile-input-placeholder" />
      <input class="profile-input" value="{{relationInput}}" bindinput="onRelationInput" maxlength="12" placeholder="关系，如妈妈" placeholder-class="profile-input-placeholder" />
      <button class="people-add-button" bindtap="addPerson" disabled="{{adding}}" hover-class="none">加进来</button>
    </view>

    <view class="profile-list">
      <view class="person-row person-row-author">
        <view class="profile-avatar serif"><text class="profile-avatar-letter">我</text></view>
        <view class="profile-copy">
          <view class="profile-name serif">你</view>
          <view class="person-permission person-permission-author">主笔 · 可以写、改，决定谁能看什么</view>
        </view>
      </view>
      <view class="person-row" wx:for="{{people}}" wx:key="id">
        <view class="profile-avatar serif">
          <image class="profile-avatar-backdrop" src="/assets/illustrations/book-wash.png" mode="aspectFill" aria-hidden="true"></image>
          <text class="profile-avatar-letter">{{item.avatarText}}</text>
        </view>
        <view class="profile-copy">
          <view class="profile-name serif">{{item.name}}<text class="person-relation">　{{item.relation}}</text></view>
          <view class="person-permission">{{item.permission}}</view>
        </view>
        <button
          wx:if="{{item.canDelete}}"
          class="profile-delete"
          data-id="{{item.id}}"
          bindtap="removeMember"
          disabled="{{!!busyId}}"
          hover-class="none"
          aria-label="删除{{item.name}}"
        >删除</button>
      </view>
      <view class="profile-empty" wx:if="{{!people.length}}">还没有拉人进来。在上面写下名字就能加。</view>
    </view>

    <view class="profiles-footnote">不再需要的人可以点右侧「删除」，之后会进入最近删除，原始记忆不会消失。</view>

    <view class="profile-create" wx:if="{{trash.length}}">
      <button class="trash-toggle" bindtap="toggleTrash" hover-class="none">
        <text>最近删除 · {{trash.length}}</text><text>{{trashOpen ? '收起' : '展开'}}</text>
      </button>
      <block wx:if="{{trashOpen}}">
        <view class="profiles-note">恢复后原样回来；ta 在记忆里的「涉及的人」和「谁可以看」需要重新设置。</view>
        <view class="sort-row" wx:for="{{trash}}" wx:key="id">
          <view class="sort-copy">
            <view class="profile-name serif">{{item.name}}</view>
            <view class="profile-relation">{{item.relation}} · {{item.deletedLabel}}</view>
          </view>
          <button class="sort-button" data-id="{{item.id}}" bindtap="restoreMember" disabled="{{!!busyId}}" hover-class="none">恢复</button>
        </view>
      </block>
    </view>

    <view class="profile-danger-zone">
      <button class="profile-clear-button" bindtap="clearCurrentFamilyData" hover-class="none">清空当前账号数据</button>
    </view>
  </block>
</view>
