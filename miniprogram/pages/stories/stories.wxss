@import "../archive/archive.wxss";
@import "../book/action-icons.wxss";
.story-content { position: relative; z-index: 1; }
/* 底部固定着三入口切换栏，内容要留出它的高度。 */
.story-page { padding-bottom: calc(276rpx + env(safe-area-inset-bottom)); }.story-memory { margin: 20rpx 0; padding: 28rpx; text-align: left; background: #fffdf6; border-radius: 12rpx 24rpx 18rpx 10rpx; }

.shelf-caption { display: flex; justify-content: space-between; margin: 42rpx 0 22rpx; color: var(--ink-soft); font-size: 23rpx; }
/* Hook-only states: the story-structure owner supplies drag and reorder behavior. */
.story-book.is-dragging { z-index: 5; transform: translateY(-24rpx) rotate(-3deg) scale(1.035); filter: drop-shadow(10rpx 26rpx 18rpx rgba(42,46,43,.24)); }
.story-book.is-drop-target { outline: 3rpx dashed var(--jade); outline-offset: 9rpx; }
.story-book.is-drag-origin { opacity: .28; filter: grayscale(.5); }
.story-shelf.is-sorting .story-book { outline: 2rpx dashed var(--jade); outline-offset: 5rpx; }
.story-actions { display: flex; flex-direction: column; gap: 14rpx; margin-top: 38rpx; }
.story-action { display: flex; align-items: center; width: 100%; min-height: 104rpx; margin: 0; padding: 18rpx 22rpx; border: 1rpx solid rgba(79,127,107,.22); border-radius: 12rpx 22rpx 18rpx 10rpx; background: rgba(255,254,251,.88); color: var(--ink); text-align: left; box-shadow: 3rpx 6rpx 16rpx rgba(42,46,43,.05); }
.story-action-primary { border-color: var(--jade); background: var(--jade); color: var(--paper-card); }
.story-action-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; font-size: 29rpx; font-weight: 600; line-height: 1.45; }
.story-action-note { margin-top: 3rpx; color: var(--ink-soft); font-size: 22rpx; font-weight: 400; }
.story-action-primary .story-action-note { color: rgba(255,254,251,.76); }
.story-action-arrow { margin-left: 10rpx; font-family: serif; font-size: 48rpx; font-weight: 300; line-height: 1; opacity: .72; }
.story-action-back { border-color: transparent; background: rgba(245,242,233,.56); box-shadow: none; }
.story-delete { align-self: flex-end; min-height: 62rpx; margin: 8rpx 0 0; padding: 0 25rpx; border: 1rpx solid rgba(199,82,69,.24); border-radius: 32rpx; background: rgba(255,247,244,.72); color: #b64a40; font-size: 23rpx; line-height: 60rpx; }
.story-delete::after, .deleted-story-restore::after { border: 0; }
.deleted-story-panel { margin-top: 38rpx; padding: 28rpx; border: 1rpx solid rgba(42,46,43,.12); border-radius: 16rpx 28rpx 22rpx 12rpx; background: rgba(255,253,247,.72); }
.deleted-story-heading { color: var(--ink); font-size: 28rpx; font-weight: 600; }
.deleted-story-note { margin-top: 7rpx; color: var(--ink-soft); font-size: 22rpx; line-height: 1.6; }
.deleted-story-row { display: flex; align-items: center; margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid rgba(42,46,43,.1); }
.deleted-story-copy { flex: 1; min-width: 0; }
.deleted-story-title { overflow: hidden; font-size: 27rpx; text-overflow: ellipsis; white-space: nowrap; }
.deleted-story-date { margin-top: 4rpx; color: var(--ink-soft); font-size: 20rpx; }
.deleted-story-restore { flex-shrink: 0; height: 58rpx; margin: 0 0 0 18rpx; padding: 0 24rpx; border: 1rpx solid rgba(79,127,107,.28); border-radius: 30rpx; background: rgba(244,250,246,.78); color: var(--jade); font-size: 23rpx; line-height: 56rpx; }
.selected-memory-list { margin-top: 34rpx; padding-top: 22rpx; border-top: 1rpx solid rgba(79,127,107,.15); }
.selected-memory-list::before { display: block; margin-bottom: 16rpx; color: var(--ink-soft); content: "这个故事的记忆"; font-size: 23rpx; letter-spacing: 2rpx; }
.story-memory { position: relative; width: 100%; border: 1rpx solid rgba(176,130,57,.14); background: rgba(255,254,251,.86); box-shadow: 4rpx 7rpx 16rpx rgba(42,46,43,.05); }
.story-memory { min-height: 190rpx; padding-left: 96rpx; }
@media (prefers-reduced-motion: reduce) { .story-book { transition: none; } }
/* 微信按钮默认宽 184px，优先级高于单个类名：记忆卡片用两层类名写宽度。 */
.note-list .story-memory { width: 100%; margin-right: 0; margin-left: 0; }

/* 微信按钮默认 width:184px 的选择器带属性，优先级高于单个类名；这里用双写类名把按钮宽度和左右外边距压回设计值。 */
.story-action.story-action { width: 100%; margin-left: 0; margin-right: 0; }

/* ---- 书架：每个故事是一本立着的线装书，一层层摆在木板上 ---- */
/* 每本书占位一样高（440rpx），书身高矮错落靠 .spine-body；这样每层书底对齐，重复渐变画出的木板正好接住书底。 */
.bookshelf { margin: 8rpx 0 40rpx; }
.shelf-books { display: flex; flex-wrap: wrap; align-items: flex-end; align-content: flex-start; gap: 34rpx 14rpx; padding: 0 10rpx; background-image: repeating-linear-gradient(to bottom, transparent 0, transparent 440rpx, rgba(176,130,57,.46) 440rpx, rgba(128,99,58,.52) 452rpx, rgba(42,46,43,.12) 452rpx, transparent 474rpx); }
.shelf-books .spine { position: relative; display: block; width: 104rpx; height: 440rpx; margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; overflow: visible; line-height: 1.2; }
.shelf-books .spine::after { border: 0; }
.spine-body { position: absolute; right: 0; bottom: 0; left: 0; height: 100%; filter: drop-shadow(3rpx 6rpx 6rpx rgba(42,46,43,.16)); transition: transform 160ms ease; }
.spine-h-1 .spine-body { height: 93%; }
.spine-h-2 .spine-body { height: 86%; }
.spine-art { position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: block; width: 100%; height: 100%; }
.spine-tint { position: absolute; top: 3%; right: 20%; bottom: 1%; left: 3%; background: rgba(79,127,107,.06); }
.spine-tone-1 .spine-tint { background: rgba(74,110,136,.2); }
.spine-tone-2 .spine-tint { background: rgba(176,130,57,.22); }
.spine-tone-3 .spine-tint { background: rgba(180,80,60,.16); }
.spine-label { position: absolute; top: 12%; right: 25%; bottom: 13%; left: 10%; display: flex; justify-content: center; padding-top: 16rpx; overflow: hidden; }
.spine-title { width: 1.1em; color: var(--ink); font-size: 30rpx; font-weight: 600; line-height: 1.2; text-align: center; word-break: break-all; }
.spine-no { position: absolute; right: 20%; bottom: 3%; left: 3%; color: rgba(255,253,246,.92); font-size: 18rpx; text-align: center; }
.spine-empty .spine-art { opacity: .82; }
.spine-pressed .spine-body { transform: translateY(-14rpx); }
.shelf-books .spine-new .spine-body { display: flex; flex-direction: column; align-items: center; height: 86%; padding-top: 26rpx; border: 3rpx dashed rgba(79,127,107,.45); border-radius: 8rpx; background: rgba(234,241,237,.6); filter: none; }
.spine-new-plus { margin-bottom: 12rpx; color: var(--jade); font-size: 40rpx; line-height: 1; }
.spine-new-title { color: var(--jade); font-weight: 500; }

/* ---- 整理记忆大按钮 + 最近删除小按钮 ---- */
.story-content .memory-organize { position: relative; display: flex; align-items: center; width: 100%; min-height: 150rpx; margin: 12rpx 0 0; padding: 20rpx 28rpx 20rpx 24rpx; border: 2rpx solid rgba(79,127,107,.28); border-radius: 12rpx 26rpx 22rpx 12rpx; background: rgba(255,254,251,.94); box-shadow: 6rpx 12rpx 26rpx rgba(42,46,43,.07); color: var(--ink); text-align: left; line-height: 1.3; }
.story-content .memory-organize::after { border: 0; }
.memory-organize-pressed { transform: translateY(3rpx); opacity: .88; }
.memory-organize-art { flex: none; width: 44rpx; height: 110rpx; margin-right: 24rpx; overflow: hidden; -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent 100%); mask-image: linear-gradient(to bottom, #000 72%, transparent 100%); }
.memory-organize-bookmark { display: block; width: 44rpx; }
.memory-organize-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; }
.memory-organize-title { font-size: 38rpx; font-weight: 600; }
.memory-organize-note { margin-top: 8rpx; color: var(--ink-soft); font-size: 26rpx; }
.memory-organize-arrow { flex: none; margin-left: 12rpx; color: var(--jade); font-family: serif; font-size: 52rpx; line-height: 1; }
.story-content .btn-jade { margin-top: 20rpx; }
.story-content .trash-entry { display: block; width: auto; min-height: 76rpx; margin: 22rpx auto 0; padding: 0 30rpx; border-radius: 999rpx; background: transparent; color: var(--ink-soft); font-size: 26rpx; line-height: 76rpx; text-decoration: underline; text-underline-offset: 6rpx; }
.story-content .trash-entry::after { border: 0; }
.trash-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 49; background: rgba(36,43,39,.32); }
.trash-sheet { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 50; display: flex; flex-direction: column; justify-content: flex-end; }
.trash-panel { max-height: 78vh; padding: 36rpx 36rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; background: var(--paper); box-shadow: 0 -12rpx 40rpx rgba(36,43,39,.12); }
.trash-heading { color: var(--ink); font-size: 36rpx; font-weight: 600; }
.trash-note { margin-top: 8rpx; color: var(--ink-soft); font-size: 25rpx; line-height: 1.6; }
.trash-list { max-height: 52vh; margin-top: 12rpx; }
.trash-empty { padding: 48rpx 0; color: var(--ink-soft); font-size: 26rpx; text-align: center; }
.deleted-story-row .deleted-story-restore { width: auto; height: 72rpx; margin: 0 0 0 18rpx; padding: 0 32rpx; font-size: 27rpx; line-height: 70rpx; }
.trash-panel .trash-close { width: 100%; min-height: 88rpx; margin: 24rpx 0 0; border: 2rpx solid var(--line); border-radius: 44rpx; background: var(--paper-card); color: var(--ink); font-size: 29rpx; line-height: 84rpx; }
.trash-panel .trash-close::after { border: 0; }
.deleted-story-row .trash-purge { flex-shrink: 0; width: auto; height: 72rpx; margin: 0 0 0 12rpx; padding: 0 20rpx; border: 0; background: transparent; color: #b4503c; font-size: 25rpx; line-height: 72rpx; }
.deleted-story-row .trash-purge::after { border: 0; }
.trash-panel .trash-clear { width: 100%; min-height: 88rpx; margin: 20rpx 0 0; border: 2rpx solid rgba(180,80,60,.35); border-radius: 44rpx; background: rgba(248,231,226,.6); color: #b4503c; font-size: 29rpx; line-height: 84rpx; }
.trash-panel .trash-clear::after { border: 0; }
