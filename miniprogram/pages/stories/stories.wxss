@import "../archive/archive.wxss";
@import "../book/action-icons.wxss";
.story-content { position: relative; z-index: 1; }
/* 底部固定着三入口切换栏，内容要留出它的高度。 */
.story-page { padding-bottom: calc(276rpx + env(safe-area-inset-bottom)); }.story-memory { margin: 20rpx 0; padding: 28rpx; text-align: left; background: #fffdf6; border-radius: 12rpx 24rpx 18rpx 10rpx; }

/* A book is the interaction unit. One paper background, four cloth-cover washes. */
.shelf-caption { display: flex; justify-content: space-between; margin: 42rpx 0 22rpx; color: var(--ink-soft); font-size: 23rpx; }
.story-shelf { display: flex; flex-wrap: wrap; align-items: stretch; gap: 42rpx 26rpx; padding: 4rpx 6rpx 36rpx 0; }
.story-book { position: relative; box-sizing: border-box; display: flex; width: calc(50% - 13rpx); min-height: 420rpx; margin: 0; padding: 0; overflow: visible; text-align: left; white-space: normal; color: var(--ink); background: #e4ece2; border: 1rpx solid rgba(79,127,107,.24); border-radius: 6rpx 15rpx 15rpx 6rpx; box-shadow: 5rpx 6rpx 0 var(--paper-card), 7rpx 8rpx 0 var(--line), 10rpx 14rpx 18rpx rgba(42,46,43,.10); transition: transform 160ms ease, box-shadow 160ms ease; }
.story-book::after { position: absolute; left: 2rpx; right: -9rpx; bottom: -24rpx; height: 5rpx; border: 0; border-radius: 50%; background: rgba(176,130,57,.14); }
.story-book:nth-child(4n+2) { background: #e2eaf0; border-color: rgba(74,110,136,.24); }
.story-book:nth-child(4n+3) { background: #f1e7d3; border-color: rgba(176,130,57,.24); }
.story-book:nth-child(4n+4) { background: #f1e0d9; border-color: rgba(180,80,60,.24); }
.book-spine { position: absolute; left: 0; top: 0; bottom: 0; width: 19rpx; border-right: 1rpx solid rgba(42,46,43,.12); border-radius: 5rpx 0 0 5rpx; background: rgba(42,46,43,.06); box-shadow: inset 4rpx 0 4rpx rgba(255,254,251,.5); }
.book-cover { position: relative; display: flex; flex: 1; flex-direction: column; min-width: 0; padding: 26rpx 22rpx 24rpx 36rpx; }
.book-number { font-size: 20rpx; line-height: 1.5; letter-spacing: 2rpx; color: var(--ink-soft); }
.book-name { margin-top: 24rpx; font-size: 34rpx; font-weight: 600; line-height: 1.45; overflow-wrap: anywhere; word-break: break-all; }
.book-rule { width: 36rpx; height: 2rpx; margin: 20rpx 0 16rpx; background: var(--ink-soft); opacity: .4; }
.book-excerpt { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; font-size: 23rpx; line-height: 1.7; color: var(--ink-soft); }
.book-meta { margin-top: 22rpx; font-size: 22rpx; line-height: 1.6; color: var(--ink-soft); }
.book-open { display: flex; justify-content: space-between; margin-top: auto; padding-top: 22rpx; font-size: 23rpx; line-height: 1.5; color: var(--ink); }
.story-book-empty .book-rule { width: 52rpx; background: transparent; border-top: 2rpx dashed var(--ink-soft); }
.story-shelf .story-book-new { min-height: 420rpx; background: rgba(255,254,251,.45); border: 2rpx dashed #a7b9aa; box-shadow: 4rpx 5rpx 0 var(--paper-card), 6rpx 7rpx 0 var(--line); }
.story-book-new .book-cover { justify-content: center; }
.book-new-plus { color: var(--jade); font-size: 56rpx; font-weight: 300; line-height: 1; }
.story-book-new .book-name { font-size: 32rpx; margin: 22rpx 0 18rpx; }
.story-book-new .book-excerpt { display: block; }
.story-book-new .book-excerpt text { display: block; }
.story-book-pressed { transform: translateY(-5rpx); }
/* Hook-only states: the story-structure owner supplies drag and reorder behavior. */
.story-book.is-dragging { z-index: 5; transform: translateY(-18rpx) rotate(-3deg) scale(1.03); box-shadow: 10rpx 24rpx 32rpx rgba(42,46,43,.22); }
.story-book.is-drop-target { outline: 3rpx dashed var(--jade); outline-offset: 9rpx; }
.story-book.is-drag-origin { opacity: .3; box-shadow: none; }
.story-shelf.is-sorting .story-book { outline: 2rpx dashed var(--jade); outline-offset: 5rpx; }
.story-actions { display: flex; flex-direction: column; gap: 14rpx; margin-top: 38rpx; }
.story-action { display: flex; align-items: center; width: 100%; min-height: 104rpx; margin: 0; padding: 18rpx 22rpx; border: 1rpx solid rgba(79,127,107,.22); border-radius: 12rpx 22rpx 18rpx 10rpx; background: rgba(255,254,251,.88); color: var(--ink); text-align: left; box-shadow: 3rpx 6rpx 16rpx rgba(42,46,43,.05); }
.story-action-primary { border-color: var(--jade); background: var(--jade); color: var(--paper-card); }
.story-action-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; font-size: 29rpx; font-weight: 600; line-height: 1.45; }
.story-action-note { margin-top: 3rpx; color: var(--ink-soft); font-size: 22rpx; font-weight: 400; }
.story-action-primary .story-action-note { color: rgba(255,254,251,.76); }
.story-action-arrow { margin-left: 10rpx; font-family: serif; font-size: 48rpx; font-weight: 300; line-height: 1; opacity: .72; }
.story-action-back { border-color: transparent; background: rgba(245,242,233,.56); box-shadow: none; }
.selected-memory-list { margin-top: 34rpx; padding-top: 22rpx; border-top: 1rpx solid rgba(79,127,107,.15); }
.selected-memory-list::before { display: block; margin-bottom: 16rpx; color: var(--ink-soft); content: "这个故事的记忆"; font-size: 23rpx; letter-spacing: 2rpx; }
.story-memory { position: relative; width: 100%; border: 1rpx solid rgba(176,130,57,.14); background: rgba(255,254,251,.86); box-shadow: 4rpx 7rpx 16rpx rgba(42,46,43,.05); }
.story-memory::before { position: absolute; top: 28rpx; bottom: 28rpx; left: 15rpx; width: 4rpx; border-radius: 4rpx; background: rgba(79,127,107,.42); content: ""; }
@media (prefers-reduced-motion: reduce) { .story-book { transition: none; } }
