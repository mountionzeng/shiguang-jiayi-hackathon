<view class="archive-page story-page page-enter">
  <image class="archive-paper" src="/assets/illustrations/story-paper.jpg" mode="scaleToFill" aria-hidden="true" />
  <view class="story-content">
    <view class="archive-eyebrow">{{selectedKey ? '人生之书 · 一个故事' : '人生之书'}}</view>
    <view class="archive-title serif">{{selectedTitle || '你所有的故事'}}</view>
    <view class="archive-intro">{{selectedKey ? '《' + selectedBookTitle + '》 · ' + (selectedWritingMode === 'creative' ? 'AI 共创' : '客观记录') : '每个故事就是一本独立的书。'}}</view>
    <view wx:if="{{loadError}}" class="archive-empty">{{loadError}}<button bindtap="retryLoad">重新加载</button></view>
    <block wx:elif="{{selectedKey}}">
      <view class="story-actions">
        <button class="story-action story-action-primary" bindtap="openSelectedManuscript">
          <view class="action-icon icon-memories icon-on-dark" aria-hidden="true"></view>
          <view class="story-action-copy"><text>打开整理好的章节</text><text class="story-action-note">翻开目录，继续读写</text></view>
          <text class="story-action-arrow" aria-hidden="true">›</text>
        </button>
        <button class="story-action" bindtap="continueStory">
          <view class="action-icon icon-record" aria-hidden="true"></view>
          <view class="story-action-copy"><text>继续讲这个故事</text><text class="story-action-note">从新的记忆接着说</text></view>
          <text class="story-action-arrow" aria-hidden="true">›</text>
        </button>
        <button class="story-action story-action-back" bindtap="backToStories">
          <view class="action-icon icon-back" aria-hidden="true"></view>
          <view class="story-action-copy"><text>返回所有故事</text><text class="story-action-note">回到人生之书</text></view>
        </button>
        <button class="story-delete" bindtap="deleteSelectedStory" hover-class="none">删除这个故事</button>
      </view>
      <view class="note-list selected-memory-list">
        <button class="story-memory" wx:for="{{memories}}" wx:key="id" data-id="{{item.id}}" bindtap="editMemory">
          <view class="bookmark-tab" aria-hidden="true"><image class="bookmark-tab-art" src="/assets/illustrations/memory-bookmark.png" mode="widthFix"></image></view>
          <view class="note-title serif">{{item.title || '一段记忆'}}</view><view class="note-excerpt">{{item.text}}</view><view class="note-archive">点开编辑或调整归类</view>
        </button>
      </view>
    </block>
    <block wx:else>
      <view class="shelf-caption"><text>{{stories.length}} 个故事</text><text>点一本书打开</text></view>
      <view class="bookshelf">
        <view class="shelf-books">
          <button class="story-book spine spine-tone-{{index % 4}} spine-h-{{index % 3}} {{!item.chapterCount ? 'spine-empty' : ''}}" wx:for="{{stories}}" wx:key="key" data-key="{{item.key}}" bindtap="openStory" hover-class="spine-pressed" aria-label="打开故事：{{item.title}}，{{item.label}}">
            <view class="spine-body">
              <image class="spine-art" src="/assets/illustrations/story-book-spine.png" mode="scaleToFill" aria-hidden="true"></image>
              <view class="spine-tint" aria-hidden="true"></view>
              <view class="spine-label"><text class="spine-title serif">{{item.title}}</text></view>
              <text class="spine-no" aria-hidden="true">{{index + 1 < 10 ? '0' : ''}}{{index + 1}}</text>
            </view>
          </button>
          <button class="story-book spine spine-new" bindtap="openCreate" hover-class="spine-pressed" aria-label="创建新故事书">
            <view class="spine-body"><text class="spine-new-plus" aria-hidden="true">＋</text><text class="spine-title spine-new-title">新的故事</text></view>
          </button>
        </view>
      </view>
      <button class="memory-organize" bindtap="openMemories" hover-class="memory-organize-pressed" aria-label="整理记忆，{{ungroupedCount}} 段还没放进故事">
        <view class="memory-organize-art" aria-hidden="true"><image class="memory-organize-bookmark" src="/assets/illustrations/memory-bookmark.png" mode="widthFix"></image></view>
        <view class="memory-organize-copy">
          <text class="memory-organize-title serif">整理记忆</text>
          <text class="memory-organize-note">{{ungroupedCount ? ungroupedCount + ' 段还没放进故事' : '所有记忆都在这里'}}</text>
        </view>
        <text class="memory-organize-arrow" aria-hidden="true">›</text>
      </button>
      <button class="btn btn-jade" bindtap="openCreate">创建一本故事书</button>
      <button wx:if="{{pendingMigrationCount}}" class="memory-organize" bindtap="openMigration">
        <view class="memory-organize-copy"><text class="memory-organize-title serif">待确认的旧内容</text><text class="memory-organize-note">{{pendingMigrationCount}} 项需要确认去向</text></view>
        <text class="memory-organize-arrow">›</text>
      </button>
      <button class="trash-entry" bindtap="openTrash" hover-class="none">最近删除{{deletedItems.length ? ' · ' + deletedItems.length : ''}}</button>
    </block>
  </view>
</view>

<view class="trash-mask" wx:if="{{createOpen}}" bindtap="closeCreate"></view>
<view class="trash-sheet" wx:if="{{createOpen}}" bindtap="closeCreate" role="dialog" aria-label="创建故事书">
  <view class="trash-panel create-panel" catchtap="keepCreateOpen">
    <view class="trash-heading serif">创建故事书</view>
    <input class="create-title" value="{{createTitle}}" bindinput="onCreateTitle" maxlength="40" placeholder="故事名称（默认也是书名）" disabled="{{creating}}" />
    <radio-group class="create-modes" bindchange="onCreateMode">
      <label><radio value="objective" checked="{{createMode === 'objective'}}" />客观记录</label>
      <label><radio value="creative" checked="{{createMode === 'creative'}}" />AI 共创</label>
    </radio-group>
    <view class="trash-note">可以空白开始，也可选记忆作为这本书的素材。</view>
    <scroll-view class="create-memory-list" scroll-y>
      <checkbox-group bindchange="onCreateMemories">
        <label class="create-memory" wx:for="{{createMemories}}" wx:key="id">
          <checkbox value="{{item.id}}" checked="{{item.checked}}" disabled="{{creating}}" />
          <text>{{item.title || item.text}}</text>
        </label>
      </checkbox-group>
    </scroll-view>
    <button class="btn btn-jade" bindtap="createBook" loading="{{creating}}" disabled="{{creating}}">创建并打开</button>
    <button class="trash-close" bindtap="closeCreate" disabled="{{creating}}">取消</button>
  </view>
</view>

<view class="trash-mask" wx:if="{{trashOpen}}" bindtap="closeTrash"></view>
<view class="trash-sheet" wx:if="{{trashOpen}}" bindtap="closeTrash" role="dialog" aria-label="最近删除，点空白处关闭">
  <view class="trash-panel" catchtap="keepTrashOpen">
    <view class="trash-heading serif">最近删除</view>
    <view class="trash-note">删掉的故事和记忆都在这里，恢复后原样回来。永久删除后就找不回来了。</view>
    <scroll-view class="trash-list" scroll-y>
      <view class="deleted-story-row" wx:for="{{deletedItems}}" wx:key="id">
        <view class="deleted-story-copy">
          <view class="deleted-story-title serif">{{item.title}}</view>
          <view class="deleted-story-date">{{item.deletedLabel}}</view>
        </view>
        <button wx:if="{{item.type === 'memory'}}" class="trash-purge" data-id="{{item.id}}" data-title="{{item.title}}" bindtap="purgeItem" hover-class="none">永久删除</button>
        <button class="deleted-story-restore" data-type="{{item.type}}" data-id="{{item.id}}" bindtap="restoreItem" hover-class="none">恢复</button>
      </view>
      <view class="trash-empty" wx:if="{{!deletedItems.length}}">这里是空的。</view>
    </scroll-view>
    <button wx:if="{{deletedMemoryCount}}" class="trash-clear" bindtap="purgeAll" hover-class="none">清空已删除的记忆 · {{deletedMemoryCount}}</button>
    <button class="trash-close" bindtap="closeTrash" hover-class="none">关闭</button>
  </view>
</view>

<story-switcher current="personal"></story-switcher>
