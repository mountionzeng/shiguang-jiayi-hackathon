.migration-page { min-height: 100vh; box-sizing: border-box; padding: 48rpx 34rpx 90rpx; background: #fbf8f1; color: #2a2e2b; }
.migration-title { font-size: 46rpx; font-weight: 600; }
.migration-intro, .migration-reason, .migration-preview, .migration-notice { margin-top: 16rpx; color: #68706b; font-size: 25rpx; line-height: 1.7; }
.migration-card { margin-top: 28rpx; padding: 28rpx; border: 1rpx solid rgba(79,127,107,.2); border-radius: 16rpx; background: #fffefb; }
.migration-chapter { font-size: 32rpx; }
.migration-preview { padding: 18rpx; border-radius: 10rpx; background: #f5f2e9; color: #2a2e2b; }
.migration-label { margin-top: 24rpx; font-size: 23rpx; font-weight: 600; }
.migration-story { width: 100%; margin-top: 12rpx; border: 1rpx solid rgba(79,127,107,.28); border-radius: 36rpx; background: #f4faf6; color: #4f7f6b; font-size: 25rpx; }
.migration-new { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(79,127,107,.14); }
.migration-new-title { box-sizing: border-box; width: 100%; min-height: 78rpx; padding: 0 24rpx; border: 1rpx solid rgba(79,127,107,.28); border-radius: 12rpx; background: #fff; font-size: 25rpx; }
.migration-create { background: #4f7f6b; color: #fff; }
.migration-empty { margin-top: 48rpx; color: #68706b; text-align: center; }
