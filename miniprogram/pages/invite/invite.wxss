.invite-page { position: relative; height: 100vh; min-height: 100vh; padding: calc(20rpx + env(safe-area-inset-top)) 42rpx calc(80rpx + env(safe-area-inset-bottom)); box-sizing: border-box; overflow-x: hidden; overflow-y: auto; -webkit-overflow-scrolling: touch; background: #f7f0e3; }
.invite-paper { position: fixed; inset: 0; width: 100%; height: 100%; opacity: .86; }
.invite-wash { position: fixed; z-index: 0; width: 360rpx; height: 430rpx; opacity: .2; pointer-events: none; }
.invite-wash-top { top: -126rpx; right: -126rpx; transform: rotate(38deg); }
.invite-wash-bottom { bottom: -180rpx; left: -130rpx; transform: rotate(210deg); }
.invite-branch-scene { position: absolute; top: calc(30rpx + env(safe-area-inset-top)); right: -92rpx; z-index: 0; width: 430rpx; height: 176rpx; opacity: .7; pointer-events: none; }
.invite-branch { position: absolute; right: -20rpx; bottom: -8rpx; width: 470rpx; height: 158rpx; transform: rotate(-5deg); }
.invite-bird { position: absolute; width: 92rpx; height: 64rpx; filter: drop-shadow(0 7rpx 8rpx rgba(78,75,62,.08)); }
.invite-bird-one { right: 116rpx; bottom: 54rpx; transform: rotate(-4deg); }
.invite-bird-two { right: 42rpx; bottom: 41rpx; width: 65rpx; height: 46rpx; opacity: .84; transform: scaleX(-1) rotate(-8deg); }
.invite-top, .invite-intro, .invite-form, .step-strip, .copy-page, .art-page, .poster-ready, .accept-card, .invite-loading, .invite-error { position: relative; z-index: 1; }
.invite-top { display: flex; align-items: center; justify-content: flex-end; min-height: 50rpx; }
.invite-primary::after, .invite-secondary::after { border: 0; }
.invite-brand { color: #6f4f3a; font-size: 29rpx; letter-spacing: 4rpx; }
.invite-intro { width: 520rpx; margin-top: 38rpx; }
.invite-eyebrow { color: #9a6950; font-size: 24rpx; letter-spacing: 5rpx; }
.invite-title { margin-top: 14rpx; color: #26372f; font-size: 52rpx; font-weight: 700; letter-spacing: 2rpx; }
.invite-note { margin-top: 16rpx; color: #6f665b; font-size: 26rpx; line-height: 1.68; }
.invite-form { position: relative; margin-top: 34rpx; padding: 38rpx 42rpx 34rpx; border: 2rpx solid rgba(115,95,72,.12); border-radius: 18rpx 42rpx 24rpx 50rpx; background: rgba(255,252,244,.79); box-shadow: 0 26rpx 64rpx rgba(80,60,41,.1), inset 0 0 60rpx rgba(211,190,151,.08); transform: rotate(-.35deg); overflow: hidden; }
.invite-form::before { position: absolute; top: 0; bottom: 0; left: 26rpx; width: 2rpx; background: rgba(177,80,59,.2); content: ""; }
.invite-letter-head { position: relative; display: flex; align-items: center; min-height: 112rpx; padding: 0 16rpx 24rpx 8rpx; border-bottom: 2rpx solid rgba(111,79,58,.13); }
.invite-letter-copy { position: relative; z-index: 2; display: flex; flex: 1; min-width: 0; flex-direction: column; margin-left: 22rpx; }
.invite-letter-label { color: #947862; font-size: 21rpx; letter-spacing: 3rpx; }
.invite-letter-name { margin-top: 3rpx; overflow: hidden; color: #2f392f; font-size: 34rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.invite-letter-nest { position: absolute; right: -34rpx; bottom: -18rpx; width: 138rpx; height: 92rpx; opacity: .34; transform: rotate(7deg); }
.invite-avatar { position: relative; display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; border: 2rpx solid rgba(79,127,107,.2); border-radius: 50%; overflow: hidden; background: rgba(212,227,216,.86); color: #4f6f60; font-size: 39rpx; font-weight: 700; box-shadow: 0 7rpx 22rpx rgba(72,90,77,.08); }
.invite-avatar image { position: absolute; inset: -28rpx; width: 172rpx; height: 172rpx; opacity: .6; }
.invite-avatar text { position: relative; z-index: 1; }
.invite-field { display: block; margin: 28rpx 10rpx 0; }
.invite-field > text { display: block; color: #5b493b; font-size: 25rpx; font-weight: 600; letter-spacing: 1rpx; }
.invite-field input { height: 78rpx; margin-top: 4rpx; padding: 0 4rpx; border-bottom: 2rpx solid rgba(111,79,58,.3); color: #2f392f; font-size: 31rpx; line-height: 78rpx; }
.invite-primary { min-height: 92rpx; margin-top: 34rpx; border-radius: 999rpx; background: linear-gradient(135deg, #5c806d, #78927b); color: #fffdf8; font-size: 30rpx; font-weight: 600; letter-spacing: 1rpx; box-shadow: 0 12rpx 26rpx rgba(79,127,107,.17); }
.invite-primary[disabled] { opacity: .55; }
.invite-privacy, .poster-tip, .accept-note { margin-top: 24rpx; color: #83776a; font-size: 24rpx; line-height: 1.7; }
.poster-ready { margin-top: 34rpx; text-align: center; }
.poster-ready-title { margin-bottom: 24rpx; color: #2f392f; font-size: 38rpx; font-weight: 600; letter-spacing: 2rpx; }
.poster-preview { width: 540rpx; max-height: 748rpx; border-radius: 14rpx 34rpx 20rpx 40rpx; box-shadow: 0 24rpx 70rpx rgba(67,52,38,.18); transform: rotate(-.45deg); }
.poster-tip { padding: 0 36rpx; }
.invite-secondary { min-height: 84rpx; margin-top: 18rpx; border: 2rpx solid rgba(111,79,58,.18); border-radius: 999rpx; background: rgba(255,251,242,.58); color: #6f4f3a; font-size: 28rpx; }
.invite-loading { padding-top: 240rpx; text-align: center; color: #75685a; font-size: 28rpx; }
.accept-card { margin-top: 110rpx; padding: 82rpx 42rpx 44rpx; border: 2rpx solid rgba(115,95,72,.12); border-radius: 22rpx 52rpx 26rpx 60rpx; background: rgba(255,252,244,.82); text-align: center; box-shadow: 0 30rpx 90rpx rgba(69,54,39,.13), inset 0 0 70rpx rgba(211,190,151,.09); transform: rotate(.3deg); overflow: hidden; }
.accept-card::before { position: absolute; top: 34rpx; right: 46rpx; left: 46rpx; height: 2rpx; background: rgba(111,79,58,.13); content: ""; }
.accept-branch { position: absolute; top: -39rpx; right: -102rpx; width: 430rpx; height: 144rpx; opacity: .62; transform: rotate(-4deg); }
.accept-bird { position: absolute; top: 5rpx; right: 74rpx; width: 86rpx; height: 58rpx; transform: scaleX(-1) rotate(-5deg); }
.accept-avatar { margin: -139rpx auto 26rpx; }
.accept-kicker { color: #8f765e; font-size: 26rpx; }
.accept-title { margin-top: 18rpx; color: #293b32; font-size: 48rpx; font-weight: 700; }
.accept-identity { display: flex; flex-direction: column; gap: 10rpx; margin-top: 38rpx; padding: 28rpx 20rpx; border-top: 2rpx solid rgba(111,79,58,.14); border-bottom: 2rpx solid rgba(111,79,58,.14); color: #61584e; font-size: 26rpx; }
.accept-name { color: #6f4f3a; font-size: 40rpx; font-weight: 700; }
.invite-error { margin-top: 30rpx; padding: 24rpx; border-radius: 24rpx; background: rgba(191,83,61,.1); color: #9d4938; font-size: 25rpx; line-height: 1.6; text-align: center; }
.invite-canvas { position: fixed; left: -2000px; top: 0; width: 750px; height: 1040px; }

.step-strip { display: flex; align-items: flex-start; justify-content: center; margin: 34rpx 12rpx 2rpx; }
.step-dot { display: flex; min-width: 106rpx; flex-direction: column; align-items: center; gap: 7rpx; color: #9b8d7d; font-size: 21rpx; }
.step-dot text:first-child { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; border: 2rpx solid rgba(111,79,58,.18); border-radius: 50%; background: rgba(255,252,244,.7); font-size: 22rpx; }
.step-dot.step-on { color: #4f6f60; font-weight: 600; }
.step-dot.step-on text:first-child { border-color: #607e6b; background: #607e6b; color: #fffdf8; box-shadow: 0 8rpx 20rpx rgba(79,111,96,.2); }
.step-line { width: 74rpx; height: 2rpx; margin-top: 24rpx; background: rgba(111,79,58,.18); }

.copy-page, .art-page { margin-top: 38rpx; }
.back-link { width: auto; margin: 0 0 24rpx -16rpx; padding: 8rpx 16rpx; border: 0; background: transparent; color: #7c6a59; font-size: 25rpx; text-align: left; }
.back-link::after, .style-option::after { border: 0; }
.copy-page .invite-title, .art-page .invite-title { margin-top: 12rpx; font-size: 48rpx; }
.copy-paper { position: relative; min-height: 286rpx; margin-top: 34rpx; padding: 44rpx 40rpx 54rpx; border: 2rpx solid rgba(111,79,58,.13); border-radius: 14rpx 38rpx 20rpx 46rpx; background: rgba(255,253,247,.84); box-shadow: 0 24rpx 64rpx rgba(81,59,40,.1); overflow: hidden; transform: rotate(-.25deg); }
.copy-paper::before { position: absolute; top: 26rpx; bottom: 26rpx; left: 24rpx; width: 2rpx; background: rgba(177,80,59,.18); content: ""; }
.copy-paper-bird { position: absolute; top: -10rpx; right: -3rpx; width: 120rpx; height: 80rpx; opacity: .38; transform: scaleX(-1) rotate(-6deg); }
.copy-textarea { position: relative; z-index: 1; width: 100%; min-height: 182rpx; color: #334238; font-size: 31rpx; line-height: 1.8; }
.copy-count { position: absolute; right: 30rpx; bottom: 20rpx; color: #9b8d7d; font-size: 21rpx; }
.copy-generate { margin-top: 24rpx; }

.style-list { display: flex; width: calc(100vw - 84rpx); align-items: stretch; flex-direction: column; gap: 18rpx; margin-top: 30rpx; }
.art-page .style-option { display: flex; width: calc(100vw - 84rpx); max-width: calc(100vw - 84rpx); min-height: 144rpx; align-items: center; box-sizing: border-box; margin: 0; padding: 16rpx 22rpx 16rpx 16rpx; border: 2rpx solid rgba(111,79,58,.13); border-radius: 18rpx 34rpx 18rpx 38rpx; background: rgba(255,252,244,.7); color: #3d493f; text-align: left; transition: border-color .18s ease, transform .18s ease, background .18s ease; }
.style-option.style-on { border-color: rgba(79,111,96,.68); background: rgba(239,245,237,.88); box-shadow: 0 15rpx 38rpx rgba(64,88,71,.1); transform: translateX(6rpx); }
.style-art { position: relative; display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 164rpx; height: 110rpx; border-radius: 12rpx 26rpx 16rpx 30rpx; overflow: hidden; background: #efe7d8; }
.style-art image { width: 180rpx; height: 122rpx; }
.style-art-book { background: #dce4d8; }
.style-art-book image { width: 90rpx; height: 130rpx; transform: rotate(-5deg); }
.style-art-nest { background: #f2e6d3; }
.style-art-nest image { width: 152rpx; height: 102rpx; }
.style-seal { position: absolute; right: 8rpx; bottom: 8rpx; display: flex; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; border-radius: 50%; background: rgba(154,105,80,.88); color: #fff9ed; font-size: 18rpx; }
.style-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; margin-left: 24rpx; }
.style-name { color: #334238; font-size: 31rpx; font-weight: 600; }
.style-note { margin-top: 6rpx; color: #8b7d6d; font-size: 23rpx; }
.style-check { width: 38rpx; color: #4f6f60; font-size: 31rpx; font-weight: 700; text-align: center; }
.invite-mini-preview { position: relative; margin-top: 28rpx; padding: 30rpx 32rpx 28rpx; border-top: 2rpx solid rgba(111,79,58,.16); border-bottom: 2rpx solid rgba(111,79,58,.16); background: rgba(255,252,244,.4); }
.mini-kicker { color: #98765e; font-size: 22rpx; letter-spacing: 2rpx; }
.mini-message { margin-top: 14rpx; padding-right: 116rpx; color: #34443b; font-size: 26rpx; line-height: 1.65; }
.mini-code { position: absolute; right: 28rpx; bottom: 24rpx; display: flex; width: 92rpx; height: 92rpx; align-items: center; justify-content: center; border: 10rpx solid #fff; background: repeating-linear-gradient(45deg,#314239 0 4rpx,#fff 4rpx 8rpx); color: transparent; box-shadow: 0 4rpx 14rpx rgba(52,68,59,.12); }

.accept-message { position: relative; z-index: 1; margin: 28rpx 4rpx 8rpx; color: #435248; font-size: 30rpx; line-height: 1.8; }
.accept-title { position: relative; z-index: 1; }
.accept-book { position: absolute; top: 22rpx; right: -36rpx; width: 210rpx; height: 326rpx; opacity: .2; transform: rotate(8deg); }
.accept-nest { position: absolute; top: 26rpx; left: 24rpx; width: 132rpx; height: 88rpx; opacity: .56; }
.accept-card-book .accept-branch { opacity: .2; }
.accept-card-nest .accept-branch { opacity: .25; }

@media (prefers-reduced-motion: no-preference) {
  .copy-paper, .style-list, .invite-mini-preview { animation: invite-rise .32s ease both; }
  .style-option:nth-child(2) { animation-delay: .04s; }
  .style-option:nth-child(3) { animation-delay: .08s; }
}
@keyframes invite-rise { from { opacity: 0; } to { opacity: 1; } }
