<view class="invite-page page-enter">
  <image class="invite-paper" src="/assets/illustrations/home-paper.jpg" mode="scaleToFill" aria-hidden="true"></image>
  <view class="invite-wash invite-wash-top" aria-hidden="true"></view>
  <view class="invite-wash invite-wash-bottom" aria-hidden="true"></view>

  <view class="invite-branch-scene" aria-hidden="true">
    <image class="invite-branch" src="/assets/illustrations/memory-branch.png" mode="aspectFit"></image>
    <image class="invite-bird invite-bird-one" src="/assets/illustrations/memory-bird.png" mode="aspectFit"></image>
    <image class="invite-bird invite-bird-two" src="/assets/illustrations/memory-bird.png" mode="aspectFit"></image>
  </view>

  <view class="invite-top"><view class="invite-brand typewriter">拾光家忆</view></view>

  <block wx:if="{{mode === 'create'}}">
    <view class="step-strip" wx:if="{{step !== 'ready'}}" aria-label="邀请卡制作进度">
      <view class="step-dot {{step === 'who' ? 'step-on' : ''}}"><text>1</text><text>写给谁</text></view>
      <view class="step-line"></view>
      <view class="step-dot {{step === 'words' ? 'step-on' : ''}}"><text>2</text><text>邀请语</text></view>
      <view class="step-line"></view>
      <view class="step-dot {{step === 'art' ? 'step-on' : ''}}"><text>3</text><text>选插图</text></view>
    </view>

    <view class="invite-intro" wx:if="{{step === 'who'}}">
      <view class="invite-eyebrow typewriter">先想起一个重要的人</view>
      <view class="invite-title serif">这张邀请，写给谁？</view>
      <view class="invite-note">对方扫码后，这段邀请会成为你们共同记忆的开头。称呼和关系只用于这个记忆之家。</view>
    </view>

    <view class="invite-form" wx:if="{{step === 'who'}}">
      <view class="invite-letter-head">
        <view class="invite-avatar serif">
          <view class="invite-profile-wash"></view>
          <text>{{inviteeAvatarText}}</text>
        </view>
        <view class="invite-letter-copy">
          <text class="invite-letter-label typewriter">给一位重要的人</text>
          <text class="invite-letter-name serif">{{inviteeName || '留一个位置'}}</text>
        </view>
        <image class="invite-letter-nest" src="/assets/illustrations/memory-nest.png" mode="aspectFit" aria-hidden="true"></image>
      </view>
      <label class="invite-field">
        <text>我怎么称呼对方</text>
        <input value="{{inviteeName}}" maxlength="8" placeholder="例如：妈、小岚、陈叔" bindinput="onInviteeNameInput" />
      </label>
      <label class="invite-field">
        <text>你们是什么关系</text>
        <input value="{{relation}}" maxlength="12" placeholder="例如：母女、老朋友、同学" bindinput="onRelationInput" />
      </label>
      <button class="invite-primary" bindtap="continueToWords">继续写邀请语</button>
      <view class="invite-privacy">邀请只进入这一个记忆之家。对方写下的故事会先交给你确认，不会直接改动正式书稿。</view>
    </view>

    <view class="copy-page" wx:if="{{step === 'words'}}">
      <button class="back-link" bindtap="previousStep" hover-class="none">‹ 返回改称呼</button>
      <view class="invite-eyebrow typewriter">写给 {{inviteeName}}</view>
      <view class="invite-title serif">把话说短一点</view>
      <view class="invite-note">可以让 AI 写一版，也可以逐字修改。下面三处文字都会原样出现在邀请图里。</view>
      <view class="copy-paper">
        <image class="copy-paper-bird" src="/assets/illustrations/memory-bird.png" mode="aspectFit" aria-hidden="true"></image>
        <label class="copy-field">
          <text>主标题</text>
          <input class="copy-headline serif" value="{{headline}}" maxlength="16" bindinput="onHeadlineInput" placeholder="例如：一起写下我们的故事" />
        </label>
        <label class="copy-field">
          <text>邀请语</text>
          <textarea class="copy-textarea serif" value="{{message}}" maxlength="48" auto-height bindinput="onMessageInput" placeholder="写一句想对他说的话"></textarea>
          <view class="copy-count">{{messageLength}} / 48</view>
        </label>
        <label class="copy-field copy-signature-field">
          <text>署名</text>
          <input class="copy-signature" value="{{signature}}" maxlength="12" bindinput="onSignatureInput" placeholder="你的称呼" />
        </label>
      </view>
      <view class="copy-actions">
        <button class="invite-secondary copy-generate" bindtap="generateAiCopy" loading="{{aiWriting}}" disabled="{{aiWriting}}">{{aiWriting ? 'AI 正在写…' : 'AI 写一版'}}</button>
        <button class="invite-secondary copy-generate" bindtap="generateCopy" disabled="{{aiWriting}}">换个短句</button>
      </view>
      <button class="invite-primary" bindtap="continueToArt">继续选插图</button>
    </view>

    <view class="art-page" wx:if="{{step === 'art'}}">
      <button class="back-link" bindtap="previousStep" hover-class="none">‹ 返回改文字</button>
      <view class="invite-eyebrow typewriter">给邀请添一幅画</view>
      <view class="invite-title serif">选一种记忆的颜色</view>
      <view class="invite-note">插图只装点这张邀请图，不会改变书的封面。二维码始终保持清晰可识别。</view>
      <view class="style-list">
        <button
          class="style-option {{illustrationStyle === item.id ? 'style-on' : ''}}"
          wx:for="{{styleOptions}}"
          wx:key="id"
          data-style="{{item.id}}"
          bindtap="chooseStyle"
          aria-label="选择{{item.name}}"
        >
          <view class="style-art style-art-{{item.id}}">
            <image src="{{item.art}}" mode="aspectFit"></image>
            <text class="style-seal">忆</text>
          </view>
          <view class="style-copy"><text class="style-name serif">{{item.name}}</text><text class="style-note">{{item.note}}</text></view>
          <text class="style-check">{{illustrationStyle === item.id ? '✓' : ''}}</text>
        </button>
      </view>
      <view class="invite-mini-preview">
        <view class="mini-kicker">写给 {{inviteeName}}</view>
        <view class="mini-headline serif">{{headline}}</view>
        <view class="mini-message serif">{{message}}</view>
        <view class="mini-signature">{{signature}} · {{relation}}</view>
        <view class="mini-code">二维码位置</view>
      </view>
      <generation-status wx:if="{{creating}}" kind="image" text="正在准备邀请和图片…" />
      <button class="invite-primary" bindtap="createInvitation" loading="{{creating}}" disabled="{{creating}}">{{creating ? '正在写邀请笺…' : '生成带二维码的邀请图'}}</button>
    </view>

    <view class="poster-ready" wx:if="{{step === 'ready' && posterPath}}">
      <view class="invite-eyebrow typewriter">邀请笺已经写好</view>
      <view class="poster-ready-title serif">把这段新的记忆，送给 {{inviteeName}}</view>
      <image class="poster-preview" src="{{posterPath}}" mode="widthFix" bindtap="previewPoster"></image>
      <view class="poster-tip">图片里已经放入小程序码。发送给亲友后，请他长按识别并接受邀请。</view>
      <button class="invite-primary" bindtap="sharePoster">发送邀请图片</button>
      <button class="invite-secondary" bindtap="savePoster" loading="{{albumSaving}}" disabled="{{albumSaving}}">{{albumSaving ? '保存中…' : '保存邀请图片到相册'}}</button>
      <button class="invite-secondary" open-type="share">也可以直接转发小程序</button>
    </view>
  </block>

  <block wx:else>
    <view class="invite-loading" wx:if="{{loading}}">正在打开这份邀请…</view>
    <view class="accept-card accept-card-{{invitation.illustrationStyle}}" wx:elif="{{invitation}}">
      <image class="accept-branch" src="/assets/illustrations/memory-branch.png" mode="aspectFit" aria-hidden="true"></image>
      <image class="accept-bird" src="/assets/illustrations/memory-bird.png" mode="aspectFit" aria-hidden="true"></image>
      <image class="accept-book" wx:if="{{invitation.illustrationStyle === 'book'}}" src="/assets/illustrations/story-book-cover.png" mode="aspectFit" aria-hidden="true"></image>
      <image class="accept-nest" wx:if="{{invitation.illustrationStyle === 'nest'}}" src="/assets/illustrations/memory-nest.png" mode="aspectFit" aria-hidden="true"></image>
      <view class="invite-avatar accept-avatar serif">
        <view class="accept-avatar-wash"></view>
        <text>{{invitationAvatarText}}</text>
      </view>
      <view class="accept-kicker">{{invitation.signature}} 写给你</view>
      <view class="accept-title serif">{{invitation.headline}}</view>
      <view class="accept-message serif">{{invitation.message}}</view>
      <view class="accept-identity">
        <text>在这里，大家会叫你</text>
        <text class="accept-name">“{{invitation.inviteeName}}”</text>
        <text>你们的关系是 {{invitation.relation}}</text>
      </view>
      <view class="accept-note">接受后，你可以进入这个记忆之家并讲述故事。你的投稿会先等待主人确认。</view>
      <button class="invite-primary" bindtap="acceptInvitation" loading="{{accepting}}" disabled="{{accepting}}">{{invitation.acceptedByMe ? '进入记忆之家' : '接受邀请，一起写'}}</button>
    </view>
    <view class="invite-error" wx:else>{{errorMessage || '这份邀请已经无法打开'}}</view>
  </block>

  <view class="invite-error" wx:if="{{errorMessage && (mode === 'create' || invitation)}}">{{errorMessage}}</view>
  <canvas class="invite-canvas" canvas-id="invitePoster"></canvas>
</view>
