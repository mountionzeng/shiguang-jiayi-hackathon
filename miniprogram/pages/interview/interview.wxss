/* 回忆采访：单一入口的独立采访对话 */

.interview-page {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  background: var(--paper);
}

/* ---- 抬头 ---- */

.who-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 20rpx 32rpx;
  border-bottom: 2rpx solid var(--line);
  background: var(--paper);
}

.who-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding-right: 16rpx;
}

.who-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.who-note {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--ink-faint);
}

/* ---- 对话区 ---- */

.chat-scroll {
  flex: 1;
  min-height: 0;
}

.chat-inner {
  padding: 28rpx 32rpx 0;
}

.source-note {
  margin-bottom: 28rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: var(--paper-sunk);
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--ink-faint);
}

.row {
  display: flex;
  margin-bottom: 28rpx;
}

.row-ai {
  justify-content: flex-start;
}

.row-me {
  justify-content: flex-end;
}

.bubble-wrap {
  max-width: 82%;
  display: flex;
  flex-direction: column;
}

.row-me .bubble-wrap {
  align-items: flex-end;
}

.bubble-label {
  margin-bottom: 8rpx;
  padding-left: 8rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--lake);
}

.bubble {
  padding: 26rpx 28rpx;
  border-radius: 26rpx;
  font-size: 36rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}

.bubble-ai {
  background: var(--paper-card);
  border: 2rpx solid var(--line);
  color: var(--ink);
  border-top-left-radius: 8rpx;
}

.bubble-me {
  background: var(--jade);
  color: #fbfdfc;
  border-bottom-right-radius: 8rpx;
}

.typing {
  display: flex;
  align-items: center;
  min-height: 88rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 6rpx;
  background: var(--ink-faint);
  animation: blink 1.1s infinite ease-in-out;
}

.dot:nth-child(2) {
  animation-delay: 0.18s;
}

.dot:nth-child(3) {
  animation-delay: 0.36s;
}

@keyframes blink {
  0%, 100% { opacity: 0.28; }
  50% { opacity: 1; }
}

.scroll-tail {
  height: 24rpx;
}

/* ---- 底部操作区 ---- */

.composer {
  flex-shrink: 0;
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--line);
  background: var(--paper);
}

.finish-wrap {
  margin-bottom: 20rpx;
}

.finish-count {
  display: block;
  margin-bottom: 10rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-faint);
}

.input-row {
  display: flex;
  align-items: flex-end;
}

.input-field {
  flex: 1;
  min-height: 96rpx;
  max-height: 320rpx;
  padding: 24rpx 22rpx;
  margin-right: 14rpx;
  border-radius: 24rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--line);
  font-size: 34rpx;
  line-height: 1.6;
  color: var(--ink);
}

.input-placeholder {
  color: var(--ink-faint);
}

.send-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 156rpx;
  min-height: 96rpx;
  border-radius: 24rpx;
  background: var(--coral);
  color: #fffdfb;
  font-size: 30rpx;
  font-weight: 600;
}

.send-btn:active {
  opacity: 0.84;
}

/* ---- 保存阶段 ---- */

.save-head {
  margin-bottom: 20rpx;
}

.save-title {
  margin-top: 16rpx;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.5;
  color: var(--ink);
}

.save-note {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--ink-soft);
}

.draft-field {
  width: 100%;
  min-height: 190rpx;
  padding: 26rpx;
  border-radius: 26rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--line);
  font-size: 36rpx;
  line-height: 1.8;
  color: var(--ink);
}

.draft-count {
  margin-top: 12rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--ink-faint);
}

.draft-count-over {
  color: var(--coral);
  font-weight: 600;
}

.scope-block {
  margin-top: 30rpx;
}

.scope-title {
  margin-bottom: 20rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
}

.scope-option {
  display: flex;
  align-items: flex-start;
  min-height: 128rpx;
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 26rpx;
  border: 2rpx solid var(--line);
  background: var(--paper-card);
}

.scope-option-on {
  border-color: var(--jade);
  background: var(--jade-soft);
}

.scope-check {
  flex-shrink: 0;
  width: 48rpx;
  margin-right: 16rpx;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.5;
  color: var(--jade);
}

.scope-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.scope-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
}

.scope-desc {
  margin-top: 8rpx;
  font-size: 27rpx;
  line-height: 1.65;
  color: var(--ink-soft);
}
