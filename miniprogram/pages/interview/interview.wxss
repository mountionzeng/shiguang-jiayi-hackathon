/* 回忆采访：单一入口的独立采访对话 */

.interview-page {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  background: var(--paper);
}

/* ---- 开始前：选择讲述方式 ---- */

.mode-picker {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  min-height: 0;
  padding: 76rpx 40rpx calc(54rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background:
    radial-gradient(circle at 82% 12%, rgba(232, 238, 242, 0.9), transparent 34%),
    radial-gradient(circle at 10% 88%, rgba(234, 241, 237, 0.86), transparent 30%),
    var(--paper);
}

.mode-intro {
  position: relative;
  padding: 0 8rpx;
}

.mode-avatar {
  display: block;
  width: 82rpx;
  height: 82rpx;
  margin-bottom: 24rpx;
  border-radius: 50%;
  box-shadow: 0 10rpx 28rpx rgba(79, 127, 107, 0.12);
  animation: mode-avatar-arrive 620ms ease-out both;
}

.mode-eyebrow {
  color: var(--jade);
  font-size: 22rpx;
  letter-spacing: 6rpx;
}

.mode-title {
  margin-top: 8rpx;
  color: var(--ink);
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: 2rpx;
}

.mode-note {
  max-width: 600rpx;
  margin-top: 12rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
  line-height: 1.7;
}

.mode-grid {
  display: flex;
  margin-top: 48rpx;
}

.mode-choice {
  position: relative;
  display: flex;
  flex: 1;
  align-items: flex-start;
  flex-direction: column;
  min-width: 0;
  min-height: 292rpx;
  padding: 28rpx 24rpx 26rpx;
  border: 2rpx solid rgba(129, 117, 93, 0.18);
  border-radius: 8rpx;
  background: rgba(255, 254, 251, 0.78);
  text-align: left;
  box-shadow: 0 12rpx 34rpx rgba(61, 67, 62, 0.05);
  transition:
    background-color 180ms ease,
    border-color 180ms ease,
    box-shadow 180ms ease,
    transform 180ms ease;
}

.mode-choice + .mode-choice {
  margin-left: 20rpx;
}

.mode-choice:active {
  transform: translateY(2rpx) scale(0.985);
}

.mode-choice-on {
  border-color: rgba(79, 127, 107, 0.62);
  background: rgba(234, 241, 237, 0.74);
  box-shadow: 0 14rpx 34rpx rgba(79, 127, 107, 0.1);
  transform: translateY(-4rpx);
}

.mode-choice-on:active {
  transform: translateY(-1rpx) scale(0.985);
}

.mode-seal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border: 2rpx solid rgba(176, 130, 57, 0.38);
  border-radius: 50%;
  background: var(--apricot-soft);
  color: var(--apricot);
  font-size: 29rpx;
  font-weight: 600;
  transform: rotate(-4deg);
  transition: transform 220ms ease;
}

.mode-seal-memoir {
  border-color: rgba(74, 110, 136, 0.34);
  background: var(--lake-soft);
  color: var(--lake);
  transform: rotate(4deg);
}

.mode-choice-on .mode-seal {
  transform: rotate(0) scale(1.06);
}

.mode-choice-copy {
  margin-top: 26rpx;
}

.mode-choice-title {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: 2rpx;
}

.mode-choice-note {
  margin-top: 10rpx;
  color: var(--ink-faint);
  font-size: 24rpx;
  line-height: 1.65;
}

.mode-choice-note text {
  display: block;
}

.mode-check {
  position: absolute;
  top: 24rpx;
  right: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid rgba(79, 127, 107, 0.24);
  border-radius: 50%;
  color: var(--jade);
  font-size: 23rpx;
  line-height: 1;
}

.mode-choice-on .mode-check {
  border-color: var(--jade);
  background: var(--jade);
  color: #fffefb;
}

.mode-start {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 356rpx;
  min-height: 88rpx;
  margin: 54rpx auto 0;
  padding: 0 30rpx 0 34rpx;
  border: 2rpx solid rgba(79, 127, 107, 0.48);
  border-radius: 12rpx;
  background: rgba(255, 254, 251, 0.72);
  color: var(--jade);
  font-size: 29rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 10rpx 28rpx rgba(71, 92, 80, 0.08);
  transition: background-color 180ms ease, transform 180ms ease;
}

.mode-start-pressed {
  background: var(--jade-soft);
  transform: translateY(2rpx) scale(0.985);
}

.mode-start-arrow {
  font-size: 36rpx;
  font-weight: 400;
  transition: transform 180ms ease;
}

.mode-start-pressed .mode-start-arrow {
  transform: translateX(6rpx);
}

@keyframes mode-avatar-arrive {
  from { opacity: 0; transform: translateY(12rpx) rotate(-5deg) scale(0.92); }
  to { opacity: 1; transform: translateY(0) rotate(0) scale(1); }
}

/* ---- 抬头 ---- */

.who-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 20rpx 32rpx;
  border-bottom: 2rpx solid var(--line);
  background: var(--paper);
}

.who-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding-right: 16rpx;
}

.who-title {
  display: flex;
  align-items: center;
}

.who-ai-avatar {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  margin-right: 12rpx;
  border-radius: 50%;
}

.who-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.who-note {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--ink-faint);
}

/* ---- 对话区 ---- */

.chat-scroll {
  flex: 1;
  min-height: 0;
}

.chat-inner {
  padding: 28rpx 32rpx 0;
}

.source-note {
  margin-bottom: 28rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: var(--paper-sunk);
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--ink-faint);
}

.row {
  display: flex;
  margin-bottom: 28rpx;
}

.row-ai {
  justify-content: flex-start;
}

.row-me {
  justify-content: flex-end;
}

/* 追问：从普通气泡里独立出来的一张卡片 */
.ask-card {
  margin: 0 0 28rpx 0;
  padding: 22rpx 24rpx;
  border: 2rpx solid var(--line);
  border-left: 6rpx solid var(--apricot);
  border-radius: 4rpx 24rpx 24rpx 24rpx;
  background: var(--paper-card);
}

.ask-label {
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  color: var(--apricot);
}

.ask-text {
  margin-top: 10rpx;
  font-size: 34rpx;
  line-height: 1.7;
  color: var(--ink);
}

.ai-mark {
  display: block;
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
  border-radius: 50%;
}

.bubble {
  max-width: 78%;
  padding: 26rpx 28rpx;
  border-radius: 26rpx;
  font-size: 36rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}

.bubble-ai {
  background: var(--paper-card);
  border: 2rpx solid var(--line);
  color: var(--ink);
  border-top-left-radius: 8rpx;
}

.bubble-me {
  background: var(--jade);
  color: #fbfdfc;
  border-bottom-right-radius: 8rpx;
}

.typing {
  display: flex;
  align-items: center;
  min-height: 88rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 6rpx;
  background: var(--ink-faint);
  animation: blink 1.1s infinite ease-in-out;
}

.dot:nth-child(2) {
  animation-delay: 0.18s;
}

.dot:nth-child(3) {
  animation-delay: 0.36s;
}

@keyframes blink {
  0%, 100% { opacity: 0.28; }
  50% { opacity: 1; }
}

.scroll-tail {
  height: 24rpx;
}

/* ---- 底部操作区 ---- */

.composer {
  flex-shrink: 0;
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--line);
  background: var(--paper);
}

.finish-wrap {
  margin-bottom: 20rpx;
}

.finish-count {
  display: block;
  margin-bottom: 10rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-faint);
}

.input-row {
  display: flex;
  align-items: flex-end;
}

.input-field {
  flex: 1;
  min-height: 96rpx;
  max-height: 320rpx;
  padding: 24rpx 22rpx;
  margin-right: 14rpx;
  border-radius: 24rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--line);
  font-size: 34rpx;
  line-height: 1.6;
  color: var(--ink);
}

.input-placeholder {
  color: var(--ink-faint);
}

.send-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: var(--jade);
}

.send-btn:active {
  opacity: 0.84;
}

.send-arrow {
  color: #fffdfb;
  font-size: 44rpx;
  line-height: 1;
  font-weight: 600;
}

/* ---- 工具条 ---- */

.tool-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.tool-chip {
  min-height: 60rpx;
  padding: 12rpx 18rpx;
  margin-right: 12rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  line-height: 1.4;
}

.tool-chip-off {
  background: var(--paper-sunk);
  color: var(--ink-faint);
}

.tool-spacer {
  flex: 1;
}

.tidy-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  padding: 0 26rpx;
  border-radius: 22rpx;
  border: 2rpx solid var(--apricot);
  background: var(--apricot-soft);
  color: var(--apricot);
  font-size: 28rpx;
  font-weight: 600;
}

.tidy-btn:active {
  opacity: 0.8;
}

.tidy-btn-off {
  border-color: var(--line);
  color: var(--ink-faint);
}

/* ---- 保存阶段 ---- */

.tidy-label {
  display: block;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: var(--jade);
}

.draft-title {
  width: 100%;
  margin-top: 16rpx;
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--ink);
}

.draft-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.meta-date {
  margin-right: 14rpx;
  font-size: 24rpx;
  color: var(--ink-faint);
}

.meta-type {
  margin: 4rpx 10rpx 4rpx 0;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--line);
  color: var(--ink-faint);
  font-size: 24rpx;
}

.meta-type-on {
  border-color: var(--jade);
  background: var(--jade-soft);
  color: var(--jade);
  font-weight: 600;
}

.meta-chip {
  margin: 4rpx 10rpx 4rpx 0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: var(--jade-soft);
  color: var(--jade);
  font-size: 23rpx;
}

.draft-rule {
  width: 100%;
  height: 2rpx;
  margin: 24rpx 0 4rpx;
  background: var(--line);
}

.draft-hint {
  margin-top: 22rpx;
  font-size: 25rpx;
  color: var(--ink-faint);
}

.draft-field {
  width: 100%;
  min-height: 190rpx;
  margin-top: 20rpx;
  font-size: 34rpx;
  line-height: 1.95;
  color: var(--ink);
}

.draft-count {
  margin-top: 12rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--ink-faint);
}

.draft-count-over {
  color: var(--coral);
  font-weight: 600;
}


/* ---- 保存阶段底部双按钮 ---- */

.save-row {
  display: flex;
  align-items: center;
}

.save-back {
  flex: 1;
  margin-right: 16rpx;
}

.save-go {
  flex: 1.6;
}

/* ---- 聊完后再整理：故事、相关人物、阅读权限彼此独立 ---- */

.organize-section {
  margin-top: 30rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid var(--line);
}

.organize-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ink);
}

.organize-note {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.65;
  color: var(--ink-faint);
}

.story-choice,
.person-choice {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  border: 2rpx solid var(--line);
  background: var(--paper-card);
}

.choice-on {
  border-color: var(--jade);
  background: var(--jade-soft);
}

.choice-mark,
.person-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 68rpx;
  height: 68rpx;
  margin-right: 18rpx;
  border-radius: 34rpx;
  background: var(--jade);
  color: #fffdfb;
  font-size: 27rpx;
}

.person-avatar-private {
  background: #87948f;
}

.choice-copy,
.person-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.choice-title,
.person-name {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
}

.choice-note,
.person-relation {
  margin-top: 5rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--ink-faint);
}

.choice-check {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: var(--jade);
  font-size: 34rpx;
  font-weight: 600;
}

.story-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.story-chip {
  margin: 8rpx 12rpx 0 0;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--line);
  background: var(--paper-card);
  color: var(--ink-soft);
  font-size: 24rpx;
}

.story-chip-on {
  border-color: var(--jade);
  background: var(--jade-soft);
  color: var(--jade);
  font-weight: 600;
}

.story-input {
  box-sizing: border-box;
  width: 100%;
  height: 92rpx;
  margin-top: 18rpx;
  padding: 0 22rpx;
  border: 2rpx solid var(--line);
  border-radius: 22rpx;
  background: var(--paper-card);
  color: var(--ink);
  font-size: 28rpx;
}

.people-grid {
  width: 100%;
}
