<view class="interview-page" style="bottom: {{keyboardHeight}}px">

  <view class="who-bar">
    <view class="who-copy">
      <text class="who-name">{{memberName}} · {{memberRelation}}</text>
      <text class="who-note" wx:if="{{isElder}}">你在讲自己的往事</text>
      <text class="who-note" wx:else>你在讲你记得的 {{protagonistName}}</text>
    </view>
    <text class="tag tag-lake"><text class="tag-mark">独</text>独立采访</text>
  </view>

  <!-- ============ 对话 ============ -->
  <block wx:if="{{stage === 'chat'}}">
    <scroll-view
      class="chat-scroll"
      scroll-y
      scroll-with-animation
      scroll-into-view="{{scrollIntoView}}"
    >
      <view class="chat-inner">
        <view class="source-note" wx:if="{{localDemoOnly}}">
          未连云端，以下追问来自本地提问规则，不是 AI 生成。
        </view>

        <block wx:for="{{messages}}" wx:key="id">
          <!-- 追问：单独的卡片，和普通气泡区分开 -->
          <view class="ask-card" wx:if="{{item.kind === 'followup'}}" id="{{item.id}}">
            <text class="ask-label">{{item.label}}</text>
            <view class="ask-text serif">{{item.text}}</view>
          </view>

          <view class="row row-me" wx:elif="{{item.kind === 'answer'}}" id="{{item.id}}">
            <view class="bubble bubble-me serif">{{item.text}}</view>
          </view>

          <view class="row row-ai" wx:else id="{{item.id}}">
            <view class="ai-mark serif">问</view>
            <view class="bubble bubble-ai serif">{{item.text}}</view>
          </view>
        </block>

        <view class="row row-ai" wx:if="{{asking}}">
          <view class="ai-mark serif">问</view>
          <view class="bubble bubble-ai typing">
            <text class="dot"></text><text class="dot"></text><text class="dot"></text>
          </view>
        </view>

        <view class="scroll-tail"></view>
      </view>
    </scroll-view>

    <view class="composer">
      <view class="input-row">
        <textarea
          class="input-field"
          value="{{inputText}}"
          placeholder="想到什么说什么"
          placeholder-class="input-placeholder"
          maxlength="{{-1}}"
          auto-height
          fixed="{{true}}"
          adjust-position="{{false}}"
          show-confirm-bar="{{false}}"
          cursor-spacing="24"
          bindinput="onInput"
          bindkeyboardheightchange="onKeyboardHeightChange"
        ></textarea>
        <view class="send-btn" bindtap="send">
          <text class="send-arrow">→</text>
        </view>
      </view>

      <view class="tool-row">
        <view class="tool-chip tool-chip-off" bindtap="notYet">照片 · 赛后接入</view>
        <view class="tool-chip tool-chip-off" bindtap="notYet">语音 · 赛后接入</view>
        <view class="tool-spacer"></view>
        <view
          class="tidy-btn {{answers.length === 0 ? 'tidy-btn-off' : ''}}"
          bindtap="finish"
        >整理成片段</view>
      </view>
    </view>
  </block>

  <!-- ============ 整理与保存 ============ -->
  <block wx:else>
    <scroll-view class="chat-scroll" scroll-y>
      <view class="chat-inner">
        <text class="tidy-label">
          {{localDemoOnly ? '本地演示整理 · 保留你说的原话' : 'AI 云整理 · 需要复核'}}
        </text>

        <textarea
          class="draft-title serif"
          value="{{draftTitle}}"
          placeholder="给这段起个名字"
          placeholder-class="input-placeholder"
          auto-height
          fixed="{{true}}"
          adjust-position="{{false}}"
          show-confirm-bar="{{false}}"
          bindinput="onTitleInput"
          bindkeyboardheightchange="onKeyboardHeightChange"
        ></textarea>

        <view class="draft-meta">
          <text class="meta-date">{{dateLabel}}</text>
          <text class="meta-chip">回忆片段</text>
          <text class="meta-chip" wx:for="{{coveredChips}}" wx:key="*this" wx:for-item="chip">{{chip}}</text>
        </view>

        <view class="draft-rule"></view>

        <textarea
          class="draft-field serif"
          value="{{draftText}}"
          auto-height
          fixed="{{true}}"
          adjust-position="{{false}}"
          show-confirm-bar="{{false}}"
          cursor-spacing="24"
          bindinput="onDraftInput"
          bindkeyboardheightchange="onKeyboardHeightChange"
        ></textarea>
        <view class="draft-count {{tooLong ? 'draft-count-over' : ''}}">
          {{draftLength}} / 500 字{{tooLong ? '　超出部分请先删掉' : ''}}
        </view>

        <view class="draft-hint">
          保存后放进 {{protagonistName}} 的人生之书 · 回忆片段
        </view>

        <view class="scope-block">
          <view class="scope-title">这段给谁看？</view>

          <view
            class="scope-option {{visibility === 'family' ? 'scope-option-on' : ''}}"
            data-visibility="family"
            bindtap="chooseVisibility"
          >
            <text class="scope-check">{{visibility === 'family' ? '✓' : '○'}}</text>
            <view class="scope-copy">
              <text class="scope-name">家庭可见</text>
              <text class="scope-desc">{{protagonistName}} 确认属实后，其他家人才看得到，也才会写进章节。</text>
            </view>
          </view>

          <view
            class="scope-option {{visibility === 'private' ? 'scope-option-on' : ''}}"
            data-visibility="private"
            bindtap="chooseVisibility"
          >
            <text class="scope-check">{{visibility === 'private' ? '✓' : '○'}}</text>
            <view class="scope-copy">
              <text class="scope-name">只给 {{protagonistName}}</text>
              <text class="scope-desc">别的家人永远看不到，也不会进入家庭时间线、章节或模型请求。</text>
            </view>
          </view>
        </view>

        <view class="scroll-tail"></view>
      </view>
    </scroll-view>

    <view class="composer">
      <view class="save-row">
        <button class="btn btn-ghost save-back" bindtap="backToChat">继续讲</button>
        <button
          class="btn btn-primary save-go {{(saving || tooLong) ? 'btn-disabled' : ''}}"
          bindtap="save"
        >{{saving ? '正在保存…' : '保存到书里'}}</button>
      </view>
    </view>
  </block>
</view>
