<view class="interview-page" style="bottom: {{keyboardHeight}}px">

  <view class="who-bar" wx:if="{{stage === 'chat' || stage === 'save'}}">
    <view class="who-copy">
      <view class="who-title">
        <image
          class="who-ai-avatar"
          src="/assets/illustrations/xiaoyi-avatar.png"
          mode="aspectFit"
          aria-label="小忆"
        ></image>
        <text class="who-name">{{captureEntry ? '随手记' : '和小忆聊聊'}}</text>
      </view>
      <text class="who-note">{{sharedFamilyId ? (memberName + ' · ' + memberRelation + ' · 写给这个记忆之家') : '先讲，不急着分类'}}</text>
    </view>
    <text class="tag tag-apricot">
      <text class="tag-mark">聊</text>正在倾听
    </text>
  </view>

  <!-- ============ 选择讲述方式：只决定怎么聊，不提前归类故事 ============ -->
  <block wx:if="{{stage === 'choose'}}">
    <view class="mode-picker">
      <view class="mode-intro">
        <image
          class="mode-avatar"
          src="/assets/illustrations/xiaoyi-avatar.png"
          mode="aspectFit"
          aria-label="小忆"
        ></image>
        <view class="mode-eyebrow typewriter">拾起这一刻</view>
        <view class="mode-title serif">你想怎么开始？</view>
        <view class="mode-note">无论选哪一种，小忆都会先听你讲。聊完以后，再决定放进哪个故事。</view>
      </view>

      <view class="mode-grid">
        <button
          class="mode-choice {{memoryType === 'note' ? 'mode-choice-on' : ''}}"
          data-type="note"
          bindtap="chooseType"
          hover-class="none"
          aria-label="选择随手记，先留下几句话"
        >
          <view class="mode-seal typewriter">记</view>
          <view class="mode-choice-copy">
            <view class="mode-choice-title typewriter">随手记</view>
            <view class="mode-choice-note">
              <text>先留下几句话</text>
              <text>以后再慢慢补充</text>
            </view>
          </view>
          <view class="mode-check">{{memoryType === 'note' ? '✓' : ''}}</view>
        </button>

        <button
          class="mode-choice {{memoryType === 'memoir' ? 'mode-choice-on' : ''}}"
          data-type="memoir"
          bindtap="chooseType"
          hover-class="none"
          aria-label="选择回忆录，和小忆多聊几轮"
        >
          <view class="mode-seal mode-seal-memoir typewriter">聊</view>
          <view class="mode-choice-copy">
            <view class="mode-choice-title typewriter">回忆录</view>
            <view class="mode-choice-note">
              <text>和小忆多聊几轮</text>
              <text>把故事慢慢讲开</text>
            </view>
          </view>
          <view class="mode-check">{{memoryType === 'memoir' ? '✓' : ''}}</view>
        </button>
      </view>

      <button
        class="mode-start"
        bindtap="beginInterview"
        hover-class="mode-start-pressed"
        hover-stay-time="100"
      >
        <text>{{memoryType === 'note' ? '开始随手记' : '开始聊回忆'}}</text>
        <text class="mode-start-arrow">→</text>
      </button>
    </view>
  </block>

  <!-- ============ 对话 ============ -->
  <block wx:elif="{{stage === 'chat'}}">
    <scroll-view
      class="chat-scroll"
      scroll-y
      scroll-with-animation
      scroll-into-view="{{scrollIntoView}}"
    >
      <view class="chat-inner">
        <view class="capture-result" wx:for="{{captureReceipts}}" wx:key="id">
          <view>{{item.status === 'saved' ? '已保存为记忆' : item.status === 'processing' ? '正在整理，原件已保存' : item.status === 'uncertain' ? '整理未完成，原件已保留' : '素材已保存，等待整理'}}</view>
          <view wx:if="{{item.draft}}">{{item.draft.title}}</view>
          <view wx:if="{{item.message}}">{{item.message}}</view>
          <view class="capture-actions">
            <view wx:if="{{item.memoryId}}" data-id="{{item.memoryId}}" bindtap="openCapturedMemory">打开记忆</view>
            <view wx:if="{{item.status === 'received' || item.status === 'ready'}}" data-id="{{item.id}}" bindtap="continueCapture">继续整理</view>
            <view wx:if="{{item.status === 'uncertain'}}" data-id="{{item.id}}" data-original="{{true}}" bindtap="continueCapture">先保存原件</view>
            <view data-id="{{item.id}}" bindtap="toggleCaptureSource">{{captureExpandedId === item.id ? '收起来源' : '查看来源'}}</view>
          </view>
          <view wx:if="{{captureExpandedId === item.id}}">
            <view wx:if="{{item.text}}">原文字：{{item.text}}</view>
            <scroll-view scroll-x class="capture-files"><image class="capture-file" wx:for="{{capturePhotoPaths}}" wx:for-item="photo" wx:key="*this" src="{{photo}}" mode="aspectFill" data-url="{{photo}}" bindtap="previewCapturedPhoto"/></scroll-view>
            <view wx:for="{{item.audio}}" wx:for-item="audio" wx:key="id" data-id="{{item.id}}" data-fileid="{{audio.id}}" bindtap="playCapturedAudio">播放原录音：{{audio.name}}</view>
            <view wx:for="{{item.evidence}}" wx:for-item="source" wx:key="sourceId">{{source.kind === 'image-description' ? '图片描述（AI）' : source.kind === 'transcript' ? '录音转写（请核对）' : '用户原文'}}：{{source.text}}</view>
            <view wx:if="{{item.draft}}">整理稿：{{item.draft.body}}</view>
          </view>
        </view>
        <block wx:for="{{messages}}" wx:key="id">
          <!-- 追问：单独的卡片，和普通气泡区分开 -->
          <view class="ask-card" wx:if="{{item.kind === 'followup'}}" id="{{item.id}}">
            <text class="ask-label">{{item.label}}</text>
            <view class="ask-text serif">{{item.text}}</view>
          </view>

          <view class="row row-me" wx:elif="{{item.kind === 'answer'}}" id="{{item.id}}">
            <view class="bubble bubble-me serif">{{item.text}}</view>
          </view>

          <view class="row row-ai" wx:else id="{{item.id}}">
            <image
              class="ai-mark"
              src="/assets/illustrations/xiaoyi-avatar.png"
              mode="aspectFit"
              aria-label="小忆"
            ></image>
            <view class="bubble bubble-ai serif">{{item.text}}</view>
          </view>
        </block>

        <view class="row row-ai" wx:if="{{asking}}">
          <image
            class="ai-mark"
            src="/assets/illustrations/xiaoyi-avatar.png"
            mode="aspectFit"
            aria-label="小忆"
          ></image>
          <view class="bubble bubble-ai"><generation-status text="小忆正在想下一句…" /></view>
        </view>

        <view class="scroll-tail"></view>
      </view>
    </scroll-view>

    <view class="composer">
      <view wx:if="{{captureError}}" class="capture-error">{{captureError}}</view>
      <view wx:if="{{captureRecording}}" class="capture-actions"><text>正在录音（最长10分钟）</text><view bindtap="stopCaptureRecording">结束录音</view></view>
      <view wx:if="{{captureDraft}}" class="capture-draft">
        <view class="capture-actions"><text>发送后整理为新记忆，原件保留</text><view wx:if="{{!captureEntry && !captureDraft.photoIds.length && !captureDraft.audio.length && !captureDraft.text && !captureDraft.submitted}}" bindtap="cancelEmptyCapture">返回聊天</view></view>
        <scroll-view scroll-x class="capture-files">
          <view class="capture-file" wx:for="{{captureDraft.photoPaths}}" wx:key="*this"><image src="{{item}}" mode="aspectFill"/><view data-kind="photo" data-index="{{index}}" bindtap="removeCaptureFile">移除</view></view>
          <view class="capture-file" wx:for="{{captureDraft.audio}}" wx:key="id"><text>{{item.name}}</text><view data-kind="audio" data-index="{{index}}" bindtap="removeCaptureFile">移除</view></view>
        </scroll-view>
        <view wx:if="{{captureDraft.text}}">已加入文字素材</view>
        <view wx:if="{{captureBusy}}">正在保存与整理…</view>
      </view>
      <view class="input-row">
        <textarea
          class="input-field"
          value="{{inputText}}"
          placeholder="想到什么说什么"
          placeholder-class="input-placeholder"
          maxlength="{{-1}}"
          auto-height
          fixed="{{true}}"
          adjust-position="{{false}}"
          show-confirm-bar="{{false}}"
          cursor-spacing="24"
          disabled="{{importing || captureBusy || captureDraft.submitted}}"
          bindinput="onInput"
          bindkeyboardheightchange="onKeyboardHeightChange"
        ></textarea>
        <view class="send-btn" bindtap="send" role="button" aria-label="{{asking ? '小忆正在回应' : '发送'}}" aria-disabled="{{asking || organizing || importing || saving}}">
          <text class="send-arrow">→</text>
        </view>
      </view>

      <generation-status wx:if="{{organizing}}" text="正在把刚才的对话整理成片段…" />
      <view class="tool-row">
        <view class="tool-chip {{importing ? 'tool-chip-off' : ''}}" bindtap="importMemory">{{importing ? '正在导入…' : captureEntry ? '添加素材' : '导入'}}</view>
        <view class="tool-spacer"></view>
        <view
          wx:if="{{!captureEntry}}"
          class="tidy-btn {{(answers.length === 0 || organizing || asking || importing || saving) ? 'tidy-btn-off' : ''}}"
          bindtap="finish"
        >{{organizing ? '正在整理…' : asking ? '小忆正在回应…' : '整理成片段'}}</view>
      </view>
    </view>

  </block>

  <!-- ============ 整理与保存 ============ -->
  <block wx:elif="{{saved}}">
    <view class="chat-inner">
      <view class="organize-title serif">{{sharedFamilyId ? '故事已提交' : '记忆已保存'}}</view>
      <view class="organize-note">{{saveMessage}}</view>
      <view class="organize-note">{{storageLabel}}</view>
      <button wx:if="{{selectedStoryKey}}" class="btn btn-primary" bindtap="continueToChapter">继续选择章节</button>
      <button class="btn btn-ghost" bindtap="viewSavedMemory">查看这段记忆</button>
      <button class="btn btn-ghost" bindtap="leaveSavedMemory">返回</button>
    </view>
  </block>
  <block wx:elif="{{stage === 'save'}}">
    <scroll-view class="chat-scroll" scroll-y>
      <view class="chat-inner">
        <textarea
          class="draft-title serif"
          value="{{draftTitle}}"
          placeholder="给这段起个名字"
          placeholder-class="input-placeholder"
          auto-height
          fixed="{{true}}"
          adjust-position="{{false}}"
          show-confirm-bar="{{false}}"
          bindinput="onTitleInput"
          bindkeyboardheightchange="onKeyboardHeightChange"
        ></textarea>

        <view class="draft-meta">
          <text class="meta-date">{{dateLabel}}</text>
          <text class="meta-chip" wx:for="{{coveredChips}}" wx:key="*this" wx:for-item="chip">{{chip}}</text>
        </view>

        <view class="draft-summary" wx:if="{{draftSummary}}">
          {{draftSummary}}
        </view>
        <view class="import-ai-label" wx:if="{{draftAiLabel}}">{{draftAiLabel}}</view>

        <view class="draft-tags" wx:if="{{draftEmotions.length || draftPeople.length || draftPlaces.length}}">
          <text class="draft-tag draft-tag-emotion" wx:for="{{draftEmotions}}" wx:key="*this" wx:for-item="tag">情绪 {{tag}}</text>
          <text class="draft-tag" wx:for="{{draftPeople}}" wx:key="*this" wx:for-item="tag">人物 {{tag}}</text>
          <text class="draft-tag draft-tag-place" wx:for="{{draftPlaces}}" wx:key="*this" wx:for-item="tag">地点 {{tag}}</text>
        </view>

        <view class="draft-rule"></view>

        <view class="draft-field-wrap">
          <textarea
            class="draft-field serif"
            maxlength="500"
            value="{{draftText}}"
            auto-height
            fixed="{{true}}"
            adjust-position="{{false}}"
            show-confirm-bar="{{false}}"
            cursor-spacing="24"
            bindinput="onDraftInput"
            bindkeyboardheightchange="onKeyboardHeightChange"
          ></textarea>
          <button class="xiaoyi-entry" bindtap="openXiaoyi" disabled="{{saving || saved}}" aria-label="小忆">
            <image class="xiaoyi-entry-avatar" src="/assets/illustrations/xiaoyi-avatar.png" mode="aspectFill" aria-hidden="true" />
          </button>
        </view>
        <view class="draft-count {{tooLong ? 'draft-count-over' : ''}}">
          {{draftLength}} / 500 字{{tooLong ? '　超出部分请先删掉' : ''}}
        </view>

        <view wx:if="{{xiaoyiOpen}}" class="xiaoyi-panel">
          <view class="xiaoyi-head">
            <view>
              <view class="xiaoyi-title">小忆在这里</view>
              <view class="xiaoyi-context">正在看：{{xiaoyiContextPreview}}</view>
            </view>
            <button class="xiaoyi-close" bindtap="closeXiaoyi" disabled="{{xiaoyiLoading}}">关掉</button>
          </view>
          <view class="xiaoyi-options">
            <button class="xiaoyi-option" data-mode="ask" bindtap="askXiaoyiQuestion" disabled="{{xiaoyiLoading}}">问我一个问题</button>
            <button class="xiaoyi-option" data-mode="compose" bindtap="organizeXiaoyiAnswer" disabled="{{xiaoyiLoading}}">写成一段</button>
          </view>
          <scroll-view class="xiaoyi-thread" scroll-y wx:if="{{xiaoyiMessages.length}}">
            <view class="xiaoyi-message xiaoyi-message-{{item.kind}}" wx:for="{{xiaoyiMessages}}" wx:key="id" selectable>
              <view class="xiaoyi-message-label" wx:if="{{item.label}}">{{item.label}}</view>
              <view>{{item.text}}</view>
            </view>
          </scroll-view>
          <textarea class="xiaoyi-answer" hold-keyboard="{{true}}" disabled="{{xiaoyiLoading}}" value="{{xiaoyiAnswer}}" maxlength="500" auto-height fixed="{{true}}" adjust-position="{{false}}" show-confirm-bar="{{false}}" placeholder="把刚想起来的事说给小忆听…" bindinput="onXiaoyiAnswerInput" bindkeyboardheightchange="onKeyboardHeightChange"></textarea>
          <view class="xiaoyi-message-label">这次怎么写（可不填）</view>
          <textarea class="xiaoyi-answer" hold-keyboard="{{true}}" disabled="{{xiaoyiLoading}}" value="{{xiaoyiWritingInstruction}}" maxlength="300" auto-height fixed="{{true}}" adjust-position="{{false}}" show-confirm-bar="{{false}}" placeholder="例如：像我平时说话，结尾停在那件小事上" bindinput="onXiaoyiWritingInstruction" bindkeyboardheightchange="onKeyboardHeightChange"></textarea>
          <generation-status wx:if="{{xiaoyiLoading}}" text="{{xiaoyiStatus || '小忆正在整理文字…'}}" />
          <view class="xiaoyi-status" wx:elif="{{xiaoyiStatus}}">{{xiaoyiStatus}}</view>
          <view class="xiaoyi-actions">
            <button class="xiaoyi-action" bindtap="useXiaoyiOriginal" disabled="{{xiaoyiLoading}}">就用我的原话</button>
            <button class="xiaoyi-action" bindtap="organizeXiaoyiAnswer" disabled="{{xiaoyiLoading}}">{{xiaoyiLoading ? '小忆正在处理…' : '整理原话'}}</button>
          </view>
          <view wx:if="{{xiaoyiDraftText}}" class="xiaoyi-draft-box">
            <view class="xiaoyi-message-label">小忆草稿，可以改</view>
            <textarea class="xiaoyi-draft" hold-keyboard="{{true}}" disabled="{{xiaoyiLoading}}" value="{{xiaoyiDraftText}}" maxlength="800" auto-height fixed="{{true}}" adjust-position="{{false}}" show-confirm-bar="{{false}}" bindinput="onXiaoyiDraftInput" bindkeyboardheightchange="onKeyboardHeightChange"></textarea>
            <button class="xiaoyi-action xiaoyi-action-primary" bindtap="useXiaoyiDraft" disabled="{{xiaoyiLoading}}">接到草稿后面</button>
          </view>
        </view>

        <view class="organize-section">
          <view class="organize-title serif">要收进哪个故事？</view>
          <view class="organize-note">不必现在想好。留空就会安全地放进“未整理片段”。</view>

          <view
            class="story-choice {{storyTitle === '' ? 'choice-on' : ''}}"
            bindtap="chooseFragment"
          >
            <view class="choice-mark serif">片</view>
            <view class="choice-copy">
              <text class="choice-title">先存为未整理片段</text>
              <text class="choice-note">以后想清楚了，再把它放进某个故事</text>
            </view>
            <text class="choice-check">{{storyTitle === '' ? '✓' : ''}}</text>
          </view>

          <view class="story-list" wx:if="{{storyOptions.length > 0}}">
            <view
              class="story-chip {{item.selected ? 'story-chip-on' : ''}}"
              wx:for="{{storyOptions}}"
              wx:key="key"
              data-key="{{item.key}}"
              bindtap="chooseStory"
            >{{item.title}} · {{item.chapterCount ? item.chapterCount + '章 · ' : ''}}{{item.count}}段记忆</view>
          </view>

          <input
            class="story-input"
            value="{{storyTitle}}"
            placeholder="或输入一个新故事名，例如：我和外公的雨天"
            placeholder-class="input-placeholder"
            maxlength="30"
            bindinput="onStoryTitleInput"
          />
        </view>

        <view class="organize-section">
          <view class="organize-title serif">这段和谁有关？</view>
          <view class="organize-note">可多选亲友，只用于整理故事，不等于他们能看到。</view>
          <view class="people-grid">
            <view
              class="person-choice {{item.selected ? 'choice-on' : ''}}"
              wx:for="{{relatedOptions}}"
              wx:key="id"
              data-id="{{item.id}}"
              bindtap="toggleRelatedMember"
            >
              <view class="person-avatar serif">{{item.avatarText}}</view>
              <view class="person-copy">
                <text class="person-name">{{item.name}}</text>
                <text class="person-relation">{{item.relation}}</text>
              </view>
              <text class="choice-check">{{item.selected ? '✓' : ''}}</text>
            </view>
          </view>
        </view>

        <view class="organize-section" wx:if="{{!sharedFamilyId}}">
          <view class="organize-title serif">谁可以看？</view>
          <view class="organize-note">仅设置本账号内档案的阅读范围，不会发送微信邀请，也不代表其他微信用户已能访问。</view>

          <view
            class="person-choice {{audienceMemberIds.length === 0 ? 'choice-on' : ''}}"
            bindtap="choosePrivate"
          >
            <view class="person-avatar person-avatar-private serif">私</view>
            <view class="person-copy">
              <text class="person-name">仅自己</text>
              <text class="person-relation">暂时不分享给任何人</text>
            </view>
            <text class="choice-check">{{audienceMemberIds.length === 0 ? '✓' : ''}}</text>
          </view>

          <view class="people-grid">
            <view
              class="person-choice {{item.selected ? 'choice-on' : ''}}"
              wx:for="{{audienceOptions}}"
              wx:key="id"
              data-id="{{item.id}}"
              bindtap="toggleAudienceMember"
            >
              <view class="person-avatar serif">{{item.avatarText}}</view>
              <view class="person-copy">
                <text class="person-name">{{item.name}}</text>
                <text class="person-relation">{{item.relation}} · 可阅读</text>
              </view>
              <text class="choice-check">{{item.selected ? '✓' : ''}}</text>
            </view>
          </view>
        </view>

        <view class="scroll-tail"></view>
      </view>
    </scroll-view>

    <view class="composer">
      <view wx:if="{{saveError}}" class="organize-note">{{saveError}}</view>
      <view class="save-row">
        <button class="btn btn-ghost save-back" bindtap="backToChat">继续编辑</button>
        <button
          class="btn btn-primary save-go {{(saving || tooLong) ? 'btn-disabled' : ''}}"
          bindtap="save"
          disabled="{{saving || tooLong}}"
        >{{saving ? '正在保存…' : (sharedFamilyId ? '提交给主人确认' : selectedStoryKey ? '保存并选择章节' : '保存这段记忆')}}</button>
      </view>
    </view>
  </block>
</view>
