<view class="interview-page" style="bottom: {{keyboardHeight}}px">

  <view class="who-bar">
    <view class="who-copy">
      <text class="who-name">{{memberName}} · {{memberRelation}}</text>
      <text class="who-note" wx:if="{{isPersonal}}">人生之书 · 我讲自己的往事</text>
      <text class="who-note" wx:else>记忆之家 · 我讲和家人的共同经历</text>
    </view>
    <text class="tag {{isPersonal ? 'tag-apricot' : 'tag-lake'}}">
      <text class="tag-mark">{{isPersonal ? '我' : '家'}}</text>{{isPersonal ? '我的故事' : '共同记忆'}}
    </text>
  </view>

  <!-- ============ 对话 ============ -->
  <block wx:if="{{stage === 'chat'}}">
    <scroll-view
      class="chat-scroll"
      scroll-y
      scroll-with-animation
      scroll-into-view="{{scrollIntoView}}"
    >
      <view class="chat-inner">
        <view class="source-note" wx:if="{{localDemoOnly}}">
          未连云端，以下追问来自本地提问规则，不是 AI 生成。
        </view>

        <block wx:for="{{messages}}" wx:key="id">
          <!-- 追问：单独的卡片，和普通气泡区分开 -->
          <view class="ask-card" wx:if="{{item.kind === 'followup'}}" id="{{item.id}}">
            <text class="ask-label">{{item.label}}</text>
            <view class="ask-text serif">{{item.text}}</view>
          </view>

          <view class="row row-me" wx:elif="{{item.kind === 'answer'}}" id="{{item.id}}">
            <view class="bubble bubble-me serif">{{item.text}}</view>
          </view>

          <view class="row row-ai" wx:else id="{{item.id}}">
            <view class="ai-mark serif">问</view>
            <view class="bubble bubble-ai serif">{{item.text}}</view>
          </view>
        </block>

        <view class="row row-ai" wx:if="{{asking}}">
          <view class="ai-mark serif">问</view>
          <view class="bubble bubble-ai typing">
            <text class="dot"></text><text class="dot"></text><text class="dot"></text>
          </view>
        </view>

        <view class="scroll-tail"></view>
      </view>
    </scroll-view>

    <view class="composer">
      <view class="input-row">
        <textarea
          class="input-field"
          value="{{inputText}}"
          placeholder="想到什么说什么"
          placeholder-class="input-placeholder"
          maxlength="{{-1}}"
          auto-height
          fixed="{{true}}"
          adjust-position="{{false}}"
          show-confirm-bar="{{false}}"
          cursor-spacing="24"
          bindinput="onInput"
          bindkeyboardheightchange="onKeyboardHeightChange"
        ></textarea>
        <view class="send-btn" bindtap="send">
          <text class="send-arrow">→</text>
        </view>
      </view>

      <view class="tool-row">
        <view class="tool-chip tool-chip-off" bindtap="notYet">照片 · 赛后接入</view>
        <view class="tool-chip tool-chip-off" bindtap="notYet">语音 · 赛后接入</view>
        <view class="tool-spacer"></view>
        <view
          class="tidy-btn {{answers.length === 0 ? 'tidy-btn-off' : ''}}"
          bindtap="finish"
        >整理成片段</view>
      </view>
    </view>
  </block>

  <!-- ============ 整理与保存 ============ -->
  <block wx:else>
    <scroll-view class="chat-scroll" scroll-y>
      <view class="chat-inner">
        <text class="tidy-label">
          {{localDemoOnly ? '本地演示整理 · 保留你说的原话' : 'AI 云整理 · 需要复核'}}
        </text>

        <textarea
          class="draft-title serif"
          value="{{draftTitle}}"
          placeholder="给这段起个名字"
          placeholder-class="input-placeholder"
          auto-height
          fixed="{{true}}"
          adjust-position="{{false}}"
          show-confirm-bar="{{false}}"
          bindinput="onTitleInput"
          bindkeyboardheightchange="onKeyboardHeightChange"
        ></textarea>

        <view class="draft-meta">
          <text class="meta-date">{{dateLabel}}</text>
          <text
            class="meta-type {{memoryType === 'note' ? 'meta-type-on' : ''}}"
            data-type="note"
            bindtap="chooseType"
          >随手记</text>
          <text
            class="meta-type {{memoryType === 'memoir' ? 'meta-type-on' : ''}}"
            data-type="memoir"
            bindtap="chooseType"
          >回忆录</text>
          <text class="meta-chip" wx:for="{{coveredChips}}" wx:key="*this" wx:for-item="chip">{{chip}}</text>
        </view>

        <view class="draft-rule"></view>

        <textarea
          class="draft-field serif"
          value="{{draftText}}"
          auto-height
          fixed="{{true}}"
          adjust-position="{{false}}"
          show-confirm-bar="{{false}}"
          cursor-spacing="24"
          bindinput="onDraftInput"
          bindkeyboardheightchange="onKeyboardHeightChange"
        ></textarea>
        <view class="draft-count {{tooLong ? 'draft-count-over' : ''}}">
          {{draftLength}} / 500 字{{tooLong ? '　超出部分请先删掉' : ''}}
        </view>

        <view class="draft-rule"></view>
        <view class="draft-hint">
          {{isPersonal ? '保存后只进入我的人生之书' : '保存后只进入记忆之家'}} · {{memoryType === 'note' ? '随手记' : '回忆录'}}
        </view>

        <!-- 两个入口的去向固定，避免把个人传记与家庭共同记忆再次混在一起。 -->
        <view class="share-row share-row-on">
          <view class="share-copy">
            <text class="share-title">{{isPersonal ? '这是我的人生故事' : '这是我们的家庭记忆'}}</text>
            <text class="share-note" wx:if="{{isPersonal}}">
              只属于当前用户，不会出现在记忆之家。
            </text>
            <text class="share-note" wx:else>
              确认后家人能看见，但不会写进任何人的人生之书。
            </text>
          </view>
          <text class="share-action">去向已确定 ✓</text>
        </view>

        <view class="scroll-tail"></view>
      </view>
    </scroll-view>

    <view class="composer">
      <view class="save-row">
        <button class="btn btn-ghost save-back" bindtap="backToChat">继续编辑</button>
        <button
          class="btn btn-primary save-go {{(saving || tooLong) ? 'btn-disabled' : ''}}"
          bindtap="save"
        >{{saving ? '正在保存…' : (isPersonal ? '保存到我的书' : '保存到记忆之家')}}</button>
      </view>
    </view>
  </block>
</view>
