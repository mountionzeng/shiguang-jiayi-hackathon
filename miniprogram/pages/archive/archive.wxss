.archive-page {
  position: relative;
  min-height: 100vh;
  padding: 48rpx 44rpx calc(72rpx + env(safe-area-inset-bottom));
  background: #fbf8f1;
}

.archive-paper {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.7;
  pointer-events: none;
}

.archive-heading,
.archive-tabs,
.note-list,
.archive-empty,
.archive-version-note {
  position: relative;
  z-index: 1;
}

.archive-eyebrow {
  color: var(--jade);
  font-size: 23rpx;
  letter-spacing: 3rpx;
}

.archive-title {
  margin-top: 10rpx;
  color: var(--ink);
  font-size: 52rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.archive-intro {
  max-width: 590rpx;
  margin-top: 14rpx;
  color: var(--ink-faint);
  font-size: 26rpx;
  line-height: 1.7;
}

.archive-tabs {
  display: flex;
  gap: 14rpx;
  margin-top: 42rpx;
}

.archive-tab {
  display: flex;
  align-items: center;
  min-height: 74rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 2rpx solid rgba(129, 117, 93, 0.16);
  border-radius: 38rpx;
  background: rgba(255, 253, 247, 0.58);
  color: var(--ink-faint);
  line-height: 1;
}

.archive-tab::after { border: 0; }

.archive-tab:active { transform: translateY(2rpx) scale(0.97); }

.archive-tab-current {
  background: rgba(229, 239, 233, 0.78);
  color: var(--jade);
  box-shadow: inset 0 0 0 2rpx rgba(79, 127, 107, 0.12);
}

.archive-tab-title {
  font-size: 29rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.archive-tab-count {
  min-width: 34rpx;
  margin-left: 12rpx;
  color: rgba(79, 127, 107, 0.72);
  font-size: 23rpx;
  text-align: center;
}

.note-list {
  margin-top: 28rpx;
}

.note-swipe {
  position: relative;
  overflow: hidden;
}

.note-swipe + .note-swipe {
  margin-top: 20rpx;
}

.note-delete {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 116rpx;
  margin: 0;
  padding: 0 10rpx 0 0;
  background: transparent;
  color: #fff;
  line-height: 1;
}

.note-delete::after { border: 0; }

.note-delete-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #cf5146;
  box-shadow: 0 10rpx 20rpx rgba(173, 61, 50, 0.18);
}

.note-trash {
  position: relative;
  width: 34rpx;
  height: 38rpx;
}

.note-trash-lid {
  position: absolute;
  top: 2rpx;
  left: 4rpx;
  width: 26rpx;
  height: 6rpx;
  border-radius: 5rpx;
  background: #fffefb;
}

.note-trash-lid::before {
  position: absolute;
  top: -5rpx;
  left: 8rpx;
  width: 10rpx;
  height: 5rpx;
  border-radius: 5rpx 5rpx 0 0;
  background: #fffefb;
  content: "";
}

.note-trash-can {
  position: absolute;
  right: 5rpx;
  bottom: 1rpx;
  left: 5rpx;
  height: 27rpx;
  border: 4rpx solid #fffefb;
  border-top: 0;
  border-radius: 0 0 5rpx 5rpx;
}

.note-trash-can::before,
.note-trash-can::after {
  position: absolute;
  top: 5rpx;
  bottom: 5rpx;
  width: 3rpx;
  border-radius: 3rpx;
  background: #fffefb;
  content: "";
}

.note-trash-can::before {
  left: 6rpx;
}

.note-trash-can::after {
  right: 6rpx;
}

.note-paper {
  position: relative;
  z-index: 1;
  padding: 30rpx 30rpx 26rpx 36rpx;
  border: 2rpx solid rgba(129, 117, 93, 0.1);
  border-radius: 8rpx 22rpx 16rpx 10rpx;
  background: rgba(255, 254, 251, 0.96);
  box-shadow: 6rpx 10rpx 24rpx rgba(63, 66, 60, 0.05);
  transition: transform 180ms ease;
}

.note-paper-open {
  transform: translateX(-116rpx);
}

.note-swipe:nth-child(even) .note-paper {
  transform: rotate(-0.35deg);
}

.note-swipe:nth-child(even) .note-paper-open {
  transform: translateX(-116rpx) rotate(-0.35deg);
}

.note-pin {
  position: absolute;
  top: 28rpx;
  left: 16rpx;
  width: 6rpx;
  height: 52rpx;
  border-radius: 6rpx;
  background: rgba(79, 127, 107, 0.46);
}

.note-date {
  color: var(--ink-faint);
  font-size: 21rpx;
}

.note-title {
  margin-top: 8rpx;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.45;
}

.note-excerpt {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 9rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
  line-height: 1.7;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.note-archive {
  margin-top: 18rpx;
  color: var(--jade);
  font-size: 22rpx;
}

.archive-empty {
  margin-top: 30rpx;
  padding: 58rpx 34rpx;
  border-radius: 28rpx;
  background: rgba(245, 239, 225, 0.68);
  text-align: center;
}

.archive-empty-title {
  color: var(--ink);
  font-size: 36rpx;
  font-weight: 600;
}

.archive-empty-note {
  margin-top: 10rpx;
  color: var(--ink-faint);
  font-size: 25rpx;
  line-height: 1.7;
}

.archive-version-note {
  margin-top: 34rpx;
  color: rgba(106, 110, 104, 0.78);
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}
