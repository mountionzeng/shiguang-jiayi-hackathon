.archive-page {
  position: relative;
  min-height: 100vh;
  padding: 48rpx 44rpx calc(72rpx + env(safe-area-inset-bottom));
  background: #fbf8f1;
}

.archive-paper {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.7;
  pointer-events: none;
}

.archive-heading,
.archive-tabs,
.note-list,
.archive-empty,
.archive-version-note {
  position: relative;
  z-index: 1;
}

.archive-eyebrow {
  color: var(--jade);
  font-size: 23rpx;
  letter-spacing: 3rpx;
}

.archive-title {
  margin-top: 10rpx;
  color: var(--ink);
  font-size: 52rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.archive-intro {
  max-width: 590rpx;
  margin-top: 14rpx;
  color: var(--ink-faint);
  font-size: 26rpx;
  line-height: 1.7;
}

.archive-tabs {
  display: flex;
  margin-top: 42rpx;
}

.archive-tab {
  display: flex;
  align-items: center;
  min-height: 74rpx;
  padding: 0 24rpx;
  border-radius: 38rpx;
}

.archive-tab-current {
  background: rgba(229, 239, 233, 0.78);
  color: var(--jade);
  box-shadow: inset 0 0 0 2rpx rgba(79, 127, 107, 0.12);
}

.archive-tab-title {
  font-size: 29rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.archive-tab-count {
  min-width: 34rpx;
  margin-left: 12rpx;
  color: rgba(79, 127, 107, 0.72);
  font-size: 23rpx;
  text-align: center;
}

.note-list {
  margin-top: 28rpx;
}

.note-paper {
  position: relative;
  padding: 30rpx 30rpx 26rpx 36rpx;
  border: 2rpx solid rgba(129, 117, 93, 0.14);
  border-radius: 8rpx 22rpx 16rpx 10rpx;
  background: rgba(255, 253, 247, 0.84);
  box-shadow: 8rpx 12rpx 28rpx rgba(63, 66, 60, 0.06);
}

.note-paper + .note-paper {
  margin-top: 20rpx;
}

.note-paper:nth-child(even) {
  transform: rotate(-0.35deg);
}

.note-pin {
  position: absolute;
  top: 28rpx;
  left: 16rpx;
  width: 6rpx;
  height: 52rpx;
  border-radius: 6rpx;
  background: rgba(79, 127, 107, 0.46);
}

.note-date {
  color: var(--ink-faint);
  font-size: 21rpx;
}

.note-title {
  margin-top: 8rpx;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.45;
}

.note-excerpt {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 9rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
  line-height: 1.7;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.note-archive {
  margin-top: 18rpx;
  color: var(--jade);
  font-size: 22rpx;
}

.archive-empty {
  margin-top: 30rpx;
  padding: 58rpx 34rpx;
  border-radius: 28rpx;
  background: rgba(245, 239, 225, 0.68);
  text-align: center;
}

.archive-empty-title {
  color: var(--ink);
  font-size: 36rpx;
  font-weight: 600;
}

.archive-empty-note {
  margin-top: 10rpx;
  color: var(--ink-faint);
  font-size: 25rpx;
  line-height: 1.7;
}

.archive-version-note {
  margin-top: 34rpx;
  color: rgba(106, 110, 104, 0.78);
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}
