:host {
  display: block;
}

.intro-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(42, 46, 43, 0.5);
}

.intro-card {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 86vh;
  padding: 48rpx 40rpx 40rpx;
  border-radius: 28rpx;
  background: var(--paper-card);
  box-shadow: 0 16rpx 56rpx rgba(42, 46, 43, 0.18);
  overflow-y: auto;
  box-sizing: border-box;
}

.intro-invite {
  display: flex;
  flex-direction: column;
  margin-bottom: 32rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: var(--apricot-soft);
}

.intro-invite-heading {
  color: var(--ink);
  font-size: 32rpx;
  line-height: 1.5;
}

.intro-invite-message {
  margin-top: 12rpx;
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.7;
}

.intro-invite-detail {
  margin-top: 12rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
  line-height: 1.7;
}

.intro-title {
  color: var(--ink);
  font-size: 40rpx;
  line-height: 1.4;
}

.intro-lead {
  margin-top: 16rpx;
  color: var(--ink-soft);
  font-size: 28rpx;
  line-height: 1.7;
}

.intro-points {
  margin-top: 24rpx;
}

.intro-point {
  display: flex;
  margin-top: 16rpx;
}

.intro-dot {
  flex: none;
  width: 28rpx;
  color: var(--jade);
  font-size: 28rpx;
  line-height: 1.7;
}

.intro-point-text {
  flex: 1;
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.7;
}

.intro-button {
  margin-top: 40rpx;
  min-height: 88rpx;
  border-radius: 44rpx;
  background: var(--jade);
  color: #fff;
  font-size: 30rpx;
  line-height: 88rpx;
}
