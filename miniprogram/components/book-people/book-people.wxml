<view class="sharing-page people-page">
  <view class="eyebrow">{{title}}</view>
  <block wx:if="{{!detail}}">
    <view class="heading serif">文章阅读权限</view>
    <view class="intro">选择谁可以阅读这本书的哪些章节。</view>
    <view class="caption" wx:if="{{loading}}">正在核对人物与权限…</view>
    <view class="notice" wx:if="{{notice}}">{{notice}}</view>
    <view class="people-list">
      <button class="person-row" wx:for="{{people}}" wx:key="key" data-key="{{item.key}}" bindtap="openPerson" disabled="{{!ready || busy}}" aria-label="{{item.name}}，{{item.label}}，查看资料与章节权限">
        <view class="person-avatar serif">{{item.avatar}}</view>
        <view class="person-copy"><view class="person-name serif">{{item.name}}<text class="person-relation">{{item.relation}}</text></view><view class="caption">{{item.label}}</view></view>
        <text class="chevron">›</text>
      </button>
    </view>
    <view class="empty intro" wx:if="{{ready && !people.length}}">这本书还没有关联的人物。可以先邀请一位家人或朋友。</view>
    <button class="primary" bindtap="addPerson" disabled="{{!ready || loading || busy}}">邀请一位亲友</button>
    <view class="caption">出现在故事里，不代表能读原稿。只有本人接受邀请后，选中的章节才会开放。</view>
    <button class="text-action" bindtap="refresh" disabled="{{loading || busy}}">刷新加入状态</button>
  </block>
  <block wx:else>
    <button class="text-action back" bindtap="back" disabled="{{busy}}">‹ 全部人物</button>
    <view class="heading serif">{{isNew ? '邀请一位亲友' : name}}</view>
    <view class="notice" wx:if="{{notice}}">{{notice}}</view>
    <block wx:if="{{editing}}">
      <picker wx:if="{{isNew && candidates.length}}" range="{{candidates}}" range-key="name" bindchange="chooseExisting" disabled="{{busy}}"><view class="text-action existing-choice">从已有的人物中选择 ›</view></picker>
      <label class="field-label">称呼<input class="name-input" value="{{name}}" bindinput="enterName" maxlength="12" disabled="{{busy}}" placeholder="例如：小岚"/></label>
      <label class="field-label">关系<input class="name-input" value="{{relation}}" bindinput="enterRelation" maxlength="12" disabled="{{busy}}" placeholder="例如：朋友"/></label>
      <view class="caption" wx:if="{{!isNew}}">这份人物资料在你的其他故事中也会同步更新，已有授权不变。</view>
      <button wx:if="{{!isNew}}" class="primary" bindtap="savePerson" loading="{{busy}}" disabled="{{busy}}">保存人物资料</button>
    </block>
    <view wx:else class="person-summary"><text class="intro">{{relation || '家人'}}{{isOwner ? ' · 主笔' : ''}}</text><button wx:if="{{memberId}}" class="text-action" bindtap="editPerson" disabled="{{busy}}">编辑资料</button></view>
    <view class="intro" wx:if="{{isOwner}}">你是主笔，可以管理整本书，无需邀请自己。</view>
    <block wx:elif="{{!editing || isNew}}">
      <view class="record-options" wx:if="{{records.length > 1}}"><button class="record-choice {{selectedInvitationId === item.id ? 'selected' : ''}}" wx:for="{{records}}" wx:key="id" data-id="{{item.id}}" bindtap="selectRecord" disabled="{{busy}}">邀请 {{index + 1}} · {{item.label}}</button></view>
      <view class="section-title serif">{{pending ? '邀请中的章节' : '可以阅读的章节'}}</view>
      <view class="caption">新增章节不会自动开放。{{pending ? '修改这份邀请需要先撤销，再重新选择。' : '勾选后保存，权限才会生效。'}}</view>
      <checkbox-group bindchange="chooseChapters"><label class="chapter-choice" wx:for="{{chapters}}" wx:key="id"><checkbox value="{{item.id}}" checked="{{item.checked}}" disabled="{{busy || pending}}" color="#4f7f6b"/><text>{{item.title || '未命名章节'}}</text></label></checkbox-group>
      <view wx:if="{{!chapters.length}}" class="intro">先回到书里保存一个章节，再来邀请。</view>
      <view class="permission" wx:if="{{copyAvailable}}"><text>允许保留副本、扩写和回信</text><switch checked="{{copy}}" bindchange="chooseCopy" disabled="{{busy || pending}}" color="#4f7f6b"/></view>
      <view class="caption">扩写留在对方自己的故事里，回信由你决定是否收进原稿。已保留的副本不会因撤销邀请而删除。</view>
      <button wx:if="{{!pending && !inactive}}" class="primary" bindtap="saveAccess" loading="{{busy}}" disabled="{{busy || !chapters.length}}">{{active ? '保存章节权限' : '生成邀请'}}</button>
      <button wx:if="{{shareReady}}" class="primary" open-type="share" disabled="{{busy}}">把邀请发给本人</button>
      <view wx:if="{{pending && !shareReady}}" class="intro">等待本人接受。离开页面后邀请链接不会保留；需要重发时，请先撤销这份邀请。</view>
      <view wx:if="{{inactive}}" class="intro">这份邀请的授权已关闭。请先撤销旧邀请，再生成新的邀请。</view>
      <button wx:if="{{pending || active || inactive}}" class="text-action danger" bindtap="revoke" disabled="{{busy}}">撤销邀请</button>
    </block>
  </block>
</view>
