.sharing-page{padding:64rpx 40rpx 100rpx;background:var(--paper);min-height:100vh}.eyebrow{color:var(--jade);font-size:24rpx;letter-spacing:3rpx}.heading{font-size:50rpx;line-height:1.4;margin:24rpx 0}.intro,.caption{color:var(--ink-soft);line-height:1.8}.intro{font-size:28rpx}.caption{font-size:24rpx;margin:12rpx 0}.section-title{font-size:36rpx;line-height:1.5;margin:48rpx 0 16rpx;overflow-wrap:break-word}.chapter-choice{display:flex;align-items:center;gap:20rpx;min-height:100rpx;border-bottom:1rpx solid var(--line)}.chapter-choice text{flex:1;overflow-wrap:break-word}.permission{display:flex;align-items:center;justify-content:space-between;gap:24rpx;padding:22rpx 0;font-size:27rpx;border-bottom:1rpx solid var(--line)}.permission>text:first-child{flex:1}.muted{color:var(--ink-soft)}.primary,.secondary{min-height:88rpx;display:flex;align-items:center;justify-content:center;padding:18rpx 26rpx;border-radius:14rpx;font-size:29rpx;margin-top:24rpx;transition:opacity .15s}.primary{background:var(--jade);color:#fff}.secondary{border:1rpx solid var(--jade);color:var(--jade)}button[disabled]{opacity:.5}.actions{display:flex;gap:20rpx}.actions button{flex:1}.notice{padding:24rpx;margin:24rpx 0;background:var(--apricot-soft);color:#684c3c;font-size:28rpx;line-height:1.7}.invitation{margin-top:24rpx;border-top:2rpx solid var(--line)}.applicant{padding:24rpx 0;border-bottom:1rpx solid var(--line)}.small{padding:14rpx;min-height:80rpx}.danger{color:#9b4637}.name-input{border-bottom:1rpx solid var(--jade);height:100rpx;margin:28rpx 0}.verification-code{font:44rpx/1.8 monospace;letter-spacing:8rpx;margin:30rpx 0;color:var(--jade)}.refresh{margin-top:48rpx}.paragraph{display:block;white-space:pre-wrap;overflow-wrap:break-word;font-size:34rpx;line-height:1.95;margin:24rpx 0}.reading-chapter{padding-bottom:24rpx;border-bottom:1rpx solid var(--line)}

.relation-row { display: flex; align-items: center; gap: 12rpx; margin: 12rpx 0 8rpx; }
.relation-chip { flex: none; margin: 0; padding: 0 28rpx; min-height: 64rpx; line-height: 64rpx; border: 1rpx solid rgba(79,127,107,.35); border-radius: 32rpx; background: transparent; color: #4f7f6b; font-size: 26rpx; }
.relation-chip::after { border: 0; }
.relation-on { background: #4f7f6b; color: #fffefb; }
.relation-input { flex: 1; min-width: 0; margin: 0; }

/* Override the native v2 button sizing; the whole row is the touch target. */
.people-page button.person-row{width:100%;max-width:none;box-sizing:border-box;margin:0;background:transparent}
.people-page button.person-row[disabled]{background:transparent;color:var(--ink);opacity:1}
.people-page button.primary{width:100%;box-sizing:border-box;background:var(--jade);color:#fff}
.people-page button.primary[disabled]{background:var(--jade);color:#fff;opacity:.5}
.person-name{color:var(--ink)}.person-row .person-avatar{font-size:23rpx}
.people-page{box-sizing:border-box;padding-top:40rpx}.eyebrow{overflow-wrap:break-word}.people-list{margin:36rpx 0}.person-row{display:flex;align-items:center;gap:22rpx;text-align:left;background:transparent;border-radius:0;border-bottom:1rpx solid var(--line);padding:28rpx 0;min-height:128rpx;color:var(--ink);line-height:1.5}.person-row::after,.text-action::after{border:0}.person-row[disabled]{opacity:1;color:var(--ink)}.person-avatar{width:80rpx;height:80rpx;flex:none;line-height:80rpx;text-align:center;font-size:26rpx;white-space:nowrap;overflow:hidden;border-radius:50%;background:var(--jade-soft);color:var(--jade)}.person-copy{flex:1;min-width:0}.person-name{font-size:34rpx;overflow-wrap:break-word}.person-relation{font-size:24rpx;color:var(--ink-soft);margin-left:18rpx}.person-copy .caption{margin:6rpx 0 0}.chevron{color:var(--jade);font-size:40rpx}.text-action{width:auto;min-height:88rpx;padding:20rpx 8rpx;background:transparent;color:var(--jade);font-size:28rpx;line-height:1.7}.back{text-align:left;padding-left:0;margin-top:18rpx}.person-summary{display:flex;align-items:center;justify-content:space-between}.person-summary .text-action{margin:0}.field-label{display:block;font-size:26rpx;color:var(--ink-soft);margin-top:24rpx}.name-input{font-size:32rpx;margin:6rpx 0 24rpx;color:var(--ink)}.empty{padding:32rpx 0}.danger{color:#9b4637}.record-options{display:flex;flex-wrap:wrap;gap:12rpx}.record-choice{margin:0;font-size:24rpx;background:transparent;border:1rpx solid var(--line);border-radius:10rpx;padding:14rpx 20rpx;min-height:80rpx}.record-choice.selected{border-color:var(--jade);color:var(--jade)}
