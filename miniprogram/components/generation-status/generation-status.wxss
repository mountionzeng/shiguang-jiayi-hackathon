:host { display: block; }
.generation-status {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 64rpx;
  padding: 12rpx 0;
  color: #4f7f6b;
}
.generation-label { flex: 1; font-size: 24rpx; line-height: 1.6; }
.writing-dots { display: flex; align-items: center; gap: 7rpx; width: 48rpx; flex-shrink: 0; }
.writing-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #4f7f6b;
  animation: writing-pulse 1.4s ease-in-out infinite;
}
.writing-dot:nth-child(2) { animation-delay: .16s; }
.writing-dot:nth-child(3) { animation-delay: .32s; }
.image-frame {
  position: relative;
  flex-shrink: 0;
  width: 42rpx;
  height: 48rpx;
  overflow: hidden;
  border: 2rpx solid #4f7f6b;
  border-radius: 6rpx;
  background: #eaf1ed;
  animation: image-breathe 2s ease-in-out infinite;
}
.image-sun { position: absolute; top: 8rpx; right: 7rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: #4f7f6b; }
.image-hill { position: absolute; bottom: -14rpx; left: 0; width: 34rpx; height: 34rpx; border: 2rpx solid #4f7f6b; transform: rotate(45deg); border-radius: 5rpx; }
@keyframes writing-pulse {
  0%, 70%, 100% { transform: translateY(0); opacity: .4; }
  35% { transform: translateY(-5rpx); opacity: 1; }
}
@keyframes image-breathe {
  0%, 100% { transform: scale(.94); opacity: .5; }
  50% { transform: scale(1); opacity: 1; }
}
@media (prefers-reduced-motion: reduce) {
  .writing-dot, .image-frame { animation: none; }
}
