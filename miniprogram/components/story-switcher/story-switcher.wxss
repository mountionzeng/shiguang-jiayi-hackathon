:host {
  display: block;
}

.story-switcher {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: flex-start;
  height: calc(258rpx + env(safe-area-inset-bottom));
  padding: 0 16rpx env(safe-area-inset-bottom);
  background: radial-gradient(ellipse 118% 96% at 50% 100%, rgba(251, 248, 241, 0.98) 0%, rgba(251, 248, 241, 0.94) 70%, rgba(251, 248, 241, 0) 71%);
  overflow: visible;
}

.switcher-branch {
  position: absolute;
  top: 18rpx;
  left: -6%;
  width: 112%;
  height: 190rpx;
  opacity: 0.7;
  pointer-events: none;
}

.switcher-book-edges {
  position: absolute;
  bottom: -12rpx;
  left: -14%;
  z-index: 0;
  width: 128%;
  height: 320rpx;
  opacity: 0.24;
  pointer-events: none;
  transform: scale(2);
  transform-origin: 50% 100%;
}

.story-tab {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  height: 248rpx;
  padding-top: 188rpx;
  background: transparent;
  color: #2a2e2b;
  text-align: center;
  overflow: visible;
}

.story-tab:active .tab-art {
  transform: translateY(-5rpx) scale(1.035);
}

.story-tab-personal {
  transform: translate(-12rpx, 32rpx) rotate(-1.5deg);
}

.story-tab-chat {
  z-index: 3;
  transform: translate(2rpx, -4rpx);
}

.story-tab-family {
  transform: translate(-8rpx, 23rpx) rotate(1.2deg);
}

.tab-art {
  position: absolute;
  top: 34rpx;
  left: 50%;
  display: block;
  width: 231rpx;
  height: 144rpx;
  margin-left: -115.5rpx;
  transition: transform 220ms ease;
}

.tab-art-chat {
  top: -8rpx;
  width: 224rpx;
  height: 200rpx;
  margin-left: -112rpx;
  filter: drop-shadow(0 9rpx 12rpx rgba(57, 91, 76, 0.18));
  animation: logo-breathe 4.2s ease-in-out infinite;
}

.tab-chat-title {
  color: #4f7f6b;
}

.tab-title {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  font-family: "Courier New", FangSong, STFangsong, "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: 0;
  text-shadow: 0 1rpx 0 rgba(255, 253, 247, 0.78);
}

.arc-char {
  display: block;
  width: 35rpx;
  transform-origin: 50% 100%;
}

.tab-title-personal .arc-1 { transform: translateY(9rpx) rotate(-9deg); }
.tab-title-personal .arc-2 { transform: translateY(2rpx) rotate(-3deg); }
.tab-title-personal .arc-3 { transform: translateY(0) rotate(3deg); }
.tab-title-personal .arc-4 { transform: translateY(4rpx) rotate(9deg); }

.tab-title-chat .arc-1 { transform: translateY(5rpx) rotate(-7deg); }
.tab-title-chat .arc-2 { transform: translateY(0) rotate(-2deg); }
.tab-title-chat .arc-3 { transform: translateY(0) rotate(2deg); }
.tab-title-chat .arc-4 { transform: translateY(5rpx) rotate(7deg); }

.tab-title-family .arc-1 { transform: translateY(4rpx) rotate(-9deg); }
.tab-title-family .arc-2 { transform: translateY(0) rotate(-3deg); }
.tab-title-family .arc-3 { transform: translateY(2rpx) rotate(3deg); }
.tab-title-family .arc-4 { transform: translateY(9rpx) rotate(9deg); }

.story-tab-current .tab-title {
  color: #4f7f6b;
}

.story-tab-current .tab-art {
  animation: current-bird 3.8s ease-in-out infinite;
}

@keyframes current-bird {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-4rpx) scale(1.018); }
}

@keyframes logo-breathe {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-3rpx) scale(1.025); }
}

/* ---- 从中间 LOGO 弹出的古籍双入口 ---- */

.capture-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 39;
  background: rgba(36, 43, 39, 0.3);
  animation: mask-in 220ms ease-out both;
}

.capture-sheet {
  position: fixed;
  right: 0;
  bottom: calc(242rpx + env(safe-area-inset-bottom));
  left: 0;
  z-index: 40;
  padding: 0 12rpx;
  background: transparent;
  animation: capture-sheet-up 340ms cubic-bezier(0.2, 0.84, 0.28, 1.08) both;
}

.capture-sheet-recall {
  bottom: calc(238rpx + env(safe-area-inset-bottom));
  max-height: calc(100vh - 280rpx - env(safe-area-inset-bottom));
  padding: 0 24rpx 10rpx;
  overflow: visible;
  background: transparent;
}

.capture-recall-art {
  position: absolute;
  top: 0;
  right: 64rpx;
  left: 64rpx;
  z-index: 0;
  width: calc(100% - 128rpx);
  height: 178rpx;
  opacity: 0.96;
  pointer-events: none;
  filter: drop-shadow(0 9rpx 13rpx rgba(42, 46, 43, 0.1));
  transform: rotate(-0.7deg);
}

.capture-heading {
  position: relative;
  z-index: 1;
  padding-left: 62rpx;
}

.capture-sheet-recall .capture-heading {
  box-sizing: border-box;
  width: 100%;
  min-height: 180rpx;
  padding: 39rpx 78rpx 27rpx;
}

.capture-eyebrow {
  position: relative;
  z-index: 1;
  color: var(--jade);
  font-size: 19rpx;
  line-height: 1.4;
  letter-spacing: 4rpx;
}

.capture-title {
  color: #fffdf7;
  font-size: 43rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  text-shadow: 0 3rpx 12rpx rgba(39, 47, 42, 0.28);
}

.capture-sheet-recall .capture-title {
  position: relative;
  z-index: 1;
  margin-top: 3rpx;
  color: var(--ink);
  font-size: 39rpx;
  font-weight: 500;
  line-height: 1.3;
  letter-spacing: 1rpx;
  text-shadow: none;
}

.capture-subtitle {
  position: relative;
  z-index: 1;
  margin-top: 3rpx;
  color: var(--ink-soft);
  font-size: 21rpx;
}

.capture-options {
  display: flex;
  align-items: flex-end;
  margin-top: 2rpx;
}

.capture-choice {
  position: relative;
  flex: 1;
  height: 300rpx;
  background: transparent;
  overflow: visible;
}

.capture-choice + .capture-choice {
  margin-left: 2rpx;
}

.capture-choice-note {
  animation: capture-note-pop 360ms cubic-bezier(0.2, 0.84, 0.28, 1.12) 90ms both;
}

.capture-choice-memoir {
  animation: capture-memoir-pop 360ms cubic-bezier(0.2, 0.84, 0.28, 1.12) 150ms both;
}

.capture-choice-note:active {
  transform: rotate(-5deg) translate(4rpx, 8rpx) scale(0.97);
}

.capture-choice-memoir:active {
  transform: rotate(4deg) translate(-3rpx, 8rpx) scale(0.97);
}

.capture-art {
  position: absolute;
  top: 0;
  left: 50%;
  display: block;
}

.capture-art-note {
  top: 22rpx;
  width: 334rpx;
  height: 223rpx;
  margin-left: -167rpx;
}

.capture-art-memoir {
  top: 0;
  width: 264rpx;
  height: 274rpx;
  margin-left: -132rpx;
}

.capture-copy {
  position: absolute;
  z-index: 1;
  text-align: center;
  pointer-events: none;
}

.capture-copy-note {
  top: 98rpx;
  right: 8rpx;
  left: 24rpx;
}

.capture-copy-memoir {
  top: 116rpx;
  right: 26rpx;
  left: 4rpx;
}

.capture-choice-title {
  color: #2f4e43;
  font-family: "ShiguangBookType", "Songti SC", STSong, serif;
  font-size: 41rpx;
  font-weight: 400;
  letter-spacing: 3rpx;
  text-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.55);
}

@keyframes mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes capture-sheet-up {
  from { opacity: 0; transform: translateY(54rpx); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes capture-note-pop {
  from { opacity: 0; transform: rotate(-5deg) translate(-12rpx, 48rpx) scale(0.84); }
  to { opacity: 1; transform: rotate(-5deg) translate(0, 8rpx) scale(1); }
}

@keyframes capture-memoir-pop {
  from { opacity: 0; transform: rotate(4deg) translate(12rpx, 52rpx) scale(0.84); }
  to { opacity: 1; transform: rotate(4deg) translate(0, 0) scale(1); }
}

/* ---- 回忆录：挑一段接着聊 ---- */

.capture-recall {
  position: relative;
  z-index: 1;
  max-height: calc(100vh - 510rpx - env(safe-area-inset-bottom));
  margin: 0;
  padding: 4rpx 14rpx 0;
  animation: capture-sheet-up 280ms cubic-bezier(0.2, 0.84, 0.28, 1.08) both;
}

.capture-memory {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 132rpx;
  margin: 0 0 16rpx;
  padding: 20rpx 22rpx 20rpx 18rpx;
  overflow: hidden;
  border: 1rpx solid rgba(79, 127, 107, 0.18);
  border-radius: 10rpx 25rpx 18rpx 9rpx;
  background: rgba(255, 254, 251, 0.94);
  box-shadow: 4rpx 8rpx 18rpx rgba(45, 52, 47, 0.07);
  color: var(--ink);
  text-align: left;
}

.capture-memory::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 7rpx;
  background: var(--jade);
  content: "";
  opacity: 0.7;
}

.capture-memory::after,
.capture-all::after { border: 0; }

.capture-memory:active {
  background: var(--jade-soft);
  transform: translateY(2rpx) scale(0.99);
}

.capture-memory-index {
  flex: none;
  width: 54rpx;
  color: var(--jade);
  font-family: Georgia, serif;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.capture-memory-copy {
  flex: 1;
  min-width: 0;
}

.capture-memory-title {
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.3;
}

.capture-memory-excerpt {
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--ink-soft);
  font-size: 24rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.capture-memory-meta {
  margin-top: 8rpx;
  color: var(--jade);
  font-size: 21rpx;
}

.capture-memory-next {
  flex: none;
  margin-left: 16rpx;
  color: var(--jade);
  font-size: 22rpx;
  white-space: nowrap;
}

.capture-memory-next text {
  margin-left: 5rpx;
  font-family: serif;
  font-size: 36rpx;
  line-height: 1;
  vertical-align: -3rpx;
}

.capture-empty {
  padding: 32rpx 20rpx;
  border-radius: 18rpx;
  background: var(--paper-sunk);
  color: var(--ink-soft);
  font-size: 24rpx;
  text-align: center;
  text-shadow: none;
}

.capture-all {
  position: relative;
  display: flex;
  align-items: center;
  width: calc(100% - 24rpx);
  min-height: 108rpx;
  margin: 20rpx auto 4rpx;
  padding: 18rpx 24rpx 18rpx 27rpx;
  overflow: hidden;
  border: 0;
  border-radius: 28rpx 12rpx 27rpx 15rpx;
  background: var(--jade);
  color: var(--paper-card);
  text-align: left;
  box-shadow: 0 9rpx 20rpx rgba(42, 73, 60, 0.2);
}

.capture-all::before {
  position: absolute;
  top: -21rpx;
  right: 58rpx;
  width: 74rpx;
  height: 65rpx;
  border-radius: 50%;
  background: rgba(255, 254, 251, 0.09);
  content: "";
}

.capture-all:active {
  background: #456f5e;
  transform: translateY(2rpx) scale(0.99);
}

.capture-all-icon {
  position: relative;
  flex: none;
  width: 48rpx;
  height: 48rpx;
  margin-right: 19rpx;
}

.capture-all-icon view {
  position: absolute;
  width: 31rpx;
  height: 39rpx;
  border: 3rpx solid var(--paper-card);
  border-radius: 4rpx 9rpx 7rpx 4rpx;
}

.capture-all-icon view:first-child { top: 1rpx; left: 2rpx; opacity: 0.5; transform: rotate(-7deg); }
.capture-all-icon view:last-child { right: 2rpx; bottom: 1rpx; background: var(--jade); transform: rotate(4deg); }

.capture-all-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.capture-all-copy text:first-child {
  font-size: 29rpx;
  font-weight: 600;
}

.capture-all-copy text:last-child {
  margin-top: 2rpx;
  color: rgba(255, 254, 251, 0.76);
  font-size: 21rpx;
}

.capture-all-arrow {
  margin-left: 12rpx;
  font-family: serif;
  font-size: 43rpx;
  line-height: 1;
}

@media (max-width: 340px) {
  .capture-sheet-recall { padding-right: 14rpx; padding-left: 14rpx; }
  .capture-sheet-recall .capture-heading { padding-right: 66rpx; padding-left: 66rpx; }
  .capture-recall { padding-right: 10rpx; padding-left: 10rpx; }
  .capture-memory-next { font-size: 20rpx; }
}
