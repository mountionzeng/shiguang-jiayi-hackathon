<view class="story-switcher" role="navigation" aria-label="故事空间切换">
  <image
    class="switcher-branch"
    src="/assets/illustrations/story-switcher-curved-branch.png"
    mode="aspectFit"
    aria-hidden="true"
  ></image>
  <image
    class="switcher-book-edges"
    src="/assets/illustrations/story-switcher-book-edges.png"
    mode="aspectFit"
    aria-hidden="true"
  ></image>

  <button
    class="story-tab story-tab-personal {{current === 'personal' ? 'story-tab-current' : ''}}"
    bindtap="openPersonal"
    hover-class="none"
    aria-label="切换到人生之书，我的故事"
  >
    <image
      class="tab-art tab-art-personal"
      src="/assets/illustrations/story-tab-personal.png"
      mode="aspectFit"
      aria-hidden="true"
    ></image>
    <view class="tab-title tab-title-personal" aria-label="人生之书">
      <text class="arc-char arc-1">人</text>
      <text class="arc-char arc-2">生</text>
      <text class="arc-char arc-3">之</text>
      <text class="arc-char arc-4">书</text>
    </view>
  </button>

  <button
    class="story-tab story-tab-chat"
    bindtap="startInterview"
    hover-class="none"
    aria-label="记下此刻，记录一段故事"
  >
    <image
      class="tab-art tab-art-chat"
      src="/assets/illustrations/story-tab-chat.png"
      mode="aspectFit"
      aria-hidden="true"
    ></image>
    <view class="tab-title tab-title-chat tab-chat-title" aria-label="记下此刻">
      <text class="arc-char arc-1">记</text>
      <text class="arc-char arc-2">下</text>
      <text class="arc-char arc-3">此</text>
      <text class="arc-char arc-4">刻</text>
    </view>
  </button>

  <button
    class="story-tab story-tab-family {{current === 'family' ? 'story-tab-current' : ''}}"
    bindtap="openFamily"
    hover-class="none"
    aria-label="切换到记忆之家，我和亲友的故事"
  >
    <image
      class="tab-art tab-art-family"
      src="/assets/illustrations/story-tab-family.png"
      mode="aspectFit"
      aria-hidden="true"
    ></image>
    <view class="tab-title tab-title-family" aria-label="记忆之家">
      <text class="arc-char arc-1">记</text>
      <text class="arc-char arc-2">忆</text>
      <text class="arc-char arc-3">之</text>
      <text class="arc-char arc-4">家</text>
    </view>
  </button>
</view>

<view
  class="capture-mask"
  wx:if="{{chooserOpen}}"
  bindtap="closeChooser"
  aria-label="关闭记录方式选择"
></view>

<view
  class="capture-sheet {{memoirOpen ? 'capture-sheet-recall' : ''}}"
  wx:if="{{chooserOpen}}"
  catchtap="keepChooserOpen"
  role="dialog"
  aria-label="选择记录方式"
>
  <image
    wx:if="{{memoirOpen}}"
    class="capture-recall-art"
    src="/assets/illustrations/memory-recall-sheet.png"
    mode="aspectFit"
    aria-hidden="true"
  ></image>
  <view class="capture-heading">
    <view wx:if="{{memoirOpen}}" class="capture-eyebrow">回忆</view>
    <view class="capture-title {{memoirOpen ? 'serif' : 'typewriter'}}">{{memoirOpen ? '想起了哪一段？' : '这次怎么记？'}}</view>
    <view wx:if="{{memoirOpen}}" class="capture-subtitle">挑一段，接着说下去</view>
  </view>

  <!-- 回忆录：先挑一段已经讲过的，再接着聊 -->
  <scroll-view class="capture-recall" scroll-y wx:if="{{memoirOpen}}">
    <button
      class="capture-memory"
      wx:for="{{recent}}"
      wx:key="id"
      data-id="{{item.id}}"
      data-title="{{item.storyTitle}}"
      bindtap="continueMemory"
      hover-class="none"
      aria-label="接着聊{{item.title}}"
    >
      <view class="capture-memory-index">{{index + 1 < 10 ? '0' : ''}}{{index + 1}}</view>
      <view class="capture-memory-copy">
        <view class="capture-memory-title serif">{{item.title}}</view>
        <view class="capture-memory-excerpt">{{item.excerpt}}</view>
        <view class="capture-memory-meta">{{item.storyLabel}}</view>
      </view>
      <view class="capture-memory-next">接着聊 <text aria-hidden="true">›</text></view>
    </button>

    <view class="capture-empty" wx:if="{{recentLoaded && !recent.length}}">还没有回忆，先随手记一段吧。</view>
    <view class="capture-empty" wx:elif="{{recentError}}">{{recentError}}</view>
    <view class="capture-empty" wx:elif="{{!recentLoaded}}">正在找你讲过的回忆…</view>

    <button
      class="capture-all"
      bindtap="openAllMemories"
      hover-class="none"
      aria-label="从全部回忆里挑一段"
    >
      <view class="capture-all-icon" aria-hidden="true"><view></view><view></view></view>
      <view class="capture-all-copy"><text>全部回忆</text><text>从所有回忆里挑一段</text></view>
      <text class="capture-all-arrow" aria-hidden="true">›</text>
    </button>
  </scroll-view>

  <view class="capture-options" wx:else>
    <button
      class="capture-choice capture-choice-note"
      bindtap="startQuickNote"
      hover-class="none"
      aria-label="随手记，直接开一段新的"
    >
      <image
        class="capture-art capture-art-note"
        src="/assets/illustrations/capture-note-paper.png"
        mode="aspectFit"
        aria-hidden="true"
      ></image>
      <view class="capture-copy capture-copy-note">
        <view class="capture-choice-title typewriter">随手记</view>
      </view>
    </button>

    <button
      class="capture-choice capture-choice-memoir"
      bindtap="openMemoir"
      hover-class="none"
      aria-label="回忆录，挑一段接着聊"
    >
      <image
        class="capture-art capture-art-memoir"
        src="/assets/illustrations/capture-memoir-book.png"
        mode="aspectFit"
        aria-hidden="true"
      ></image>
      <view class="capture-copy capture-copy-memoir">
        <view class="capture-choice-title typewriter">回忆录</view>
      </view>
    </button>
  </view>
</view>
