<view class="article-note" wx:if="{{note}}">{{note}}</view>
<view wx:for="{{pages}}" wx:for-item="page" wx:key="id" class="article-page" style="height:{{page.height}}px;" bindtap="clear">
  <image wx:if="{{backdrop}}" class="article-backdrop" src="{{backdrop}}" mode="aspectFill" />
  <view wx:for="{{page.modules}}" wx:for-item="module" wx:key="id" class="article-module {{selected === module.id || (mergeIds.length > 0 && (mergeIds[0] === module.blockId || mergeIds[1] === module.blockId)) ? 'selected' : ''}}" style="{{module.style}}" data-id="{{module.id}}" data-block="{{module.blockId}}" catchtap="select" catchlongpress="beginMerge">
    <textarea wx:if="{{module.kind === 'text' && module.blockId}}" id="article-input-{{module.id}}" class="article-text" style="{{module.fontStyle}}" value="{{module.text}}" data-block="{{module.blockId}}" data-id="{{module.id}}" data-measure="{{module.measurementKey}}" focus="{{focusRequest === module.blockId}}" selection-start="{{focusRequest === module.blockId ? selectionCursor : -1}}" selection-end="{{focusRequest === module.blockId ? selectionCursor : -1}}" disabled="{{mergeIds.length > 0}}" catchlongpress="beginMerge" auto-height bindconfirm="confirmEditing" bindfocus="beginEditing" bindlinechange="textLineChange" bindinput="change" bindblur="finishEditing" maxlength="20000" placeholder="" adjust-position="{{adjustPosition}}" cursor-spacing="24" />
    <text wx:elif="{{module.kind === 'text'}}" style="{{module.fontStyle}}">{{module.text}}</text>
    <button wx:elif="{{module.kind === 'audio'}}" class="article-audio" data-id="{{module.id}}" catchtap="playAudio">▶ {{module.audioKind === 'music' ? '纯音乐' : '有声书'}} · 播放 / 暂停</button>
    <image wx:elif="{{module.path}}" class="article-image" src="{{module.path}}" mode="aspectFill" />
    <view wx:else class="article-missing">图片正在加载</view>
    <view wx:if="{{mergeIds.length > 0 && module.blockId}}" class="merge-select-layer" data-id="{{module.id}}" data-block="{{module.blockId}}" catchtap="select" aria-label="选择文字模块" />
    <view wx:if="{{mergeMenu === module.id}}" class="merge-action" role="button" catchtap="mergeText">合并</view>
    <block wx:if="{{selected === module.id}}">
      <view wx:if="{{module.kind !== 'audio'}}" class="move-handle" data-id="{{module.id}}" catchtouchstart="start" catchtouchmove="move" catchtouchend="end" catchtouchcancel="end" aria-label="拖动模块">移动</view>
      <view wx:if="{{module.kind !== 'audio'}}" class="resize-handle" data-id="{{module.id}}" data-resize="true" catchtouchstart="start" catchtouchmove="move" catchtouchend="end" catchtouchcancel="end" aria-label="拖动调整大小">↘</view>
      <view class="delete-handle" role="button" catchtap="remove" aria-label="删除选中的模块">×</view>
    </block>
  </view>
</view>
<view class="article-footer">
  <slot name="companion" />
  <button class="article-add" bindtouchstart="captureImageSelection" bindtap="addImage">＋ 添加图片</button>
</view>
<view id="article-caret-measure" class="article-caret-measure" style="{{caretMeasureStyle}}" aria-hidden="true">{{caretMeasureText}}</view>
