:host { display:block;position:relative; }
.article-note { color:#68776c;font-size:26rpx;padding:20rpx 0; }
.article-note { color:#9a4b35; }
.article-page { position:relative;background:#fffefa;margin:0 0 24rpx;overflow:visible; }
.article-module { position:absolute;box-sizing:border-box;border:1px solid transparent; }
.article-module.selected { border-color:#527c6c;z-index:2; }
.article-text { width:100%;min-height:1.6em;line-height:1.6;padding:0;box-sizing:border-box;color:#2c302b;white-space:pre-wrap;overflow-wrap:break-word; }
.article-image { width:100%;height:100%;display:block; }
.move-handle,.resize-handle,.delete-handle { position:absolute;background:#527c6c;color:#fff;min-width:72rpx;min-height:64rpx;font-size:24rpx;display:flex;align-items:center;justify-content:center;border-radius:8rpx;z-index:3; }
.move-handle { top:-66rpx;left:0; }.delete-handle { width:auto;min-width:72rpx;top:-66rpx;right:0;margin:0;padding:0 12rpx;line-height:1; }.resize-handle { right:-14rpx;bottom:-14rpx;font-size:40rpx; }
.article-add { background:transparent;color:#527c6c;font-size:30rpx;margin:24rpx 0; }.article-add::after { border:1px dashed #aab9ac; }.article-missing { font-size:26rpx;color:#68776c; }

/* Compact handles must not inherit WeChat button width or cover the preceding line. */
.move-handle,.delete-handle { top:0; min-height:44rpx; min-width:44rpx; font-size:22rpx; background:rgba(82,124,108,.9); }
.move-handle { left:-22rpx; transform:translateX(-50%); writing-mode:vertical-rl; padding:6rpx 0; }
.delete-handle { right:-18rpx; width:44rpx; padding:0; transform:translate(50%,-50%); border-radius:50%; font-size:32rpx; }
.resize-handle { min-width:44rpx;min-height:44rpx;font-size:30rpx; }

.article-backdrop { position:absolute;inset:0;width:100%;height:100%;opacity:.22;pointer-events:none; }

.article-footer { display:flex;align-items:center;gap:16rpx;padding-bottom:env(safe-area-inset-bottom); }
.article-footer .article-add { flex:1;min-width:0;width:auto;margin:12rpx 0; }
/* Measure only the prefix before the caret with the same wrapping as textarea.
 * Absolute/hidden: this must never add visible space or receive touches. */
.article-caret-measure { position:absolute;left:-10000px;top:0;visibility:hidden;pointer-events:none;white-space:pre-wrap;overflow-wrap:break-word;line-height:1.6;padding:0;box-sizing:border-box; }

.article-audio { margin:0;width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:28rpx;color:#527c6c;background:#eef3ee;border-radius:12rpx; }
.article-audio::after { border:none; }

.merge-select-layer { position:absolute;inset:0;z-index:4; }
.merge-action { position:absolute;top:0;left:50%;transform:translate(-50%,-100%);z-index:5;padding:12rpx 30rpx;color:#fff;background:#527c6c;border-radius:10rpx;font-size:26rpx; }
