:host { display:block; }
.article-hint,.article-note { color:#68776c;font-size:26rpx;padding:20rpx 0; }
.article-note { color:#9a4b35; }
.article-page { position:relative;background:#fffefa;margin:0 0 24rpx;overflow:visible; }
.article-module { position:absolute;box-sizing:border-box;border:1px solid transparent; }
.article-module.selected { border-color:#527c6c;z-index:2; }
.article-text { width:100%;height:100%;line-height:1.6;padding:0;box-sizing:border-box;color:#2c302b; }
.article-image { width:100%;height:100%;display:block; }
.move-handle,.resize-handle,.delete-handle { position:absolute;background:#527c6c;color:#fff;min-width:72rpx;min-height:64rpx;font-size:24rpx;display:flex;align-items:center;justify-content:center;border-radius:8rpx;z-index:3; }
.move-handle { top:-66rpx;left:0; }.delete-handle { width:auto;min-width:72rpx;top:-66rpx;right:0;margin:0;padding:0 12rpx;line-height:1; }.resize-handle { right:-14rpx;bottom:-14rpx;font-size:40rpx; }
.article-add { background:transparent;color:#527c6c;font-size:30rpx;margin:24rpx 0; }.article-add::after { border:1px dashed #aab9ac; }.article-missing { font-size:26rpx;color:#68776c; }
