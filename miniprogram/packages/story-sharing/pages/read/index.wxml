<view class="sharing-page">
  <view class="eyebrow">拾光家忆 · 获准阅读的原稿</view>
  <view class="heading serif">{{title || '亲友的故事'}}</view>
  <view class="intro">这里是亲友分享给你的章节，显示最新已保存的文字。{{canCopy ? '读完可以保留下来，或收进自己的故事继续补充；你的补充不会直接改动对方的原稿。' : '目前仅供阅读，收入自己的故事需要对方授权并开放相应功能。'}}</view>
  <view class="notice" wx:if="{{notice}}">{{notice}}</view>
  <view class="intro" wx:if="{{loading}}">正在核对权限并读取章节…</view>
  <view class="reading-chapter" wx:for="{{chapters}}" wx:key="id" wx:for-item="chapter">
    <block wx:if="{{editChapterId === chapter.id}}">
      <input class="edit-title serif" maxlength="40" value="{{editTitle}}" bindinput="editTitle" aria-label="章节标题"/>
      <textarea class="edit-block serif" wx:for="{{editBlocks}}" wx:key="index" wx:for-item="block" data-index="{{block.index}}" value="{{block.text}}" bindinput="editBlock" auto-height maxlength="-1" aria-label="章节正文"/>
      <view class="actions"><button class="secondary" disabled="{{busy}}" bindtap="cancelEdit">稍后再写</button><button class="primary" disabled="{{busy}}" loading="{{busy}}" bindtap="saveEdit">保存修改</button></view>
    </block>
    <block wx:else>
      <view class="section-title serif">{{chapter.title || '未命名章节'}}</view>
      <text class="paragraph serif" wx:for="{{chapter.content}}" wx:key="index" wx:for-item="paragraph">{{paragraph.text}}</text>
      <button wx:if="{{canEdit}}" class="secondary" data-id="{{chapter.id}}" bindtap="beginEdit" disabled="{{busy || loading || editChapterId}}">编辑这一章</button>
    </block>
  </view>
  <view class="caption" wx:if="{{canCopy && chapters.length}}">读完可以留下来：它会成为你自己的一本书，你写的内容只在你的书里，不会直接出现在对方的书中。</view>
  <button wx:if="{{canCopy && chapters.length}}" class="primary" data-intent="keep" bindtap="keep" loading="{{busy}}" disabled="{{busy || loading || editChapterId}}">保留下来</button>
  <button wx:if="{{canCopy && chapters.length}}" class="secondary" data-intent="expand" bindtap="keep" disabled="{{busy || loading || editChapterId}}">在此基础上扩写</button>
  <button wx:if="{{canInvite}}" class="primary" bindtap="createInvitation" disabled="{{busy || loading}}" loading="{{busy}}">申请再邀请一位亲友</button>
  <button wx:if="{{shareReady}}" class="primary" open-type="share">发送新的阅读邀请</button>
  <button class="secondary refresh" bindtap="refresh" disabled="{{loading || busy}}">重新核对并刷新</button>
</view>
