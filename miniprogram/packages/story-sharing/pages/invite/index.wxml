<view class="sharing-page">
  <view class="eyebrow">拾光家忆 · 亲友阅读与权限</view>
  <view class="heading serif">{{recipient ? '一份故事邀请' : '和家人一起，留住故事'}}</view>
  <view class="intro">{{recipient ? '点一下加入，就能读到 ta 想让你读的章节，也可以回一封信。' : '先写下怎么称呼这位家人，再选要分享的章节，并设置 ta 能做什么。'}}</view>
  <view class="invite-letter" wx:if="{{!recipient}}"><view class="caption">一份故事邀请</view><view class="letter-heading serif">有些日子，想和你再回味。</view><view class="intro">你可以让家人阅读，也可以允许他一起改写。每份邀请的权限分别设置。</view></view>
  <view class="notice" wx:if="{{notice}}">{{notice}}</view>
  <view class="intro" wx:if="{{loading}}">正在确认访问权限…</view>
  <block wx:if="{{available && !recipient}}">
    <view class="section-title serif">{{title}}</view>
    <input class="name-input" maxlength="30" value="{{inviteeName}}" bindinput="enterInviteeName" disabled="{{busy}}" placeholder="怎么称呼这位家人，例如：小岚、妈妈" aria-label="家人的称呼"/>
    <view class="relation-row">
      <button class="relation-chip {{relation === item ? 'relation-on' : ''}}" wx:for="{{relationOptions}}" wx:key="*this" data-value="{{item}}" bindtap="chooseRelation" disabled="{{busy}}">{{item}}</button>
      <input class="name-input relation-input" maxlength="12" value="{{relation}}" bindinput="enterRelation" disabled="{{busy}}" placeholder="或者自己写，不选默认“家人”" aria-label="你们的关系"/>
    </view>
    <view class="caption">选择已保存的章节 · 新增章节不会自动分享</view>
    <checkbox-group bindchange="chooseChapters">
      <label class="chapter-choice" wx:for="{{chapters}}" wx:key="id"><checkbox value="{{item.id}}" checked="{{item.checked}}" disabled="{{busy}}" color="#4f7f6b"/><text>{{item.title || '未命名章节'}}</text></label>
    </checkbox-group>
    <view class="intro" wx:if="{{!chapters.length}}">请先回到故事，保存至少一个章节。</view>
    <view class="section-title serif">这位家人可以做什么</view>
    <view class="permission"><text>阅读选中的原稿</text><text>允许</text></view>
    <view class="permission" wx:if="{{editAvailable}}"><text>改写选中的原稿</text><switch checked="{{edit}}" disabled="{{busy}}" bindchange="chooseEdit" color="#4f7f6b"/></view>
    <view class="caption" wx:if="{{!editAvailable}}">改写权限当前未开放，开放后可为这位家人单独设置。</view>
    <view class="permission" wx:if="{{copyAvailable}}"><text>收入自己的故事，继续补充</text><switch checked="{{copy}}" disabled="{{busy}}" bindchange="chooseCopy" color="#4f7f6b"/></view>
    <view class="permission"><text>申请再邀请一位亲友</text><switch checked="{{forward}}" disabled="{{busy}}" bindchange="chooseForward" color="#4f7f6b"/></view>
    <view class="caption">再邀请仍需你确认，不会自动放行下一位。</view>
    <view class="caption">以上设置只用于这份新邀请，不改变其他家人的已有权限。</view>
    <button class="primary" bindtap="create" loading="{{busy}}" disabled="{{busy || loading || !chapters.length}}">生成阅读邀请</button>
    <button wx:if="{{shareReady}}" class="primary" open-type="share">把邀请发给亲友</button>
    <view class="caption" wx:if="{{shareReady}}">邀请链接不含书名和正文。离开后不保留链接；可撤销旧邀请再生成。</view>
    <view class="section-title serif" wx:if="{{returns.length}}">亲友发回的回信</view>
    <view class="invitation" wx:for="{{returns}}" wx:key="returnId" wx:for-item="memory">
      <view class="caption">{{memory.senderName || '一位亲友'}} · {{memory.status === 'pending' ? '等你在书里决定是否采用' : memory.status === 'accepted' ? '已收进原故事' : '已选择不收'}}</view>
      <view class="share-excerpt serif" wx:for="{{memory.blocks}}" wx:key="blockId" wx:for-item="block">{{block.text}}</view>
    </view>
    <view class="section-title serif">已加入的家人</view>
    <view class="intro" wx:if="{{!invitations.length}}">还没有邀请。发出后，家人点开就会加入，这里能随时调整 ta 能看哪几章、能做什么。</view>
    <view class="invitation" wx:for="{{invitations}}" wx:key="invitationId" wx:for-item="inv">
      <view class="permission"><text>{{inv.member ? inv.member.name : '等待加入'}} · {{inv.chapterIds.length}} 个章节 · {{inv.label}}</text><button class="small danger" wx:if="{{inv.status !== 'revoked'}}" disabled="{{busy}}" data-invitation-id="{{inv.invitationId}}" bindtap="revoke">撤销</button></view>
      <block wx:if="{{inv.member && inv.member.active}}">
        <view class="caption">可以读的章节，点一下开关</view>
        <label class="chapter-choice" wx:for="{{chapters}}" wx:key="id" wx:for-item="chapter">
          <switch checked="{{inv.member.chapterIds.indexOf(chapter.id) >= 0}}" disabled="{{busy}}" data-invitation-id="{{inv.invitationId}}" data-field="chapter" data-chapter-id="{{chapter.id}}" bindchange="changeAccess" color="#4f7f6b"/><text>{{chapter.title || '未命名章节'}}</text>
        </label>
        <view class="permission" wx:if="{{editAvailable}}"><text>可以改写</text><switch checked="{{inv.member.permissions.edit}}" disabled="{{busy}}" data-invitation-id="{{inv.invitationId}}" data-field="edit" bindchange="changeAccess" color="#4f7f6b"/></view>
        <view class="permission" wx:if="{{copyAvailable}}"><text>可以收进自己的故事、回信</text><switch checked="{{inv.member.permissions.copy}}" disabled="{{busy}}" data-invitation-id="{{inv.invitationId}}" data-field="copy" bindchange="changeAccess" color="#4f7f6b"/></view>
      </block>
    </view>
  </block>
  <block wx:if="{{available && recipient && status}}">
    <view class="section-title serif" wx:if="{{status.status === 'approved'}}">已加入</view>
    <view class="section-title serif" wx:else>{{status.inviteeName || '亲友'}}，有人想和你分享一段故事</view>
    <button wx:if="{{status.status === 'unrequested'}}" class="primary" bindtap="accept" loading="{{busy}}" disabled="{{busy}}">加入，读一读</button>
    <button wx:if="{{status.status === 'approved'}}" class="primary" bindtap="openStory">阅读分享的章节</button>
    <view class="intro" wx:if="{{status.status === 'revoked' || status.status === 'rejected'}}">这份邀请已经失效，请让邀请你的人重新发一份。</view>
    <view class="caption" wx:if="{{status.status === 'unrequested'}}">加入后你的称呼是“{{status.inviteeName || '亲友'}}”，以后可以在“我的”里随时修改。你写的内容不会直接进入对方的书。</view>
  </block>
  <button class="secondary refresh" disabled="{{busy || loading}}" bindtap="refresh">{{loading ? '正在刷新…' : '刷新状态'}}</button>
</view>
