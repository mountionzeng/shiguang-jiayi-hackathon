<view class="sharing-page social-page">
  <view class="eyebrow">发送到社交媒体</view>
  <view class="heading serif">{{preview ? '看看这次分享的内容' : '想分享多少，由你决定'}}</view>
  <view class="intro" wx:if="{{loading}}">正在读取已保存的书稿…</view>
  <view class="notice" wx:if="{{notice}}">{{notice}}</view>
  <block wx:if="{{title}}">
    <view class="cover-summary">
      <image class="cover" src="{{coverUrl || '/assets/illustrations/story-book-cover.png'}}" mode="aspectFit" />
      <view><view class="serif">{{title}}</view><view class="caption">{{coverUrl ? '使用这本书已有的封面' : coverNotice || '封面示意'}}</view></view>
    </view>
    <view hidden="{{preview}}">
      <view class="section-title serif">分享哪些内容</view>
      <view class="scope-options">
        <button class="scope {{scope === 'book' ? 'selected' : ''}}" data-scope="book" bindtap="chooseScope" disabled="{{checking || exportBusy || albumSaving}}">整本书</button>
        <button class="scope {{scope === 'chapters' ? 'selected' : ''}}" data-scope="chapters" bindtap="chooseScope" disabled="{{checking || exportBusy || albumSaving}}">选择章节</button>
        <button class="scope {{scope === 'text' ? 'selected' : ''}}" data-scope="text" bindtap="chooseScope" disabled="{{checking || exportBusy || albumSaving}}">选择文字</button>
      </view>
      <view class="caption" wx:if="{{scope === 'book'}}">包含这本书全部 {{chapters.length}} 章的文字。封面之外的照片不自动加入。</view>
      <checkbox-group wx:if="{{scope === 'chapters'}}" bindchange="chooseChapters">
        <label class="chapter-choice" wx:for="{{chapters}}" wx:key="id"><checkbox value="{{item.id}}" checked="{{item.checked}}" disabled="{{checking || exportBusy || albumSaving}}" color="#4f7f6b" /><view><view>{{item.title}}</view><view class="caption">{{item.characterCount}} 字</view></view></label>
      </checkbox-group>
      <view hidden="{{scope !== 'text'}}">
        <picker range="{{chapters}}" range-key="title" value="{{textChapterIndex}}" bindchange="chooseTextChapter" disabled="{{checking || exportBusy || albumSaving}}"><view class="chapter-picker">{{chapters[textChapterIndex].title || '暂无章节'}}　⌄</view></picker>
        <view class="caption">长按下方原文选择文字，再点“使用选中文字”。</view>
        <editor id="send-text-source" class="text-source" read-only bindready="onEditorReady" />
        <button class="secondary" catchtouchstart="captureSelection" disabled="{{!editorReady || checking}}">使用选中文字</button>
        <view class="selected-excerpt" wx:if="{{selectedText}}"><view class="caption">已选文字</view><text selectable>{{selectedText}}</text></view>
      </view>
      <view class="caption selection-count">已选 {{selectedCount}} {{scope === 'text' ? '段' : '章'}} · {{characterCount}} 字</view>
      <button class="primary" bindtap="previewSelection" disabled="{{checking || !characterCount}}" loading="{{checking}}">{{checking ? '正在核对书稿' : '预览所选内容'}}</button>
    </view>
    <view wx:if="{{preview}}">
      <view class="preview-controls"><view class="caption">{{selectedCount}} {{scope === 'text' ? '段' : '章'}} · {{characterCount}} 字</view><button class="reselect" bindtap="backToSelection">重新选择</button></view>
      <view class="section-title serif">图片排版</view>
      <view class="scope-options"><button class="scope {{layout === 'pages' ? 'selected' : ''}}" data-layout="pages" bindtap="chooseLayout" disabled="{{exportBusy || albumSaving}}">分页图片</button><button class="scope {{layout === 'long' ? 'selected' : ''}}" data-layout="long" bindtap="chooseLayout" disabled="{{exportBusy || albumSaving}}">一张长图</button></view>
      <picker range="{{['紧凑','标准','大字']}}" value="{{fontSize === 28 ? 0 : fontSize === 32 ? 1 : 2}}" bindchange="chooseFont" disabled="{{exportBusy || albumSaving}}"><view class="chapter-picker">字号：{{fontSize === 28 ? '紧凑' : fontSize === 32 ? '标准' : '大字'}}　⌄</view></picker>
      <view class="caption">封面单独一张，正文按所选方式排版。长图过长时会提示改用分页，正文不会截断。</view>
      <view class="notice" wx:if="{{capabilityKnown && !exportAvailable}}">图片导出尚未开放，当前可以查看所选内容。</view>
      <button class="primary" bindtap="generateImages" loading="{{exportBusy}}" disabled="{{!exportAvailable || exportBusy || albumSaving}}">{{exportBusy ? renderProgress : imagePaths.length ? '重新生成图片' : '生成图片预览'}}</button>
      <block wx:if="{{imagePaths.length}}">
        <view class="section-title serif">共 {{imagePaths.length}} 张图片</view>
        <view class="export-image" wx:for="{{imagePaths}}" wx:key="*this"><view class="caption">{{index === 0 ? '封面' : '文字图 ' + index}}</view><image src="{{item}}" mode="widthFix" /></view>
        <button class="primary" bindtap="saveImages" loading="{{albumSaving}}" disabled="{{albumSaving || exportBusy || savedIndices.length === imagePaths.length}}">{{savedIndices.length === imagePaths.length ? '已全部保存' : savedIndices.length ? '继续保存剩余图片' : '保存全部图片到相册'}}</button>
        <view class="caption">{{savedIndices.length ? '已保存 ' + savedIndices.length + ' 张。' : ''}}保存后由你选择发布渠道。</view>
      </block>
      <view class="section-title serif">核对原文</view>
      <view class="reading-chapter" wx:for="{{previewChapters}}" wx:key="id"><view class="section-title serif">{{item.title}}</view><text class="paragraph" selectable>{{item.text || '本章没有文字'}}</text></view>
      <button class="secondary" bindtap="backToSelection">重新选择内容</button>
    </view>

  </block>
  <button class="secondary" wx:if="{{!loading && !checking && !title}}" bindtap="refresh">重新加载</button>
  <button class="secondary" bindtap="goBack" disabled="{{checking || exportBusy || albumSaving}}">回到书稿</button>
</view>

<canvas type="2d" id="book-send-canvas" class="export-canvas" style="height: {{canvasHeight}}px;"></canvas>
