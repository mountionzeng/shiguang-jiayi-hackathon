@import "../../shared.wxss";
.preview-controls{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.preview-controls .reselect{width:auto;margin:0;padding:16rpx;min-height:88rpx;color:var(--jade);font-size:28rpx}
.social-page{padding-top:40rpx}.cover-summary{display:flex;align-items:center;gap:28rpx;margin:32rpx 0}.cover{flex:none;width:112rpx;height:160rpx}.scope-options{display:flex;gap:12rpx;margin:20rpx 0}.scope-options .scope{flex:1;width:auto;min-width:0;margin:0;padding:20rpx 4rpx;min-height:88rpx;border:1rpx solid var(--line);border-radius:12rpx;font-size:28rpx}.scope.selected{border-color:var(--jade);background:var(--jade-soft);color:var(--jade)}.chapter-picker{padding:22rpx 0;color:var(--jade);border-bottom:1rpx solid var(--line)}.text-source{height:440rpx;padding:24rpx;background:var(--paper-card);border:1rpx solid var(--line);font-size:32rpx;line-height:1.9}.selected-excerpt{margin-top:24rpx;padding:20rpx;border-left:4rpx solid var(--jade);background:var(--paper-card);white-space:pre-wrap;overflow-wrap:break-word;font-size:30rpx}.selection-count{margin-top:32rpx}.prepare-note{margin-top:32rpx}.social-page [hidden]{display:none}
.cover-choice-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14rpx;margin:18rpx 0 24rpx}.cover-choice{display:flex;align-items:center;gap:8rpx;min-width:0}.cover-choice image{width:100%;height:150rpx;border:1rpx solid var(--line);border-radius:8rpx;background:var(--paper-card)}

.export-canvas{position:fixed;left:-10000px;top:0;width:750px;pointer-events:none}.export-image{margin-top:28rpx}.export-image image{display:block;width:100%;border:1rpx solid var(--line)}
.cover-model{margin:28rpx 0 34rpx;padding:24rpx 26rpx;border:1rpx solid rgba(79,127,107,.24);border-radius:16rpx;background:linear-gradient(135deg,rgba(234,241,237,.9),rgba(255,254,251,.92))}.cover-model-title{color:var(--ink);font-size:32rpx;line-height:1.5}.cover-model .caption{margin-top:8rpx}.cover-model-action{width:auto;min-height:80rpx;margin:18rpx 0 0;padding:0 22rpx;border:1rpx solid var(--jade);border-radius:10rpx;color:var(--jade);font-size:28rpx;background:var(--paper-card)}.cover-model-action[disabled]{opacity:.5}
