@import "../../shared.wxss";
.card-page{padding-bottom:140rpx}.card-choice{display:flex;align-items:flex-start;gap:18rpx;padding:24rpx 0;border-bottom:1rpx solid var(--line)}.card-choice-copy{flex:1;display:flex;flex-direction:column;gap:8rpx;white-space:pre-wrap;overflow-wrap:break-word}.card-choice-disabled{color:var(--ink-soft)}.card-preview{display:block;width:100%;margin:32rpx 0;border-radius:18rpx;box-shadow:0 18rpx 50rpx rgba(42,46,43,.12)}.story-card-canvas{position:fixed;left:-10000px;top:-10000px;width:750px;height:3900px;pointer-events:none}
