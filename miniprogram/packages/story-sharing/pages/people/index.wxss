@import "../../shared.wxss";
/* Override the native v2 button sizing; the whole row is the touch target. */
.people-page button.person-row{width:100%;max-width:none;box-sizing:border-box;margin:0;background:transparent}
.people-page button.person-row[disabled]{background:transparent;color:var(--ink);opacity:1}
.people-page button.primary{width:100%;box-sizing:border-box;background:var(--jade);color:#fff}
.people-page button.primary[disabled]{background:var(--jade);color:#fff;opacity:.5}
.person-name{color:var(--ink)}.person-row .person-avatar{font-size:23rpx}
.people-page{box-sizing:border-box;padding-top:40rpx}.eyebrow{overflow-wrap:break-word}.people-list{margin:36rpx 0}.person-row{display:flex;align-items:center;gap:22rpx;text-align:left;background:transparent;border-radius:0;border-bottom:1rpx solid var(--line);padding:28rpx 0;min-height:128rpx;color:var(--ink);line-height:1.5}.person-row::after,.text-action::after{border:0}.person-row[disabled]{opacity:1;color:var(--ink)}.person-avatar{width:80rpx;height:80rpx;flex:none;line-height:80rpx;text-align:center;font-size:26rpx;white-space:nowrap;overflow:hidden;border-radius:50%;background:var(--jade-soft);color:var(--jade)}.person-copy{flex:1;min-width:0}.person-name{font-size:34rpx;overflow-wrap:break-word}.person-relation{font-size:24rpx;color:var(--ink-soft);margin-left:18rpx}.person-copy .caption{margin:6rpx 0 0}.chevron{color:var(--jade);font-size:40rpx}.text-action{width:auto;min-height:88rpx;padding:20rpx 8rpx;background:transparent;color:var(--jade);font-size:28rpx;line-height:1.7}.back{text-align:left;padding-left:0;margin-top:18rpx}.person-summary{display:flex;align-items:center;justify-content:space-between}.person-summary .text-action{margin:0}.field-label{display:block;font-size:26rpx;color:var(--ink-soft);margin-top:24rpx}.name-input{font-size:32rpx;margin:6rpx 0 24rpx;color:var(--ink)}.empty{padding:32rpx 0}.danger{color:#9b4637}.record-options{display:flex;flex-wrap:wrap;gap:12rpx}.record-choice{margin:0;font-size:24rpx;background:transparent;border:1rpx solid var(--line);border-radius:10rpx;padding:14rpx 20rpx;min-height:80rpx}.record-choice.selected{border-color:var(--jade);color:var(--jade)}
