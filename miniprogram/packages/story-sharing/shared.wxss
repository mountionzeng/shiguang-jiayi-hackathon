.sharing-page{padding:64rpx 40rpx 100rpx;background:var(--paper);min-height:100vh}.eyebrow{color:var(--jade);font-size:24rpx;letter-spacing:3rpx}.heading{font-size:50rpx;line-height:1.4;margin:24rpx 0}.intro,.caption{color:var(--ink-soft);line-height:1.8}.intro{font-size:28rpx}.caption{font-size:24rpx;margin:12rpx 0}.section-title{font-size:36rpx;line-height:1.5;margin:48rpx 0 16rpx;overflow-wrap:break-word}.chapter-choice{display:flex;align-items:center;gap:20rpx;min-height:100rpx;border-bottom:1rpx solid var(--line)}.chapter-choice text{flex:1;overflow-wrap:break-word}.permission{display:flex;align-items:center;justify-content:space-between;gap:24rpx;padding:22rpx 0;font-size:27rpx;border-bottom:1rpx solid var(--line)}.permission>text:first-child{flex:1}.muted{color:var(--ink-soft)}.primary,.secondary{min-height:88rpx;display:flex;align-items:center;justify-content:center;padding:18rpx 26rpx;border-radius:14rpx;font-size:29rpx;margin-top:24rpx;transition:opacity .15s}.primary{background:var(--jade);color:#fff}.secondary{border:1rpx solid var(--jade);color:var(--jade)}button[disabled]{opacity:.5}.actions{display:flex;gap:20rpx}.actions button{flex:1}.notice{padding:24rpx;margin:24rpx 0;background:var(--apricot-soft);color:#684c3c;font-size:28rpx;line-height:1.7}.invitation{margin-top:24rpx;border-top:2rpx solid var(--line)}.applicant{padding:24rpx 0;border-bottom:1rpx solid var(--line)}.small{padding:14rpx;min-height:80rpx}.danger{color:#9b4637}.name-input{border-bottom:1rpx solid var(--jade);height:100rpx;margin:28rpx 0}.verification-code{font:44rpx/1.8 monospace;letter-spacing:8rpx;margin:30rpx 0;color:var(--jade)}.refresh{margin-top:48rpx}.paragraph{display:block;white-space:pre-wrap;overflow-wrap:break-word;font-size:34rpx;line-height:1.95;margin:24rpx 0}.reading-chapter{padding-bottom:24rpx;border-bottom:1rpx solid var(--line)}
