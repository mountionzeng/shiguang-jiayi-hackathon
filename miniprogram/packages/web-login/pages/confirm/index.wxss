.page{min-height:100vh;padding:72rpx 42rpx;background:#fbf8f1}.title{font-size:44rpx;font-weight:700;color:#38342f}.note,.warn{margin-top:18rpx;color:#756c62;font-size:26rpx;line-height:1.7}.warn{color:#9a4b2f}.card{margin:34rpx 0;padding:34rpx;border-radius:28rpx;background:rgba(255,252,244,.9);box-shadow:0 16rpx 42rpx rgba(76,58,41,.1)}.device{font-size:36rpx;font-weight:700;color:#443d35}.code-input{margin:34rpx 0 12rpx;height:96rpx;border-radius:20rpx;background:#fff;text-align:center;font-size:48rpx;letter-spacing:14rpx}.error{margin:12rpx 0;color:#b4452d;font-size:25rpx}.primary{margin-top:24rpx;background:#6f4f3a!important;color:#fff!important}.ghost{margin-top:16rpx;background:transparent!important;color:#6f4f3a!important}.primary::after,.ghost::after{border:0}
