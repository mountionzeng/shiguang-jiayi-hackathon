page{background:#f4efe5;color:#342b25}.audio-page{min-height:100vh;padding:48rpx 34rpx 80rpx;box-sizing:border-box}.hero{padding:32rpx 12rpx 44rpx}.eyebrow,.card-kicker{font-size:23rpx;letter-spacing:6rpx;color:#9b6b46}.hero-title{margin-top:18rpx;font-family:serif;font-size:54rpx;line-height:1.25;font-weight:600}.hero-copy,.card-copy{margin-top:18rpx;color:#756a61;font-size:28rpx;line-height:1.75}.paper-card{margin-bottom:24rpx;padding:34rpx;border:1rpx solid rgba(90,65,45,.12);border-radius:24rpx;background:#fffdf8;box-shadow:0 10rpx 30rpx rgba(69,45,28,.05)}.card-title{margin-top:8rpx;font-family:serif;font-size:34rpx;font-weight:600}.error-card{border-color:#c78a75}.primary,.secondary,.voice-option{border-radius:999rpx}.primary{margin-top:34rpx;background:#6f3f2c;color:#fff}.primary[disabled]{background:#c9bfb4;color:#fff}.secondary{margin:24rpx 0 0;background:#eee3d4;color:#5e402f;font-size:27rpx}.official-voices{display:flex;gap:14rpx;flex-wrap:wrap;margin-top:24rpx}.voice-option{margin:0;background:#f2e6d7;color:#5e402f;font-size:25rpx}.selected-voice{margin-top:22rpx;color:#70442f;font-size:28rpx;font-family:serif}.gate{padding:24rpx 28rpx;border-radius:18rpx;background:#eadfd2;color:#684c3c;font-size:26rpx;line-height:1.6}
