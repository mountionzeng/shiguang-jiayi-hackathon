page{background:#241f1b;color:#f7efe5}.player-page{min-height:100vh;padding:76rpx 50rpx 290rpx;box-sizing:border-box}.book-title{font:600 48rpx/1.35 serif}.notice{margin-top:18rpx;color:#b9aaa0;font-size:25rpx;line-height:1.6}.story-scroll{height:calc(100vh - 460rpx);margin-top:58rpx}.story-lines{padding-bottom:72rpx}.story-line{display:block;padding:14rpx 10rpx;border-radius:12rpx;color:#cfc1b6;font:38rpx/1.9 serif;transition:color .18s ease,background .18s ease}.story-line.active{color:#fff8ee;background:#4b3b31}.static-lines .story-line{padding-left:0}.player-dock{position:fixed;left:30rpx;right:30rpx;bottom:36rpx;padding:30rpx;border-radius:28rpx;background:#342d28;box-shadow:0 14rpx 44rpx rgba(0,0,0,.24)}.progress{height:6rpx;overflow:hidden;border-radius:4rpx;background:#74675e}.progress-fill{height:100%;border-radius:4rpx;background:#e6b16d;transition:width .15s linear}.time-row{display:flex;justify-content:space-between;margin-top:18rpx;color:#cbbfb4;font-size:24rpx}.controls{display:flex;align-items:center;justify-content:center;gap:28rpx;margin-top:22rpx}.play-control,.text-control,.save-video{margin:0;border:0;border-radius:999rpx}.play-control{min-width:180rpx;background:#e6b16d;color:#3d2b20;font-size:28rpx}.play-control[disabled]{background:#75675c;color:#d7ccc2}.text-control{padding:0 22rpx;background:transparent;color:#e7dbd0;font-size:26rpx}.save-video{display:block;margin:20rpx auto 0;background:transparent;color:#e7dbd0;font-size:24rpx}
