page{background:#f4efe5;color:#342b25}.voice-page{padding:100rpx 52rpx}.voice-mark{width:120rpx;height:120rpx;border-radius:60rpx;background:#74442f;color:#fff;font:56rpx/120rpx serif;text-align:center}.title{margin-top:42rpx;font:600 52rpx/1.3 serif}.copy{margin-top:28rpx;color:#72675f;font-size:29rpx;line-height:1.8}.gender{display:flex;gap:36rpx;align-items:center;margin-top:32rpx;padding:24rpx;border-radius:18rpx;background:#fffaf2}.gender label{display:flex;gap:10rpx;align-items:center;font-size:27rpx}.reading{margin-top:34rpx;padding:30rpx;border-radius:22rpx;background:#fffdf8;border:1rpx solid #dfd0bf}.reading-label{color:#96694d;font-size:23rpx;letter-spacing:3rpx}.reading-text{margin-top:18rpx;font:34rpx/1.8 serif}.profile{display:flex;flex-direction:column;gap:10rpx;margin-top:32rpx;padding:24rpx;border-radius:18rpx;background:#e8ddcf;font-size:25rpx}.notice{margin-top:32rpx;padding:28rpx;border-radius:20rpx;background:#fffaf2;color:#684c3c;line-height:1.65}.primary,.secondary{margin-top:32rpx;border-radius:999rpx}.primary{background:#6f3f2c;color:#fff}.primary.recording{background:#a04f3d}.primary[disabled]{background:#c9bfb4}.secondary{background:transparent;border:1rpx solid #8b7668;color:#5e4a3e}.secondary.danger{color:#934a3b;border-color:#b98276}
