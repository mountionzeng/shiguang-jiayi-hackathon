<view class="voice-page"><view class="voice-mark">声</view><view class="title">我的声音</view><view class="copy">录音只用于创建你明确授权的朗读声音。停用后不再用于新作品，样本与腾讯云音色的删除状态会分别显示。</view><radio-group class="gender" bindchange="chooseGender"><view class="reading-label">声音类型（腾讯云创建音色必填）</view><label><radio value="1" checked="{{voiceGender === 1}}" disabled="{{profile}}"/>男声</label><label><radio value="2" checked="{{voiceGender === 2}}" disabled="{{profile}}"/>女声</label></radio-group><view class="reading" wx:if="{{profile && profile.readingText}}"><view class="reading-label">请朗读下面这段文字</view><view class="reading-text">{{profile.readingText}}</view></view><view class="profile" wx:if="{{profile}}"><text>当前状态：{{profile.status}}</text><text wx:if="{{profile.expiresAt}}">有效期至 {{profile.expiresAt}}</text><text>录音样本：{{profile.sampleDeletionStatus}}</text><text>腾讯云音色：{{profile.providerDeletionStatus}}</text></view><view class="notice">{{notice}}</view><button wx:if="{{selecting && profile && profile.status === 'ready'}}" class="primary" bindtap="useVoice">使用这个声音朗读</button><button wx:if="{{recording}}" class="primary recording" bindtap="stopRecording">结束录音</button><button wx:else class="primary" disabled="{{!available || busy}}" bindtap="beginRecording">{{uploading ? '正在上传…' : available ? '阅读授权文字并录音' : '暂未开放录音'}}</button><button wx:if="{{profile && profile.status !== 'disabled' && profile.status !== 'deleting' && profile.status !== 'deletion_pending_provider' && profile.status !== 'deletion_pending_sample' && profile.status !== 'deleted'}}" class="secondary" disabled="{{busy}}" bindtap="disableVoice">停用这个声音</button><button wx:if="{{profile && profile.status !== 'deleted'}}" class="secondary danger" disabled="{{busy}}" bindtap="deleteVoice">删除声音与样本</button></view>
