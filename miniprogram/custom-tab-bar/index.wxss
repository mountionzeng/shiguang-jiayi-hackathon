/* 两个内容视图；记录入口只留在首页，避免同一动作出现三个红色入口。 */

.bar {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 100;
  display: flex;
  align-items: center;
  height: 116rpx;
  padding: 0 16rpx;
  border-radius: 58rpx;
  background: #ffffff;
  border: 2rpx solid #e5dfd2;
  box-shadow: 0 8rpx 40rpx rgba(31, 58, 52, 0.16);
}

.item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  border-radius: 46rpx;
  color: #4c6159;
  font-family: "PingFang SC", "Heiti SC", sans-serif;
  font-size: 28rpx;
}

.item-on {
  background: #e3f0ea;
  color: #176b54;
  font-weight: 600;
}
