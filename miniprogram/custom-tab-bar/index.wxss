/* 三段式底部导航：人生之书 · 回忆采访 · 记忆之家 */

.bar {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 100;
  display: flex;
  align-items: center;
  height: 116rpx;
  padding: 0 16rpx;
  border-radius: 58rpx;
  background: #ffffff;
  border: 2rpx solid #e5dfd2;
  box-shadow: 0 8rpx 40rpx rgba(31, 58, 52, 0.16);
}

.item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  border-radius: 46rpx;
  color: #4c6159;
  font-family: "PingFang SC", "Heiti SC", sans-serif;
  font-size: 28rpx;
}

.item-on {
  background: #e3f0ea;
  color: #176b54;
  font-weight: 600;
}

.plus {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  min-height: 96rpx;
  margin: 0 8rpx;
  border-radius: 40rpx;
  background: #c7452e;
  color: #fffdfb;
}

.plus:active {
  opacity: 0.86;
}

.plus-sign {
  font-size: 40rpx;
  line-height: 1;
  font-weight: 600;
}

.plus-text {
  margin-top: 4rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}
