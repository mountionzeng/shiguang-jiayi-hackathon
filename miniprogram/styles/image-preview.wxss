.image-preview-mask { position: fixed; inset: 0; z-index: 100; display: flex; align-items: flex-end; background: rgba(32,38,33,.5); }
.image-preview-sheet { box-sizing: border-box; width: 100%; max-height: 92vh; display: flex; flex-direction: column; padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom)); background: var(--paper); border-radius: 28rpx 28rpx 0 0; }
.image-preview-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; font-size: 32rpx; color: var(--ink); }
.image-preview-head button, .image-preview-actions button { width: auto; min-height: 72rpx; margin: 0; padding: 0 16rpx; background: transparent; color: var(--ink-soft); font-size: 26rpx; line-height: 72rpx; }
.image-preview-art { display: block; width: 100%; height: 40vh; flex-shrink: 0; background: var(--paper-sunk); border-radius: 8rpx; }
.image-preview-controls { box-sizing: border-box; height: 30vh; min-height: 0; flex-shrink: 1; margin-top: 20rpx; }
.image-preview-position { display: flex; justify-content: space-between; padding: 22rpx 18rpx; border-bottom: 1rpx solid var(--line); color: var(--ink); font-size: 28rpx; }
.image-preview-primary, .image-preview-secondary { box-sizing: border-box; width: 100%; min-height: 84rpx; margin: 16rpx 0 0; border-radius: 12rpx; font-size: 30rpx; line-height: 84rpx; }
.image-preview-primary { color: var(--paper); background: var(--jade); }
.image-preview-secondary { color: var(--ink-soft); background: transparent; }
.image-preview-note { display: block; margin: 12rpx 0; color: var(--ink-soft); font-size: 25rpx; line-height: 1.6; }
.image-preview-actions { display: flex; justify-content: space-between; margin-top: 10rpx; }
.image-preview-sheet button::after { border: 0; }
.image-preview-sheet button[disabled] { opacity: .5; }
