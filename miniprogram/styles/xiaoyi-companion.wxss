/* 就地小忆共享样式：book/interview/archive 三处的悬浮头像入口与对话面板，
 * 保持同一个视觉形象、同一个位置逻辑（需求 R1）。宿主页面的容器需要
 * `position: relative`，入口按钮才能悬浮在其右下角。 */
/* Match the specificity of WeChat v2's button defaults so the avatar stays square. */
.xiaoyi-entry.xiaoyi-entry {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  z-index: 3;
  width: 96rpx;
  height: 96rpx;
  min-height: 0;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  overflow: hidden;
  background: var(--paper-card);
  box-shadow: 0 8rpx 24rpx rgba(39, 79, 63, .28);
}
.xiaoyi-entry-avatar { display: block; width: 100%; height: 100%; }
.xiaoyi-entry::after, .xiaoyi-close::after, .xiaoyi-option::after, .xiaoyi-action::after, .pending-btn::after, .pending-finish::after { border: 0; }
.xiaoyi-panel { flex: none; max-height: 46%; min-height: 260rpx; overflow-y: auto; padding: 18rpx; border: 1rpx solid rgba(79, 127, 107, .28); border-radius: 20rpx; background: #fffdf8; box-shadow: 0 -8rpx 26rpx rgba(42, 46, 43, .08); }
.keyboard-open .xiaoyi-panel { max-height: 54%; }
.xiaoyi-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.xiaoyi-title { font-size: 30rpx; font-weight: 700; color: var(--jade); }
.xiaoyi-context { margin-top: 4rpx; font-size: 23rpx; line-height: 1.5; color: var(--ink-soft); }
.xiaoyi-close.xiaoyi-close { flex: none; width: auto; min-height: 58rpx; margin: 0; padding: 0 18rpx; border-radius: 999rpx; background: var(--paper-sunk); color: var(--ink-soft); font-size: 25rpx; }
.xiaoyi-options, .xiaoyi-actions, .pending-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.xiaoyi-option.xiaoyi-option, .xiaoyi-action.xiaoyi-action, .pending-btn.pending-btn, .pending-finish.pending-finish { width: auto; min-height: 64rpx; margin: 0; padding: 0 20rpx; border-radius: 999rpx; background: var(--jade-soft); color: var(--jade); font-size: 26rpx; }
.xiaoyi-action-primary.xiaoyi-action-primary, .pending-accept.pending-accept, .pending-finish.pending-finish { background: var(--jade); color: var(--paper-card); }
.xiaoyi-status { margin-top: 12rpx; font-size: 25rpx; line-height: 1.55; color: #805326; }
.xiaoyi-thread { max-height: 210rpx; margin-top: 12rpx; }
.xiaoyi-message { margin-top: 10rpx; padding: 14rpx 16rpx; border-radius: 16rpx; font-size: 27rpx; line-height: 1.65; white-space: pre-wrap; user-select: text; }
.xiaoyi-message-question { background: var(--jade-soft); color: var(--ink); }
.xiaoyi-message-answer { background: var(--paper-sunk); color: var(--ink); }
.xiaoyi-message-draft { background: #f7eedf; color: var(--ink); }
.xiaoyi-message-label { margin-bottom: 4rpx; font-size: 22rpx; color: var(--ink-soft); }
.xiaoyi-answer, .xiaoyi-draft { box-sizing: border-box; width: 100%; min-height: 88rpx; margin-top: 14rpx; padding: 16rpx; border: 1rpx solid var(--line); border-radius: 14rpx; background: var(--paper-card); font-size: 28rpx; line-height: 1.65; }
.xiaoyi-draft-box { margin-top: 14rpx; padding-top: 10rpx; border-top: 1rpx solid var(--line); }
